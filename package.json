{
  "name": "ecorouter-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "pnpm --filter ecorouter build && pnpm --filter @ecorouter/site build",
    "build:site": "pnpm --filter @ecorouter/site build",
    "dev:site": "pnpm --filter @ecorouter/site dev",
    "test": "pnpm --filter ecorouter test",
    "typecheck": "pnpm --filter ecorouter typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
