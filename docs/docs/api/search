e_id":"/api/errors","tags":[],"type":"text","url":"/api/errors","content":"| Code              | Class                 | Thrown when                              |\n| ----------------- | --------------------- | ---------------------------------------- |\n| `MANDATE_EXPIRED` | `MandateExpiredError` | `mandate.expiresAt` is at or before now. |","table":"table-0"},"28":{"id":"/api/errors-8","page_id":"/api/errors","tags":[],"type":"text","url":"/api/errors","content":"| Code              | Class                 | Thrown when             |\n| ----------------- | --------------------- | ----------------------- |\n| `MANDATE_REVOKED` | `MandateRevokedError` | The mandate is revoked. |","table":"table-0"},"29":{"id":"/api/errors-9","page_id":"/api/errors","tags":[],"type":"text","url":"/api/errors","content":"| Code                          | Class                       | Thrown when                                                                  |\n| ----------------------------- | --------------------------- | ---------------------------------------------------------------------------- |\n| `PAYMENT_AUTHORIZATION_ERROR` | `PaymentAuthorizationError` | Your `PaymentClient` threw it; signing or authorization definitively failed. |","table":"table-0"},"30":{"id":"/api/errors-10","page_id":"/api/errors","tags":[],"type":"text","url":"/api/errors","content":"| Code                       | Class                    | Thrown when                                                      |\n| -------------------------- | ------------------------ | ---------------------------------------------------------------- |\n| `PAYMENT_SETTLEMENT_ERROR` | `PaymentSettlementError` | Your `PaymentClient` threw it; the transfer definitively failed. |","table":"table-0"},"31":{"id":"/api/errors-11","page_id":"/api/errors","tags":[],"type":"text","url":"/api/errors","content":"| Code                         | Class                           | Thrown when                                                              |\n| ---------------------------- | ------------------------------- | ------------------------------------------------------------------------ |\n| `PAYMENT_SETTLEMENT_UNKNOWN` | `PaymentSettlementUnknownError` | `authorizeAndSettle` threw anything else; settlement may have succeeded. |","table":"table-0"},"32":{"id":"/api/errors-12","page_id":"/api/errors","tags":[],"type":"text","url":"/api/errors","content":"| Code                       | Class                    | Thrown when                                                    |\n| -------------------------- | ------------------------ | -------------------------------------------------------------- |\n| `PROVIDER_EXECUTION_ERROR` | `ProviderExecutionError` | The paid provider request failed (non-2xx or transport error). |","table":"table-0"},"33":{"id":"/api/errors-13","page_id":"/api/errors","tags":[],"type":"text","url":"/api/errors","content":"| Code                      | Class                   | Thrown when                                                               |\n| ------------------------- | ----------------------- | ------------------------------------------------------------------------- |\n| `PROVIDER_RESPONSE_ERROR` | `ProviderResponseError` | The paid response did not match `{ results: [{ title, url, snippet }] }`. |","table":"table-0"},"34":{"id":"/api/errors-14","page_id":"/api/errors","tags":[],"type":"text","url":"/api/errors#paymentsettlementunknownerror","content":"Beyond `code` and `executionId`, it carries:"},"35":{"id":"/api/errors-15","page_id":"/api/errors","tags":[],"type":"text","url":"/api/errors#paymentsettlementunknownerror","content":"<TypeTable type=\"{ providerId: { description: 'The winning provider the settlement targeted.', type: 'string' }, tran…\" />"},"36":{"id":"/api/errors-16","page_id":"/api/errors","tags":[],"type":"text","url":"/api/errors#paymentsettlementunknownerror","content":"Executions that end `settlement_unknown` cannot be retried under the same `executionId`; the router throws instead of risking a double payment."},"37":{"id":"/api/payment-client","page_id":"/api/payment-client","type":"page","content":"Payment Client","breadcrumbs":["EcoRouter Docs","API Reference"],"tags":[],"url":"/api/payment-client"},"38":{"id":"/api/payment-client-0","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client","content":"The PaymentClient interface you implement, its types, and its error contract."},"39":{"id":"/api/payment-client-1","page_id":"/api/payment-client","type":"heading","tags":[],"url":"/api/payment-client#paymentclient","content":"PaymentClient"},"40":{"id":"/api/payment-client-2","page_id":"/api/payment-client","type":"heading","tags":[],"url":"/api/payment-client#mandatestate","content":"MandateState"},"41":{"id":"/api/payment-client-3","page_id":"/api/payment-client","type":"heading","tags":[],"url":"/api/payment-client#signedpayment-and-settlementreceipt","content":"SignedPayment and SettlementReceipt"},"42":{"id":"/api/payment-client-4","page_id":"/api/payment-client","type":"heading","tags":[],"url":"/api/payment-client#error-contract","content":"Error contract"},"43":{"id":"/api/payment-client-5","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client","content":"The SDK does not ship a Stellar transport implementation. You provide a `PaymentClient` that reads mandate state and submits the authorized transfer. The router treats its return value and its errors precisely."},"44":{"id":"/api/payment-client-6","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client#paymentclient","content":"<TypeTable type=\"{ 'loadMandate(account)': { description: 'Read the current on-chain mandate for the account contract…\" />"},"45":{"id":"/api/payment-client-7","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client#paymentclient","content":"`authorizeAndSettle` receives `{ account, sessionSecret, executionId, providerId, challenge }`."},"46":{"id":"/api/payment-client-8","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client#mandatestate","content":"<TypeTable type=\"{ asset: { description: 'Asset identifier the mandate allows (USDC).', type: 'string', required: tru…\" />"},"47":{"id":"/api/payment-client-9","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client#signedpayment-and-settlementreceipt","content":"`SignedPayment` is `{ payload: string; transactionHash?: string }`. The payload is sent back to the provider in the `payment-signature` header."},"48":{"id":"/api/payment-client-10","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client#signedpayment-and-settlementreceipt","content":"`SettlementReceipt` is `{ transactionHash: string }`. The hash is returned in `result.payment.transactionHash`."},"49":{"id":"/api/payment-client-11","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client#error-contract","content":"Throw the typed errors for definite failures:"},"50":{"id":"/api/payment-client-12","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client#error-contract","content":"`PaymentAuthorizationError` when signing or authorization definitively failed."},"51":{"id":"/api/payment-client-13","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client#error-contract","content":"`PaymentSettlementError` when the transfer definitively failed on-chain."},"52":{"id":"/api/payment-client-14","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client#error-contract","content":"Both propagate unchanged and mark the execution `failed`, so the same `executionId` can be retried."},"53":{"id":"/api/payment-client-15","page_id":"/api/payment-client","tags":[],"type":"text","url":"/api/payment-client#error-contract","content":"**Any other thrown value marks the execution `settlement_unknown`** and the router throws `PaymentSettlementUnknownError`, because the payment may have succeeded. A `settlement_unknown` execution id cannot be retried; retrying throws. Only throw a generic error when settlement truly is ambiguous."},"54":{"id":"/api/providers","page_id":"/api/providers","type":"page","content":"Providers","breadcrumbs":["EcoRouter Docs","API Reference"],"tags":[],"url":"/api/providers"},"55":{"id":"/api/providers-0","page_id":"/api/providers","tags":[],"type":"text","url":"/api/providers","content":"The HTTP contract a web.search provider must implement."},"56":{"id":"/api/providers-1","page_id":"/api/providers","type":"heading","tags":[],"url":"/api/providers#challenge-request","content":"Challenge request"},"57":{"id":"/api/providers-2","page_id":"/api/providers","type":"heading","tags":[],"url":"/api/providers#challenge-response","content":"Challenge response"},"58":{"id":"/api/providers-3","page_id":"/api/providers","type":"heading","tags":[],"url":"/api/providers#paid-request","content":"Paid request"},"59":{"id":"/api/providers-4","page_id":"/api/providers","type":"heading","tags":[],"url":"/api/providers#success-response","content":"Success response"},"60":{"id":"/api/providers-5","page_id":"/api/providers","type":"heading","tags":[],"url":"/api/providers#capability","content":"Capability"},"61":{"id":"/api/providers-6","page_id":"/api/providers","tags":[],"type":"text","url":"/api/providers","content":"`HttpWebSearchProvider` (in `providers/web-search.ts`) talks to providers over plain HTTP. Any endpoint that implements this contract works with the router."},"62":{"id":"/api/providers-7","page_id":"/api/providers","tags":[],"type":"text","url":"/api/providers#challenge-request","content":"The SDK sends the input as a JSON POST body:"},"63":{"id":"/api/providers-8","page_id":"/api/providers","tags":[],"type":"text","url":"/api/providers#challenge-response","content":"A compliant provider replies HTTP 402 with a `payment-required` header containing a base64 (or base64url) encoded JSON `PaymentChallenge`:"},"64":{"id":"/api/providers-9","page_id":"/api/providers","tags":[],"type":"text","url":"/api/providers#challenge-response","content":"A non-402 status, a missing header, or malformed base64 JSON raises `InvalidPaymentChallengeError` for that provider."},"65":{"id":"/api/providers-10","page_id":"/api/providers","tags":[],"type":"text","url":"/api/providers#paid-request","content":"After settlement the SDK retries the same POST with the signed payload:"},"66":{"id":"/api/providers-11","page_id":"/api/providers","tags":[],"type":"text","url":"/api/providers#success-response","content":"HTTP 200 with a JSON body of normalized shape:"},"67":{"id":"/api/providers-12","page_id":"/api/providers","tags":[],"type":"text","url":"/api/providers#success-response","content":"`normalize` requires `results` to be an array whose items each have string `title`, `url`, and `snippet`. Anything else raises `ProviderResponseError`. A non-2xx response raises `ProviderExecutionError`."},"68":{"id":"/api/providers-13","page_id":"/api/providers","tags":[],"type":"text","url":"/api/providers#capability","content":"The `Capability` type is `\"web.search\"`. Providers are matched to requests by exact capability string before being probed."},"69":{"id":"/api/utilities","page_id":"/api/utilities","type":"page","content":"Utilities","breadcrumbs":["EcoRouter Docs","API Reference"],"tags":[],"url":"/api/utilities"},"70":{"id":"/api/utilities-0","page_id":"/api/utilities","tags":[],"type":"text","url":"/api/utilities","content":"Money parsing and provider selection helpers exported by the SDK."},"71":{"id":"/api/utilities-1","page_id":"/api/utilities","type":"heading","tags":[],"url":"/api/utilities#parseusdc","content":"parseUsdc"},"72":{"id":"/api/utilities-2","page_id":"/api/utilities","type":"heading","tags":[],"url":"/api/utilities#formatusdc","content":"formatUsdc"},"73":{"id":"/api/utilities-3","page_id":"/api/utilities","type":"heading","tags":[],"url":"/api/utilities#selectprovider","content":"selectProvider"},"74":{"id":"/api/utilities-4","page_id":"/api/utilities","tags":[],"type":"text","url":"/api/utilities#parseusdc","content":"Parses a non-negative decimal string with at most 7 places into atomic units (USDC has 7 decimals, so `1` equals `10_000_000` atomic). Throws `TypeError` on any other input format."},"75":{"id":"/api/utilities-5","page_id":"/api/utilities","tags":[],"type":"text","url":"/api/utilities#formatusdc","content":"Formats atomic units back to a decimal string, trimming trailing zeros. Throws `RangeError` for negative values."},"76":{"id":"/api/utilities-6","page_id":"/api/utilities","tags":[],"type":"text","url":"/api/utilities#selectprovider","content":"Scores each candidate as `economicCost = priceAtomic / (qualityScore * successRate)` and returns the lowest. Ties break on lower `priceAtomic`, then lexically smaller `providerId`. Throws `RangeError` on an empty list. The result adds `economicCost` to the input fields."},"77":{"id":"/api/utilities-7","page_id":"/api/utilities","tags":[],"type":"text","url":"/api/utilities#selectprovider","content":"All three are exported from the package root, so `import { selectProvider } from \"ecorouter\"` works."},"78":{"id":"/api/x402","page_id":"/api/x402","type":"page","content":"x402 Validation","breadcrumbs":["EcoRouter Docs","API Reference"],"tags":[],"url":"/api/x402"},"79":{"id":"/api/x402-0","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402","content":"What validateChallenge checks, in order."},"80":{"id":"/api/x402-1","page_id":"/api/x402","type":"heading","tags":[],"url":"/api/x402#paymentchallenge","content":"PaymentChallenge"},"81":{"id":"/api/x402-2","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402","content":"`validateChallenge(challenge, mandate, maxSpend, executionId?)` returns the accepted amount in atomic units, or throws. It runs these checks in exact order, from `x402/validate.ts`:"},"82":{"id":"/api/x402-3","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402","content":"**Supported requirements.** `x402Version === 2`, `scheme === \"exact\"`, `network === \"stellar:testnet\"`, `asset === mandate.asset`, and a non-empty `payTo` string. Failure: `InvalidPaymentChallengeError`."},"83":{"id":"/api/x402-4","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402","content":"**Amount format.** `amount` is a string matching `^\\d+$`. Failure: `InvalidPaymentChallengeError`."},"84":{"id":"/api/x402-5","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402","content":"**Positive amount.** `BigInt(amount) > 0`. Failure: `InvalidPaymentChallengeError`."},"85":{"id":"/api/x402-6","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402","content":"**Mandate not revoked.** `mandate.revoked` is false. Failure: `MandateRevokedError`."},"86":{"id":"/api/x402-7","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402","content":"**Mandate not expired.** `mandate.expiresAt` is greater than the current Unix time in seconds. Failure: `MandateExpiredError`."},"87":{"id":"/api/x402-8","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402","content":"**Local policy.** `amount <= parseUsdc(maxSpend)`. Failure: `PolicyExceededError`."},"88":{"id":"/api/x402-9","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402","content":"**Mandate limits.** `amount <= mandate.maxPaymentAtomic` and `amount <= mandate.remainingAtomic`. Failure: `MandateExceededError`."},"89":{"id":"/api/x402-10","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402","content":"Note the ordering consequences: a revoked or expired mandate throws before any policy check, and the local `maxSpend` cap is evaluated before the on-chain mandate caps."},"90":{"id":"/api/x402-11","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402","content":"Inside `router.execute`, validation failures do not throw. They silently disqualify that provider; a provider is only removed from the eligible set."},"91":{"id":"/api/x402-12","page_id":"/api/x402","tags":[],"type":"text","url":"/api/x402#paymentchallenge","content":"<TypeTable type=\"{ x402Version: { description: 'Must be 2.', type: 'number', required: true }, scheme: { description:…\" />"},"92":{"id":"/contract","page_id":"/contract","type":"page","content":"Smart Account Contract","breadcrumbs":["EcoRouter Docs"],"tags":[],"url":"/contract"},"93":{"id":"/contract-0","page_id":"/contract","tags":[],"type":"text","url":"/contract","content":"The ecorouter-account Soroban contract and its mandate enforcement."},"94":{"id":"/contract-1","page_id":"/contract","type":"heading","tags":[],"url":"/contract#the-mandate","content":"The Mandate"},"95":{"id":"/contract-2","page_id":"/contract","type":"heading","tags":[],"url":"/contract#public-functions","content":"Public functions"},"96":{"id":"/contract-3","page_id":"/contract","type":"heading","tags":[],"url":"/contract#what-__check_auth-enforces","content":"What `__check_auth` enforces"},"97":{"id":"/contract-4","page_id":"/contract","type":"heading","tags":[],"url":"/contract#errors","content":"Errors"},"98":{"id":"/contract-5","page_id":"/contract","type":"heading","tags":[],"url":"/contract#building-and-deploying","content":"Building and deploying"},"99":{"id":"/contract-6","page_id":"/contract","tags":[],"type":"text","url":"/contract","content":"`contracts/ecorouter-account` is a `no_std` Soroban smart account (crate type `cdylib`). It holds funds, stores a spending mandate, and authorizes outbound transfers through the `__check_auth` custom account interface. All types and behaviors below come from `contracts/ecorouter-account/src/lib.rs`."},"100":{"id":"/contract-7","page_id":"/contract","tags":[],"type":"text","url":"/contract#the-mandate","content":"A single mandate is stored in instance storage under `DataKey::Mandate`; the owner address is stored under `DataKey::Owner`."},"101":{"id":"/contract-8","page_id":"/contract","tags":[],"type":"text","url":"/contract#public-functions","content":"| Function            | Auth                   | Effect                                                             |\n| ------------------- | ---------------------- | ------------------------------------------------------------------ |\n| `initialize(owner)` | `owner.require_auth()` | Stores the owner. Fails with `AlreadyInitialized` if called twice. |","table":"table-0"},"102":{"id":"/contract-9","page_id":"/contract","tags":[],"type":"text","url":"/contract#public-functions","content":"| Function                                                                          | Auth  | Effect                                                                                                                                                                                                                    |\n| --------------------------------------------------------------------------------- | ----- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `create_mandate(session_public_key, asset, total_limit, max_payment, expires_at)` | owner | Creates the mandate with `spent = 0`, `revoked = false`. Rejects non-positive limits, `max_payment > total_limit` (`InvalidAmount`), and `expires_at` in the past (`InvalidExpiration`). Emits a `mandate created` event. |","table":"table-0"},"103":{"id":"/contract-10","page_id":"/contract","tags":[],"type":"text","url":"/contract#public-functions","content":"| Function           | Auth  | Effect                                                  |\n| ------------------ | ----- | ------------------------------------------------------- |\n| `revoke_mandate()` | owner | Sets `revoked = true`. Emits a `mandate revoked` event. |","table":"table-0"},"104":{"id":"/contract-11","page_id":"/contract","tags":[],"type":"text","url":"/contract#public-functions","content":"| Function                      | Auth  | Effect                                                                                                                                                        |\n| ----------------------------- | ----- | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `withdraw(asset, to, amount)` | owner | Transfers any token out of the contract via the token client. `amount` must be positive. This is the owner escape hatch; the session key can never invoke it. |","table":"table-0"},"105":{"id":"/contract-12","page_id":"/contract","tags":[],"type":"text","url":"/contract#public-functions","content":"| Function        | Auth | Effect                                             |\n| --------------- | ---- | -------------------------------------------------- |\n| `get_mandate()` | none | Returns the current mandate, or `MandateNotFound`. |","table":"table-0"},"106":{"id":"/contract-13","page_id":"/contract","tags":[],"type":"text","url":"/contract#public-functions","content":"| Function                                                    | Auth        | Effect                                                                                         |\n| ----------------------------------------------------------- | ----------- | ---------------------------------------------------------------------------------------------- |\n| `__check_auth(signature_payload, signature, auth_contexts)` | session key | The authorization hook invoked by the Soroban host when the account is required as an invoker. |","table":"table-0"},"107":{"id":"/contract-14","page_id":"/contract","tags":[],"type":"text","url":"/contract#what-__check_auth-enforces","content":"When a session key signs an invocation that requires this account's auth, the contract checks, in order:"},"108":{"id":"/contract-15","page_id":"/contract","tags":[],"type":"text","url":"/contract#what-__check_auth-enforces","content":"A mandate exists (`MandateNotFound`), is not revoked (`MandateRevoked`), and has not expired (`MandateExpired`)."},"109":{"id":"/contract-16","page_id":"/contract","tags":[],"type":"text","url":"/contract#what-__check_auth-enforces","content":"The signer public key equals `mandate.session_public_key` (`WrongSigner`), and the Ed25519 signature verifies over the payload."},"110":{"id":"/contract-17","page_id":"/contract","tags":[],"type":"text","url":"/contract#what-__check_auth-enforces","content":"Exactly one authorization context, and it must be a `Context::Contract` call (`UnsupportedInvocation`). Administrative functions are structurally impossible for the session key."},"111":{"id":"/contract-18","page_id":"/contract","tags":[],"type":"text","url":"/contract#what-__check_auth-enforces","content":"The called contract equals `mandate.asset` (`WrongAsset`), the function is `transfer` with exactly 3 arguments (`UnsupportedInvocation`)."},"112":{"id":"/contract-19","page_id":"/contract","tags":[],"type":"text","url":"/contract#what-__check_auth-enforces","content":"The transfer source is the account contract itself (`WrongSource`) and `amount > 0` (`InvalidAmount`)."},"113":{"id":"/contract-20","page_id":"/contract","tags":[],"type":"text","url":"/contract#what-__check_auth-enforces","content":"`amount <= mandate.max_payment` (`PaymentAboveMaximum`)."},"114":{"id":"/contract-21","page_id":"/contract","tags":[],"type":"text","url":"/contract#what-__check_auth-enforces","content":"`spent + amount <= mandate.total_limit` (`AllowanceExceeded`), using checked arithmetic."},"115":{"id":"/contract-22","page_id":"/contract","tags":[],"type":"text","url":"/contract#what-__check_auth-enforces","content":"On success the contract increments `spent` and emits a `payment authorized` event carrying asset, recipient, amount, new spent, and remaining allowance."},"116":{"id":"/contract-23","page_id":"/contract","tags":[],"type":"text","url":"/contract#errors","content":"`AccountError`: `AlreadyInitialized` (1), `NotInitialized` (2), `InvalidAmount` (3), `InvalidExpiration` (4), `MandateNotFound` (5), `MandateRevoked` (6), `MandateExpired` (7), `WrongSigner` (8), `UnsupportedInvocation` (9), `WrongAsset` (10), `WrongSource` (11), `PaymentAboveMaximum` (12), `AllowanceExceeded` (13)."},"117":{"id":"/contract-24","page_id":"/contract","tags":[],"type":"text","url":"/contract#building-and-deploying","content":"The contract is a standard Soroban `cdylib` crate. Build and deploy with the Stellar CLI (`stellar contract build`, `stellar contract deploy`), then call `initialize` with the owner address and `create_mandate` to bind a session key, asset, and limits. The repository does not ship deploy scripts; see the Soroban docs for network-specific commands."},"118":{"id":"/how-it-works","page_id":"/how-it-works","type":"page","content":"How It Works","breadcrumbs":["EcoRouter Docs"],"tags":[],"url":"/how-it-works"},"119":{"id":"/how-it-works-0","page_id":"/how-it-works","tags":[],"type":"text","url":"/how-it-works","content":"The exact execution pipeline inside router.execute."},"120":{"id":"/how-it-works-1","page_id":"/how-it-works","type":"heading","tags":[],"url":"/how-it-works#idempotency-check","content":"Idempotency check"},"121":{"id":"/how-it-works-2","page_id":"/how-it-works","type":"heading","tags":[],"url":"/how-it-works#load-the-mandate","content":"Load the mandate"},"122":{"id":"/how-it-works-3","page_id":"/how-it-works","type":"heading","tags":[],"url":"/how-it-works#filter-and-challenge-providers","content":"Filter and challenge providers"},"123":{"id":"/how-it-works-4","page_id":"/how-it-works","type":"heading","tags":[],"url":"/how-it-works#quality-filter-and-challenge-validation","content":"Quality filter and challenge validation"},"124":{"id":"/how-it-works-5","page_id":"/how-it-works","type":"heading","tags":[],"url":"/how-it-works#score-and-select","content":"Score and select"},"125":{"id":"/how-it-works-6","page_id":"/how-it-works","type":"heading","tags":[],"url":"/how-it-works#authorize-and-settle","content":"Authorize and settle"},"126":{"id":"/how-it-works-7","page_id":"/how-it-works","type":"heading","tags":[],"url":"/how-it-works#paid-execute-and-normalize","content":"Paid execute and normalize"},"127":{"id":"/how-it-works-8","page_id":"/how-it-works","type":"heading","tags":[],"url":"/how-it-works#return","content":"Return"},"128":{"id":"/how-it-works-9","page_id":"/how-it-works","tags":[],"type":"text","url":"/how-it-works","content":"Every call to `router.execute` runs the same deterministic pipeline, implemented in `packages/sdk/src/ecorouter.ts`."},"129":{"id":"/how-it-works-10","page_id":"/how-it-works","tags":[],"type":"text","url":"/how-it-works#idempotency-check","content":"The router resolves `executionId` (or generates a random UUID), then checks its in-memory execution map. A `complete` entry returns the cached result immediately. A `running`, `failed`, or `settlement_unknown` entry throws. Otherwise the id is marked `running`."},"130":{"id":"/how-it-works-11","page_id":"/how-it-works","tags":[],"type":"text","url":"/how-it-works#load-the-mandate","content":"`paymentClient.loadMandate(account)` fetches the current on-chain `MandateState`: asset, `maxPaymentAtomic`, `remainingAtomic`, `expiresAt`, `revoked`."},"131":{"id":"/how-it-works-12","page_id":"/how-it-works","tags":[],"type":"text","url":"/how-it-works#filter-and-challenge-providers","content":"Providers whose `capability` does not match the request are dropped. Every remaining provider gets a concurrent probe: `POST` the JSON input, expect HTTP 402 plus a `payment-required` header. Each challenge is raced against a 5000 ms timeout via `Promise.allSettled`, so one slow or broken provider cannot stall the rest."},"132":{"id":"/how-it-works-13","page_id":"/how-it-works","tags":[],"type":"text","url":"/how-it-works#quality-filter-and-challenge-validation","content":"Providers below `policy.minimumQuality` are discarded. Each surviving challenge is checked by `validateChallenge` against the mandate and `policy.maxSpendUsdc`. Failures are discarded, not thrown. See x402 validation for the exact check order."},"133":{"id":"/how-it-works-14","page_id":"/how-it-works","tags":[],"type":"text","url":"/how-it-works#score-and-select","content":"For each eligible offer the router reads the in-memory success metrics for that provider id. `successRate` is `successCount / total`, or `1` when there is no history. `selectProvider` computes `economicCost = priceAtomic / (qualityScore * successRate)` and picks the lowest, breaking ties on lower `priceAtomic`, then lexically smaller `providerId`. No eligible provider means `NoEligibleProviderError`."},"134":{"id":"/how-it-works-15","page_id":"/how-it-works","tags":[],"type":"text","url":"/how-it-works#authorize-and-settle","content":"`paymentClient.authorizeAndSettle` signs the winning challenge with the session secret against the Soroban account. `PaymentAuthorizationError` and `PaymentSettlementError` propagate unchanged (the execution is marked `failed`). Any other exception marks the execution `settlement_unknown` and throws `PaymentSettlementUnknownError`, because the transfer may have gone through."},"135":{"id":"/how-it-works-16","page_id":"/how-it-works","tags":[],"type":"text","url":"/how-it-works#paid-execute-and-normalize","content":"The provider is retried with the `payment-signature` header. The response must be `{ results: [{ title, url, snippet }] }`; anything else raises `ProviderResponseError`. Other failures raise `ProviderExecutionError` and count against the provider's metrics."},"136":{"id":"/how-it-works-17","page_id":"/how-it-works","tags":[],"type":"text","url":"/how-it-works#return","content":"On success the provider's `successCount` increments and the router returns `EcoRouterExecutionResult`: the execution id, normalized output, the decision record (provider, price in USDC, quality, success rate, economic cost), the payment receipt, and the remaining mandate balance."},"137":{"id":"/how-it-works-18","page_id":"/how-it-works","tags":[],"type":"text","url":"/how-it-works#return","content":"All token amounts are atomic integers (USDC has 7 decimals), never floating point. `maxSpendUsdc` strings are parsed by `parseUsdc`."},"138":{"id":"/","page_id":"/","type":"page","content":"Introduction","breadcrumbs":["EcoRouter Docs"],"tags":[],"url":"/"},"139":{"id":"/-0","page_id":"/","tags":[],"type":"text","url":"/","content":"What EcoRouter is and how the pieces fit together."},"140":{"id":"/-1","page_id":"/","tags":[],"type":"text","url":"/","content":"EcoRouter is a local TypeScript SDK for capability-based purchasing by autonomous agents. Instead of hardcoding an API vendor, your agent asks for a capability such as `web.search`. The SDK probes configured providers over HTTP 402 (x402 V2 `exact`), validates each offer against your local spend policy and the on-chain Soroban mandate, picks the best value deterministically, settles the payment in USDC on `stellar:testnet`, and normalizes the response into one predictable shape."},"141":{"id":"/-2","page_id":"/","tags":[],"type":"text","url":"/","content":"Everything runs on your machine. There are no hosted services, no registries, and no custodial wallets. Payment authorization is enforced on Stellar by the `ecorouter-account` Soroban smart account, which gates every transfer through `__check_auth` against a mandate you control."},"142":{"id":"/-3","page_id":"/","tags":[],"type":"text","url":"/","content":"<Card title=\"Quickstart\" href=\"/quickstart\" description=\"Install the SDK and run your first paid execution.\" />"},"143":{"id":"/-4","page_id":"/","tags":[],"type":"text","url":"/","content":"<Card title=\"How It Works\" href=\"/how-it-works\" description=\"The exact pipeline from probe to normalized result.\" />"},"144":{"id":"/-5","page_id":"/","tags":[],"type":"text","url":"/","content":"<Card title=\"Smart Account Contract\" href=\"/contract\" description=\"The Soroban mandate and what __check_auth enforces.\" />"},"145":{"id":"/-6","page_id":"/","tags":[],"type":"text","url":"/","content":"<Card title=\"API Reference\" href=\"/api/ecorouter\" description=\"Every interface, function, and error in the SDK.\" />"},"146":{"id":"/-7","page_id":"/","tags":[],"type":"text","url":"/","content":"<Card title=\"Playground\" href=\"/playground\" description=\"Run the real validation and selection functions in your browser.\" />"},"147":{"id":"/playground","page_id":"/playground","type":"page","content":"Playground","breadcrumbs":["EcoRouter Docs"],"tags":[],"url":"/playground"},"148":{"id":"/playground-0","page_id":"/playground","tags":[],"type":"text","url":"/playground","content":"Run the real SDK validation and selection functions in your browser."},"149":{"id":"/playground-1","page_id":"/playground","tags":[],"type":"text","url":"/playground","content":"These panels import the actual functions from `packages/sdk/src` (`validateChallenge`, `selectProvider`, `parseUsdc`, `formatUsdc`) and run them locally in your browser on every change. No network calls and no payments happen; nothing is signed or sent anywhere."},"150":{"id":"/quickstart","page_id":"/quickstart","type":"page","content":"Quickstart","breadcrumbs":["EcoRouter Docs"],"tags":[],"url":"/quickstart"},"151":{"id":"/quickstart-0","page_id":"/quickstart","tags":[],"type":"text","url":"/quickstart","content":"Install EcoRouter and run your first execution."},"152":{"id":"/quickstart-1","page_id":"/quickstart","type":"heading","tags":[],"url":"/quickstart#install","content":"Install"},"153":{"id":"/quickstart-2","page_id":"/quickstart","type":"heading","tags":[],"url":"/quickstart#prerequisites","content":"Prerequisites"},"154":{"id":"/quickstart-3","page_id":"/quickstart","type":"heading","tags":[],"url":"/quickstart#configure-the-router","content":"Configure the router"},"155":{"id":"/quickstart-4","page_id":"/quickstart","type":"heading","tags":[],"url":"/quickstart#execute","content":"Execute"},"156":{"id":"/quickstart-5","page_id":"/quickstart","type":"heading","tags":[],"url":"/quickstart#call-routerexecute","content":"Call `router.execute`"},"157":{"id":"/quickstart-6","page_id":"/quickstart","type":"heading","tags":[],"url":"/quickstart#read-the-result","content":"Read the result"},"158":{"id":"/quickstart-7","page_id":"/quickstart","tags":[],"type":"text","url":"/quickstart#prerequisites","content":"You need three things before the router can pay for anything:"},"159":{"id":"/quickstart-8","page_id":"/quickstart","tags":[],"type":"text","url":"/quickstart#prerequisites","content":"**A deployed `ecorouter-account` Soroban contract** holding USDC on `stellar:testnet`, with an active mandate created via `create_mandate` (see Contract)."},"160":{"id":"/quickstart-9","page_id":"/quickstart","tags":[],"type":"text","url":"/quickstart#prerequisites","content":"**A session keypair** whose public key is the mandate's `session_public_key`."},"161":{"id":"/quickstart-10","page_id":"/quickstart","tags":[],"type":"text","url":"/quickstart#prerequisites","content":"**A `PaymentClient` implementation.** The SDK defines the interface but does not ship a concrete client. You supply the code that reads mandate state and submits the authorized transfer (see Payment Client)."},"162":{"id":"/quickstart-11","page_id":"/quickstart","tags":[],"type":"text","url":"/quickstart#configure-the-router","content":"The constructor validates the config: at least two providers, unique ids, HTTPS endpoints on public hostnames, and `qualityScore` between 0 and 1."},"163":{"id":"/quickstart-12","page_id":"/quickstart","tags":[],"type":"text","url":"/quickstart#read-the-result","content":"Reusing an `executionId` is safe: a completed execution returns its cached result. An id that is running, failed, or whose settlement state is unknown throws."},"164":{"id":"/quickstart-13","page_id":"/quickstart","tags":[],"type":"text","url":"/quickstart#read-the-result","content":"Want to see the internals live? Try the Playground, or read How It Works."}},"count":164},"sorting":{"language":"multilingual","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":79,"2":147,"3":81,"4":120,"5":78,"6":91,"7":82,"8":35,"9":14,"10":39,"11":19,"12":11,"13":155,"14":68,"15":59,"16":37,"17":38,"18":15,"19":84,"20":87,"21":117,"22":65,"23":48,"24":44,"25":50,"26":49,"27":51,"28":52,"29":42,"30":45,"31":43,"32":46,"33":47,"34":70,"35":40,"36":92,"37":114,"38":145,"39":116,"40":105,"41":134,"42":83,"43":149,"44":34,"45":16,"46":36,"47":26,"48":25,"49":154,"50":21,"51":24,"52":71,"53":4,"54":121,"55":143,"56":75,"57":76,"58":111,"59":136,"60":74,"61":18,"62":150,"63":60,"64":62,"65":64,"66":98,"67":20,"68":137,"69":156,"70":106,"71":113,"72":96,"73":133,"74":112,"75":95,"76":132,"77":66,"78":162,"79":160,"80":115,"81":28,"82":10,"83":3,"84":9,"85":8,"86":7,"87":5,"88":6,"89":107,"90":100,"91":41,"92":135,"93":141,"94":144,"95":124,"96":158,"97":85,"98":72,"99":17,"100":63,"101":56,"102":53,"103":57,"104":55,"105":58,"106":54,"107":161,"108":61,"109":151,"110":89,"111":138,"112":152,"113":13,"114":27,"115":108,"116":12,"117":140,"118":97,"119":142,"120":99,"121":104,"122":93,"123":125,"124":131,"125":69,"126":110,"127":128,"128":86,"129":148,"130":23,"131":123,"132":122,"133":94,"134":22,"135":146,"136":109,"137":67,"138":103,"139":159,"140":80,"141":88,"142":32,"143":30,"144":33,"145":29,"146":31,"147":118,"148":130,"149":153,"150":126,"151":102,"152":101,"153":119,"154":77,"155":90,"156":73,"157":127,"158":163,"159":1,"160":2,"161":0,"162":139,"163":129,"164":157},"orderedDocs":[[161,"**A `PaymentClient` implementation.** The SDK defines the interface but does not ship a concrete client. You supply the code that reads mandate state and submits the authorized transfer (see Payment Client)."],[159,"**A deployed `ecorouter-account` Soroban contract** holding USDC on `stellar:testnet`, with an active mandate created via `create_mandate` (see Contract)."],[160,"**A session keypair** whose public key is the mandate's `session_public_key`."],[83,"**Amount format.** `amount` is a string matching `^\\d+$`. Failure: `InvalidPaymentChallengeError`."],[53,"**Any other thrown value marks the execution `settlement_unknown`** and the router throws `PaymentSettlementUnknownError`, because the payment may have succeeded. A `settlement_unknown` execution id cannot be retried; retrying throws. Only throw a generic error when settlement truly is ambiguous."],[87,"**Local policy.** `amount <= parseUsdc(maxSpend)`. Failure: `PolicyExceededError`."],[88,"**Mandate limits.** `amount <= mandate.maxPaymentAtomic` and `amount <= mandate.remainingAtomic`. Failure: `MandateExceededError`."],[86,"**Mandate not expired.** `mandate.expiresAt` is greater than the current Unix time in seconds. Failure: `MandateExpiredError`."],[85,"**Mandate not revoked.** `mandate.revoked` is false. Failure: `MandateRevokedError`."],[84,"**Positive amount.** `BigInt(amount) > 0`. Failure: `InvalidPaymentChallengeError`."],[82,"**Supported requirements.** `x402Version === 2`, `scheme === \"exact\"`, `network === \"stellar:testnet\"`, `asset === mandate.asset`, and a non-empty `payTo` string. Failure: `InvalidPaymentChallengeError`."],[12,"`account` or `sessionSecret` is empty, or fewer than two providers are given."],[116,"`AccountError`: `AlreadyInitialized` (1), `NotInitialized` (2), `InvalidAmount` (3), `InvalidExpiration` (4), `MandateNotFound` (5), `MandateRevoked` (6), `MandateExpired` (7), `WrongSigner` (8), `UnsupportedInvocation` (9), `WrongAsset` (10), `WrongSource` (11), `PaymentAboveMaximum` (12), `AllowanceExceeded` (13)."],[113,"`amount <= mandate.max_payment` (`PaymentAboveMaximum`)."],[9,"`ArbiterConfig` is an alias of `EcoRouterConfig`, and `Arbiter` is an alias of the `EcoRouter` class."],[18,"`ArbiterExecutionResult` is an alias of `EcoRouterExecutionResult`."],[45,"`authorizeAndSettle` receives `{ account, sessionSecret, executionId, providerId, challenge }`."],[99,"`contracts/ecorouter-account` is a `no_std` Soroban smart account (crate type `cdylib`). It holds funds, stores a spending mandate, and authorizes outbound transfers through the `__check_auth` custom account interface. All types and behaviors below come from `contracts/ecorouter-account/src/lib.rs`."],[61,"`HttpWebSearchProvider` (in `providers/web-search.ts`) talks to providers over plain HTTP. Any endpoint that implements this contract works with the router."],[11,"`new EcoRouter(config)` throws `TypeError` when:"],[67,"`normalize` requires `results` to be an array whose items each have string `title`, `url`, and `snippet`. Anything else raises `ProviderResponseError`. A non-2xx response raises `ProviderExecutionError`."],[50,"`PaymentAuthorizationError` when signing or authorization definitively failed."],[134,"`paymentClient.authorizeAndSettle` signs the winning challenge with the session secret against the Soroban account. `PaymentAuthorizationError` and `PaymentSettlementError` propagate unchanged (the execution is marked `failed`). Any other exception marks the execution `settlement_unknown` and throws `PaymentSettlementUnknownError`, because the transfer may have gone through."],[130,"`paymentClient.loadMandate(account)` fetches the current on-chain `MandateState`: asset, `maxPaymentAtomic`, `remainingAtomic`, `expiresAt`, `revoked`."],[51,"`PaymentSettlementError` when the transfer definitively failed on-chain."],[48,"`SettlementReceipt` is `{ transactionHash: string }`. The hash is returned in `result.payment.transactionHash`."],[47,"`SignedPayment` is `{ payload: string; transactionHash?: string }`. The payload is sent back to the provider in the `payment-signature` header."],[114,"`spent + amount <= mandate.total_limit` (`AllowanceExceeded`), using checked arithmetic."],[81,"`validateChallenge(challenge, mandate, maxSpend, executionId?)` returns the accepted amount in atomic units, or throws. It runs these checks in exact order, from `x402/validate.ts`:"],[145,"<Card title=\"API Reference\" href=\"/api/ecorouter\" description=\"Every interface, function, and error in the SDK.\" />"],[143,"<Card title=\"How It Works\" href=\"/how-it-works\" description=\"The exact pipeline from probe to normalized result.\" />"],[146,"<Card title=\"Playground\" href=\"/playground\" description=\"Run the real validation and selection functions in your browser.\" />"],[142,"<Card title=\"Quickstart\" href=\"/quickstart\" description=\"Install the SDK and run your first paid execution.\" />"],[144,"<Card title=\"Smart Account Contract\" href=\"/contract\" description=\"The Soroban mandate and what __check_auth enforces.\" />"],[44,"<TypeTable type=\"{ 'loadMandate(account)': { description: 'Read the current on-chain mandate for the account contract…\" />"],[8,"<TypeTable type=\"{ account: { description: 'Address of the deployed ecorouter-account contract. Required, non-empty.'…\" />"],[46,"<TypeTable type=\"{ asset: { description: 'Asset identifier the mandate allows (USDC).', type: 'string', required: tru…\" />"],[16,"<TypeTable type=\"{ executionId: { description: 'Idempotency key. A random UUID is generated when omitted.', type: 'st…\" />"],[17,"<TypeTable type=\"{ executionId: { description: 'The idempotency key used for this run.', type: 'string', required: tr…\" />"],[10,"<TypeTable type=\"{ id: { description: 'Unique provider identifier.', type: 'string', required: true, }, capability: {…\" />"],[35,"<TypeTable type=\"{ providerId: { description: 'The winning provider the settlement targeted.', type: 'string' }, tran…\" />"],[91,"<TypeTable type=\"{ x402Version: { description: 'Must be 2.', type: 'number', required: true }, scheme: { description:…\" />"],[29,"| Code                          | Class                       | Thrown when                                                                  |\n| ----------------------------- | --------------------------- | ---------------------------------------------------------------------------- |\n| `PAYMENT_AUTHORIZATION_ERROR` | `PaymentAuthorizationError` | Your `PaymentClient` threw it; signing or authorization definitively failed. |"],[31,"| Code                         | Class                           | Thrown when                                                              |\n| ---------------------------- | ------------------------------- | ------------------------------------------------------------------------ |\n| `PAYMENT_SETTLEMENT_UNKNOWN` | `PaymentSettlementUnknownError` | `authorizeAndSettle` threw anything else; settlement may have succeeded. |"],[24,"| Code                        | Class                          | Thrown when                                                                                                                                                    |\n| --------------------------- | ------------------------------ | -------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `INVALID_PAYMENT_CHALLENGE` | `InvalidPaymentChallengeError` | A provider did not return HTTP 402, omitted or malformed `payment-required`, or the challenge failed shape, network, scheme, asset, `payTo`, or amount checks. |"],[30,"| Code                       | Class                    | Thrown when                                                      |\n| -------------------------- | ------------------------ | ---------------------------------------------------------------- |\n| `PAYMENT_SETTLEMENT_ERROR` | `PaymentSettlementError` | Your `PaymentClient` threw it; the transfer definitively failed. |"],[32,"| Code                       | Class                    | Thrown when                                                    |\n| -------------------------- | ------------------------ | -------------------------------------------------------------- |\n| `PROVIDER_EXECUTION_ERROR` | `ProviderExecutionError` | The paid provider request failed (non-2xx or transport error). |"],[33,"| Code                      | Class                   | Thrown when                                                               |\n| ------------------------- | ----------------------- | ------------------------------------------------------------------------- |\n| `PROVIDER_RESPONSE_ERROR` | `ProviderResponseError` | The paid response did not match `{ results: [{ title, url, snippet }] }`. |"],[23,"| Code                   | Class                     | Thrown when                                                                               |\n| ---------------------- | ------------------------- | ----------------------------------------------------------------------------------------- |\n| `NO_ELIGIBLE_PROVIDER` | `NoEligibleProviderError` | No provider survived capability, challenge, quality, and validation filters in `execute`. |"],[26,"| Code               | Class                  | Thrown when                                             |\n| ------------------ | ---------------------- | ------------------------------------------------------- |\n| `MANDATE_EXCEEDED` | `MandateExceededError` | Amount exceeds `maxPaymentAtomic` or `remainingAtomic`. |"],[25,"| Code              | Class                 | Thrown when                                     |\n| ----------------- | --------------------- | ----------------------------------------------- |\n| `POLICY_EXCEEDED` | `PolicyExceededError` | Challenge amount exceeds `policy.maxSpendUsdc`. |"],[27,"| Code              | Class                 | Thrown when                              |\n| ----------------- | --------------------- | ---------------------------------------- |\n| `MANDATE_EXPIRED` | `MandateExpiredError` | `mandate.expiresAt` is at or before now. |"],[28,"| Code              | Class                 | Thrown when             |\n| ----------------- | --------------------- | ----------------------- |\n| `MANDATE_REVOKED` | `MandateRevokedError` | The mandate is revoked. |"],[102,"| Function                                                                          | Auth  | Effect                                                                                                                                                                                                                    |\n| --------------------------------------------------------------------------------- | ----- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `create_mandate(session_public_key, asset, total_limit, max_payment, expires_at)` | owner | Creates the mandate with `spent = 0`, `revoked = false`. Rejects non-positive limits, `max_payment > total_limit` (`InvalidAmount`), and `expires_at` in the past (`InvalidExpiration`). Emits a `mandate created` event. |"],[106,"| Function                                                    | Auth        | Effect                                                                                         |\n| ----------------------------------------------------------- | ----------- | ---------------------------------------------------------------------------------------------- |\n| `__check_auth(signature_payload, signature, auth_contexts)` | session key | The authorization hook invoked by the Soroban host when the account is required as an invoker. |"],[104,"| Function                      | Auth  | Effect                                                                                                                                                        |\n| ----------------------------- | ----- | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `withdraw(asset, to, amount)` | owner | Transfers any token out of the contract via the token client. `amount` must be positive. This is the owner escape hatch; the session key can never invoke it. |"],[101,"| Function            | Auth                   | Effect                                                             |\n| ------------------- | ---------------------- | ------------------------------------------------------------------ |\n| `initialize(owner)` | `owner.require_auth()` | Stores the owner. Fails with `AlreadyInitialized` if called twice. |"],[103,"| Function           | Auth  | Effect                                                  |\n| ------------------ | ----- | ------------------------------------------------------- |\n| `revoke_mandate()` | owner | Sets `revoked = true`. Emits a `mandate revoked` event. |"],[105,"| Function        | Auth | Effect                                             |\n| --------------- | ---- | -------------------------------------------------- |\n| `get_mandate()` | none | Returns the current mandate, or `MandateNotFound`. |"],[15,"A `qualityScore` is outside 0 to 1."],[63,"A compliant provider replies HTTP 402 with a `payment-required` header containing a base64 (or base64url) encoded JSON `PaymentChallenge`:"],[108,"A mandate exists (`MandateNotFound`), is not revoked (`MandateRevoked`), and has not expired (`MandateExpired`)."],[64,"A non-402 status, a missing header, or malformed base64 JSON raises `InvalidPaymentChallengeError` for that provider."],[100,"A single mandate is stored in instance storage under `DataKey::Mandate`; the owner address is stored under `DataKey::Owner`."],[65,"After settlement the SDK retries the same POST with the signed payload:"],[22,"All SDK errors extend `EcoRouterError` (alias `ArbiterError`), which carries `code: EcoRouterErrorCode` and an optional `executionId`."],[77,"All three are exported from the package root, so `import { selectProvider } from \"ecorouter\"` works."],[137,"All token amounts are atomic integers (USDC has 7 decimals), never floating point. `maxSpendUsdc` strings are parsed by `parseUsdc`."],[14,"An endpoint is not HTTPS, or its hostname is local (localhost, private ranges, link-local, IPv6 ULA)."],[125,"Authorize and settle"],[34,"Beyond `code` and `executionId`, it carries:"],[52,"Both propagate unchanged and mark the execution `failed`, so the same `executionId` can be retried."],[98,"Building and deploying"],[156,"Call `router.execute`"],[60,"Capability"],[56,"Challenge request"],[57,"Challenge response"],[154,"Configure the router"],[5,"Constructor validation"],[1,"EcoRouter"],[140,"EcoRouter is a local TypeScript SDK for capability-based purchasing by autonomous agents. Instead of hardcoding an API vendor, your agent asks for a capability such as `web.search`. The SDK probes configured providers over HTTP 402 (x402 V2 `exact`), validates each offer against your local spend policy and the on-chain Soroban mandate, picks the best value deterministically, settles the payment in USDC on `stellar:testnet`, and normalizes the response into one predictable shape."],[3,"EcoRouterConfig"],[7,"EcoRouterExecutionResult"],[42,"Error contract"],[19,"Errors"],[97,"Errors"],[128,"Every call to `router.execute` runs the same deterministic pipeline, implemented in `packages/sdk/src/ecorouter.ts`."],[20,"Every EcoRouterErrorCode, its class, and when it is thrown."],[141,"Everything runs on your machine. There are no hosted services, no registries, and no custodial wallets. Payment authorization is enforced on Stellar by the `ecorouter-account` Soroban smart account, which gates every transfer through `__check_auth` against a mandate you control."],[110,"Exactly one authorization context, and it must be a `Context::Contract` call (`UnsupportedInvocation`). Administrative functions are structurally impossible for the session key."],[155,"Execute"],[6,"ExecuteRequest"],[36,"Executions that end `settlement_unknown` cannot be retried under the same `executionId`; the router throws instead of risking a double payment."],[122,"Filter and challenge providers"],[133,"For each eligible offer the router reads the in-memory success metrics for that provider id. `successRate` is `successCount / total`, or `1` when there is no history. `selectProvider` computes `economicCost = priceAtomic / (qualityScore * successRate)` and picks the lowest, breaking ties on lower `priceAtomic`, then lexically smaller `providerId`. No eligible provider means `NoEligibleProviderError`."],[75,"Formats atomic units back to a decimal string, trimming trailing zeros. Throws `RangeError` for negative values."],[72,"formatUsdc"],[118,"How It Works"],[66,"HTTP 200 with a JSON body of normalized shape:"],[120,"Idempotency check"],[90,"Inside `router.execute`, validation failures do not throw. They silently disqualify that provider; a provider is only removed from the eligible set."],[152,"Install"],[151,"Install EcoRouter and run your first execution."],[138,"Introduction"],[121,"Load the mandate"],[40,"MandateState"],[70,"Money parsing and provider selection helpers exported by the SDK."],[89,"Note the ordering consequences: a revoked or expired mandate throws before any policy check, and the local `maxSpend` cap is evaluated before the on-chain mandate caps."],[115,"On success the contract increments `spent` and emits a `payment authorized` event carrying asset, recipient, amount, new spent, and remaining allowance."],[136,"On success the provider's `successCount` increments and the router returns `EcoRouterExecutionResult`: the execution id, normalized output, the decision record (provider, price in USDC, quality, success rate, economic cost), the payment receipt, and the remaining mandate balance."],[126,"Paid execute and normalize"],[58,"Paid request"],[74,"Parses a non-negative decimal string with at most 7 places into atomic units (USDC has 7 decimals, so `1` equals `10_000_000` atomic). Throws `TypeError` on any other input format."],[71,"parseUsdc"],[37,"Payment Client"],[80,"PaymentChallenge"],[39,"PaymentClient"],[21,"PaymentSettlementUnknownError"],[147,"Playground"],[153,"Prerequisites"],[4,"ProviderConfig"],[54,"Providers"],[132,"Providers below `policy.minimumQuality` are discarded. Each surviving challenge is checked by `validateChallenge` against the mandate and `policy.maxSpendUsdc`. Failures are discarded, not thrown. See x402 validation for the exact check order."],[131,"Providers whose `capability` does not match the request are dropped. Every remaining provider gets a concurrent probe: `POST` the JSON input, expect HTTP 402 plus a `payment-required` header. Each challenge is raced against a 5000 ms timeout via `Promise.allSettled`, so one slow or broken provider cannot stall the rest."],[95,"Public functions"],[123,"Quality filter and challenge validation"],[150,"Quickstart"],[157,"Read the result"],[127,"Return"],[163,"Reusing an `executionId` is safe: a completed execution returns its cached result. An id that is running, failed, or whose settlement state is unknown throws."],[148,"Run the real SDK validation and selection functions in your browser."],[124,"Score and select"],[76,"Scores each candidate as `economicCost = priceAtomic / (qualityScore * successRate)` and returns the lowest. Ties break on lower `priceAtomic`, then lexically smaller `providerId`. Throws `RangeError` on an empty list. The result adds `economicCost` to the input fields."],[73,"selectProvider"],[41,"SignedPayment and SettlementReceipt"],[92,"Smart Account Contract"],[59,"Success response"],[68,"The `Capability` type is `\"web.search\"`. Providers are matched to requests by exact capability string before being probed."],[111,"The called contract equals `mandate.asset` (`WrongAsset`), the function is `transfer` with exactly 3 arguments (`UnsupportedInvocation`)."],[162,"The constructor validates the config: at least two providers, unique ids, HTTPS endpoints on public hostnames, and `qualityScore` between 0 and 1."],[117,"The contract is a standard Soroban `cdylib` crate. Build and deploy with the Stellar CLI (`stellar contract build`, `stellar contract deploy`), then call `initialize` with the owner address and `create_mandate` to bind a session key, asset, and limits. The repository does not ship deploy scripts; see the Soroban docs for network-specific commands."],[93,"The ecorouter-account Soroban contract and its mandate enforcement."],[119,"The exact execution pipeline inside router.execute."],[55,"The HTTP contract a web.search provider must implement."],[94,"The Mandate"],[38,"The PaymentClient interface you implement, its types, and its error contract."],[135,"The provider is retried with the `payment-signature` header. The response must be `{ results: [{ title, url, snippet }] }`; anything else raises `ProviderResponseError`. Other failures raise `ProviderExecutionError` and count against the provider's metrics."],[2,"The router class, its config, and the execution request and result types."],[129,"The router resolves `executionId` (or generates a random UUID), then checks its in-memory execution map. A `complete` entry returns the cached result immediately. A `running`, `failed`, or `settlement_unknown` entry throws. Otherwise the id is marked `running`."],[43,"The SDK does not ship a Stellar transport implementation. You provide a `PaymentClient` that reads mandate state and submits the authorized transfer. The router treats its return value and its errors precisely."],[62,"The SDK sends the input as a JSON POST body:"],[109,"The signer public key equals `mandate.session_public_key` (`WrongSigner`), and the Ed25519 signature verifies over the payload."],[112,"The transfer source is the account contract itself (`WrongSource`) and `amount > 0` (`InvalidAmount`)."],[149,"These panels import the actual functions from `packages/sdk/src` (`validateChallenge`, `selectProvider`, `parseUsdc`, `formatUsdc`) and run them locally in your browser on every change. No network calls and no payments happen; nothing is signed or sent anywhere."],[49,"Throw the typed errors for definite failures:"],[13,"Two providers share the same `id`."],[69,"Utilities"],[164,"Want to see the internals live? Try the Playground, or read How It Works."],[96,"What `__check_auth` enforces"],[139,"What EcoRouter is and how the pieces fit together."],[79,"What validateChallenge checks, in order."],[107,"When a session key signs an invocation that requires this account's auth, the contract checks, in order:"],[78,"x402 Validation"],[158,"You need three things before the router can pay for anything:"]],"type":"string"},"page_id":{"docs":{"1":9,"2":10,"3":11,"4":12,"5":13,"6":14,"7":15,"8":16,"9":17,"10":18,"11":19,"12":20,"13":21,"14":22,"15":23,"16":24,"17":25,"18":26,"19":27,"20":28,"21":29,"22":30,"23":31,"24":32,"25":33,"26":34,"27":35,"28":36,"29":37,"30":38,"31":39,"32":40,"33":41,"34":42,"35":43,"36":44,"37":45,"38":46,"39":47,"40":48,"41":49,"42":50,"43":51,"44":52,"45":53,"46":54,"47":55,"48":56,"49":57,"50":58,"51":59,"52":60,"53":61,"54":62,"55":63,"56":64,"57":65,"58":66,"59":67,"60":68,"61":69,"62":70,"63":71,"64":72,"65":73,"66":74,"67":75,"68":76,"69":77,"70":78,"71":79,"72":80,"73":81,"74":82,"75":83,"76":84,"77":85,"78":86,"79":87,"80":88,"81":89,"82":90,"83":91,"84":92,"85":93,"86":94,"87":95,"88":96,"89":97,"90":98,"91":99,"92":100,"93":101,"94":102,"95":103,"96":104,"97":105,"98":106,"99":107,"100":108,"101":109,"102":110,"103":111,"104":112,"105":113,"106":114,"107":115,"108":116,"109":117,"110":118,"111":119,"112":120,"113":121,"114":122,"115":123,"116":124,"117":125,"118":126,"119":127,"120":128,"121":129,"122":130,"123":131,"124":132,"125":133,"126":134,"127":135,"128":136,"129":137,"130":138,"131"