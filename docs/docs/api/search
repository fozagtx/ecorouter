,"304":8,"305":8,"306":7,"307":7,"308":7,"309":7,"310":7,"311":6,"312":6,"313":6,"314":6,"315":6,"316":6,"317":6,"318":6,"319":6,"320":5,"321":5,"322":5,"323":5,"324":5,"325":5,"326":5,"327":5,"328":5,"329":5,"330":5,"331":5,"332":3,"333":3,"334":6,"335":5,"336":3,"337":3,"338":6,"339":6,"340":6,"341":6,"342":6,"343":6,"344":6,"345":6,"346":6,"347":6,"348":6,"349":6,"350":6,"351":6,"352":5,"353":5,"354":4,"355":4,"356":5,"357":6,"358":4,"359":5,"360":5,"361":5,"362":5,"363":5,"364":6,"365":6,"366":6,"367":2,"368":2,"369":4,"370":6,"371":6,"372":2,"373":4,"374":4,"375":4,"376":4,"377":4,"378":6,"379":6,"380":6,"381":6,"382":6,"383":6,"384":6,"385":6,"386":6,"387":2,"388":2,"389":5,"390":8,"391":8,"392":7,"393":2,"394":5,"395":5,"396":5,"397":5,"398":5,"399":8,"400":8,"401":7,"402":4,"403":4,"404":4,"405":4,"406":4,"407":4,"408":4,"409":4,"410":8,"411":6,"412":6,"413":7,"414":4,"415":8,"416":8,"417":8,"418":8,"419":8,"420":8,"421":8,"422":8,"423":8,"424":8,"425":8,"426":6,"427":6,"428":6,"429":6,"430":6,"431":7,"432":6,"433":6,"434":6,"435":6,"436":6,"437":6,"438":6}}},"docs":{"docs":{"1":{"id":"/agents/agent-limits","page_id":"/agents/agent-limits","type":"page","content":"Agent limits","breadcrumbs":["EcoRouter Docs","Agents"],"tags":[],"url":"/agents/agent-limits"},"2":{"id":"/agents/agent-limits-0","page_id":"/agents/agent-limits","tags":[],"type":"text","url":"/agents/agent-limits","content":"What an agent key can do, what the policy limits, and what remains outside the contract."},"3":{"id":"/agents/agent-limits-1","page_id":"/agents/agent-limits","tags":[],"type":"text","url":"/agents/agent-limits","content":"An agent signs only as its own spender address. `pay` does not accept a recipient address; it resolves a service id through the registry. The policy limits the allowance, period, per-payment amount, payment count, expiry and approved services. The owner can pause or remove the spender."},"4":{"id":"/agents/agent-limits-2","page_id":"/agents/agent-limits","tags":[],"type":"text","url":"/agents/agent-limits","content":"Agents cannot file approval requests. A refused agent payment ends at the contract check that failed. To permit a different payment, the owner must change the policy."},"5":{"id":"/agents/agent-limits-3","page_id":"/agents/agent-limits","tags":[],"type":"text","url":"/agents/agent-limits","content":"The SDK worker runs one agent and one service per Render worker. Its key is a hot key held by the worker environment; the policy does not prevent someone with that key from spending within its limits. Keep the policy narrow and rotate or remove the spender if the key is exposed."},"6":{"id":"/agents/agent-limits-4","page_id":"/agents/agent-limits","tags":[],"type":"text","url":"/agents/agent-limits","content":"EcoRouter is testnet-only and unaudited. The registered testnet services pay demo addresses controlled by the deployer; they are not outside merchants."},"7":{"id":"/agents/agent-limits-5","page_id":"/agents/agent-limits","tags":[],"type":"text","url":"/agents/agent-limits","content":"Sources: `contracts/team-account/src/lib.rs` (`pay`, `request_approval`, `set_policy`, `set_spender_paused`, `remove_spender`); `packages/sdk/src/worker.ts`; `deployments/testnet.json`."},"8":{"id":"/agents/overview","page_id":"/agents/overview","type":"page","content":"Agents","breadcrumbs":["EcoRouter Docs","Agents"],"tags":[],"url":"/agents/overview"},"9":{"id":"/agents/overview-0","page_id":"/agents/overview","tags":[],"type":"text","url":"/agents/overview","content":"An agent is a spender with its own Stellar key and an on-chain spending policy."},"10":{"id":"/agents/overview-1","page_id":"/agents/overview","tags":[],"type":"text","url":"/agents/overview","content":"An agent is a program using its own Stellar address as a spender. The owner creates its policy in **Spenders**. The contract applies the same service allowlist, cap, allowance, payment count, expiry and pause checks to each payment."},"11":{"id":"/agents/overview-2","page_id":"/agents/overview","tags":[],"type":"text","url":"/agents/overview","content":"An agent signs its own `pay` call. Its key cannot change policies, withdraw USDC or approve requests. If the payment fails a rule, the call stops; an agent cannot file an approval request (`AgentCannotRequest`)."},"12":{"id":"/agents/overview-3","page_id":"/agents/overview","tags":[],"type":"text","url":"/agents/overview","content":"The app's **Agents** screen reads agent-kind spenders, their policies, usage and recent activity. Scheduled execution runs in the SDK worker, not in the browser. See SDK, The worker and Agent limits."},"13":{"id":"/agents/overview-4","page_id":"/agents/overview","tags":[],"type":"text","url":"/agents/overview","content":"Sources: `packages/app/src/screens/Agents.tsx`; `packages/sdk/src/worker.ts`; `contracts/team-account/src/lib.rs` (`set_policy`, `pay`, `request_approval`)."},"14":{"id":"/agents/sdk","page_id":"/agents/sdk","type":"page","content":"Agent SDK","breadcrumbs":["EcoRouter Docs","Agents"],"tags":[],"url":"/agents/sdk"},"15":{"id":"/agents/sdk-0","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk","content":"Install and use the EcoRouter TypeScript SDK for team-account agent payments."},"16":{"id":"/agents/sdk-1","page_id":"/agents/sdk","type":"heading","tags":[],"url":"/agents/sdk#install","content":"Install"},"17":{"id":"/agents/sdk-2","page_id":"/agents/sdk","type":"heading","tags":[],"url":"/agents/sdk#use-from-any-language","content":"Use from any language"},"18":{"id":"/agents/sdk-3","page_id":"/agents/sdk","type":"heading","tags":[],"url":"/agents/sdk#example","content":"Example"},"19":{"id":"/agents/sdk-4","page_id":"/agents/sdk","type":"heading","tags":[],"url":"/agents/sdk#public-api","content":"Public API"},"20":{"id":"/agents/sdk-5","page_id":"/agents/sdk","type":"heading","tags":[],"url":"/agents/sdk#safe-retry","content":"Safe retry"},"21":{"id":"/agents/sdk-6","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk","content":"The package `ecorouter` exposes `TeamAgent` for the deployed team-account contract. It uses `@stellar/stellar-sdk` and defaults to the testnet values in `TESTNET`. The TypeScript source is in `packages/sdk/src/index.ts`."},"22":{"id":"/agents/sdk-7","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#install","content":"The package is ESM and builds TypeScript from `src/` to `dist/`."},"23":{"id":"/agents/sdk-8","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#use-from-any-language","content":"The `ecorouter-agent` binary has a one-shot `pay` subcommand. It reads `AGENT_SECRET` and the optional `TEAM_ACCOUNT_ID` and `RPC_URL` from the environment, calls `TeamAgent.pay` once, and writes the outcome as one JSON line. `bigint` fields are decimal strings. Exit status is `0` for paid, `3` for refused, `4` for pending, `2` for invalid arguments, and `1` for an unexpected error."},"24":{"id":"/agents/sdk-9","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#use-from-any-language","content":"`--key` is optional and must be 64 hexadecimal characters when supplied. Reuse the same key to safely retry an unknown result. A caller can parse the JSON line and branch on `status`:"},"25":{"id":"/agents/sdk-10","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#use-from-any-language","content":"With no subcommand, the same binary starts the scheduled worker described in The worker."},"26":{"id":"/agents/sdk-11","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#example","content":"`TeamAgent` exposes the public address as `address`; use the same address when the owner creates the agent policy. `teamAccount`, `rpcUrl` and `networkPassphrase` are optional overrides in the constructor."},"27":{"id":"/agents/sdk-12","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#public-api","content":"USDC amounts passed as strings are decimal USDC values with at most seven fractional places. A `bigint` is already in the token's base units. `scheduleKey` returns a SHA-256 hex digest of `ecorouter:v1:${team}:${agent}:${service}:${slot}`."},"28":{"id":"/agents/sdk-13","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#public-api","content":"The i128 monetary values are `bigint`."},"29":{"id":"/agents/sdk-14","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#public-api","content":"`PayOutcome` is a discriminated union:"},"30":{"id":"/agents/sdk-15","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#public-api","content":"| Status | Fields                                    | Meaning                               |\n| ------ | ----------------------------------------- | ------------------------------------- |\n| `paid` | `key`, `txHash`, `explorerUrl`, `receipt` | The transaction succeeded on testnet. |","table":"table-0"},"31":{"id":"/agents/sdk-16","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#public-api","content":"| Status    | Fields                            | Meaning                                           |\n| --------- | --------------------------------- | ------------------------------------------------- |\n| `refused` | `key`, `rule`, `reason`, `overBy` | The contract refused the payment; no funds moved. |","table":"table-0"},"32":{"id":"/agents/sdk-17","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#public-api","content":"| Status    | Fields          | Meaning                                                                       |\n| --------- | --------------- | ----------------------------------------------------------------------------- |\n| `pending` | `key`, `txHash` | Confirmation was not seen within about 60 seconds. Reconcile before retrying. |","table":"table-0"},"33":{"id":"/agents/sdk-18","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#public-api","content":"`Rule` and `ruleReason` cover the 25 `AccountError` codes. See Error codes."},"34":{"id":"/agents/sdk-19","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#safe-retry","content":"`pay()` does not resend a transaction automatically. If the result is unknown, call `reconcile(key)`. A safe retry calls `pay()` again with the **same key**. The contract rejects a reused key with rule 7 (`DuplicatePayment`) if the first transaction already paid; `reconcile()` checks `is_key_used` to distinguish that case. Reads, simulations and account-sequence lookups retry network errors up to three times with backoff."},"35":{"id":"/agents/sdk-20","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#safe-retry","content":"Offline tests are in `packages/sdk/test/sdk.test.js`. The testnet integration script is `packages/sdk/test/live.testnet.mjs`; it is gated by `ECOROUTER_LIVE=1`."},"36":{"id":"/agents/sdk-21","page_id":"/agents/sdk","tags":[],"type":"text","url":"/agents/sdk#safe-retry","content":"Source: `packages/sdk/src/index.ts`; contract methods `check`, `pay` and `is_key_used` in `contracts/team-account/src/lib.rs`."},"37":{"id":"/agents/the-worker","page_id":"/agents/the-worker","type":"page","content":"The worker","breadcrumbs":["EcoRouter Docs","Agents"],"tags":[],"url":"/agents/the-worker"},"38":{"id":"/agents/the-worker-0","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker","content":"Deploy the SDK worker on Render to run one agent and one service on a schedule."},"39":{"id":"/agents/the-worker-1","page_id":"/agents/the-worker","type":"heading","tags":[],"url":"/agents/the-worker#set-up-the-spender","content":"Set up the spender"},"40":{"id":"/agents/the-worker-2","page_id":"/agents/the-worker","type":"heading","tags":[],"url":"/agents/the-worker#create-the-render-worker","content":"Create the Render worker"},"41":{"id":"/agents/the-worker-3","page_id":"/agents/the-worker","type":"heading","tags":[],"url":"/agents/the-worker#how-the-schedule-avoids-duplicate-payments","content":"How the schedule avoids duplicate payments"},"42":{"id":"/agents/the-worker-4","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker","content":"The worker is `packages/sdk/src/worker.ts`, built to `packages/sdk/dist/worker.js`. It runs outside the web app. The Render service is declared in `render.yaml` with the `starter` plan."},"43":{"id":"/agents/the-worker-5","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#set-up-the-spender","content":"Generate a Stellar keypair for the agent and keep the secret outside the browser."},"44":{"id":"/agents/the-worker-6","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#set-up-the-spender","content":"Add the public address in **Spenders** as an AI agent."},"45":{"id":"/agents/the-worker-7","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#set-up-the-spender","content":"Set an allowance, period, per-payment cap, payment count, expiry and service allowlist. The selected service must also be active in the registry."},"46":{"id":"/agents/the-worker-8","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#set-up-the-spender","content":"Keep the agent secret for the Render environment. Do not use the owner's secret."},"47":{"id":"/agents/the-worker-9","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#create-the-render-worker","content":"Create or update the Render Blueprint from the repository's `render.yaml`. The worker service uses Node and the `starter` plan. Set these environment variables:"},"48":{"id":"/agents/the-worker-10","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#create-the-render-worker","content":"| Variable       | Required | Value                                                             |\n| -------------- | -------- | ----------------------------------------------------------------- |\n| `AGENT_SECRET` | Yes      | Secret key for the agent spender. Store it as a secret in Render. |","table":"table-0"},"49":{"id":"/agents/the-worker-11","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#create-the-render-worker","content":"| Variable        | Required | Value                                                     |\n| --------------- | -------- | --------------------------------------------------------- |\n| `AGENT_SERVICE` | Yes      | One service id permitted by the policy, such as `search`. |","table":"table-0"},"50":{"id":"/agents/the-worker-12","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#create-the-render-worker","content":"| Variable       | Required | Value                                      |\n| -------------- | -------- | ------------------------------------------ |\n| `AGENT_AMOUNT` | Yes      | Decimal USDC amount within the policy cap. |","table":"table-0"},"51":{"id":"/agents/the-worker-13","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#create-the-render-worker","content":"| Variable      | Required | Value                                       |\n| ------------- | -------- | ------------------------------------------- |\n| `AGENT_EVERY` | No       | `hour`, `day` or `week`; defaults to `day`. |","table":"table-0"},"52":{"id":"/agents/the-worker-14","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#create-the-render-worker","content":"| Variable     | Required | Value                  |\n| ------------ | -------- | ---------------------- |\n| `AGENT_MEMO` | No       | Optional payment memo. |","table":"table-0"},"53":{"id":"/agents/the-worker-15","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#create-the-render-worker","content":"| Variable          | Required | Value                                                        |\n| ----------------- | -------- | ------------------------------------------------------------ |\n| `TEAM_ACCOUNT_ID` | No       | Team-account contract id; defaults to `TESTNET.teamAccount`. |","table":"table-0"},"54":{"id":"/agents/the-worker-16","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#create-the-render-worker","content":"| Variable  | Required | Value                                                           |\n| --------- | -------- | --------------------------------------------------------------- |\n| `RPC_URL` | No       | Soroban RPC endpoint; defaults to the testnet URL in `TESTNET`. |","table":"table-0"},"55":{"id":"/agents/the-worker-17","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#create-the-render-worker","content":"One worker instance handles one agent and one service. To run another combination, deploy another worker service. The app's Agents screen displays the team-account id and each configured agent address."},"56":{"id":"/agents/the-worker-18","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#how-the-schedule-avoids-duplicate-payments","content":"Every 60 seconds, the worker calculates the current slot and derives a deterministic key with `scheduleKey(team, agent, service, slot)`. It first calls `reconcile(key)`, which reads `is_key_used`. A paid key is skipped. Otherwise the worker calls `pay` with that same key."},"57":{"id":"/agents/the-worker-19","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#how-the-schedule-avoids-duplicate-payments","content":"A refusal is logged and is not retried for that slot by the running process. A pending result is checked again after 150 seconds; the same key is used. No disk state is required. If a network failure leaves the outcome unknown, a retry with the same key is safe because the contract rejects duplicates (`DuplicatePayment`, code 7)."},"58":{"id":"/agents/the-worker-20","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#how-the-schedule-avoids-duplicate-payments","content":"The worker emits one JSON line per event. It does not hold the owner key or have a function to change the policy."},"59":{"id":"/agents/the-worker-21","page_id":"/agents/the-worker","tags":[],"type":"text","url":"/agents/the-worker#how-the-schedule-avoids-duplicate-payments","content":"Source: `packages/sdk/src/worker.ts`, `packages/sdk/src/index.ts`; `render.yaml`; contract method `is_key_used`."},"60":{"id":"/getting-started/add-money","page_id":"/getting-started/add-money","type":"page","content":"Add money","breadcrumbs":["EcoRouter Docs","Getting started"],"tags":[],"url":"/getting-started/add-money"},"61":{"id":"/getting-started/add-money-0","page_id":"/getting-started/add-money","tags":[],"type":"text","url":"/getting-started/add-money","content":"Transfer testnet USDC from Freighter into the team-account contract."},"62":{"id":"/getting-started/add-money-1","page_id":"/getting-started/add-money","tags":[],"type":"text","url":"/getting-started/add-money","content":"The team account needs USDC before its spenders can pay. In **Settings**, enter an amount greater than zero and select **Add funds**. Review and sign the transfer in Freighter."},"63":{"id":"/getting-started/add-money-2","page_id":"/getting-started/add-money","tags":[],"type":"text","url":"/getting-started/add-money","content":"The app invokes the USDC token's `transfer` method with the connected wallet as the source and the team-account contract as the destination. The contract balance view reads the token balance. The connected wallet must hold testnet USDC and enough XLM for transaction fees."},"64":{"id":"/getting-started/add-money-3","page_id":"/getting-started/add-money","tags":[],"type":"text","url":"/getting-started/add-money","content":"This is a real testnet transfer. It is not a simulated balance change."},"65":{"id":"/getting-started/add-money-4","page_id":"/getting-started/add-money","tags":[],"type":"text","url":"/getting-started/add-money","content":"Source: `packages/app/src/screens/Settings.tsx`; `packages/app/src/chain/testnet.ts` (`deposit`); `contracts/team-account/src/lib.rs` (`balance`)."},"66":{"id":"/getting-started/connect-freighter","page_id":"/getting-started/connect-freighter","type":"page","content":"Connect Freighter","breadcrumbs":["EcoRouter Docs","Getting started"],"tags":[],"url":"/getting-started/connect-freighter"},"67":{"id":"/getting-started/connect-freighter-0","page_id":"/getting-started/connect-freighter","tags":[],"type":"text","url":"/getting-started/connect-freighter","content":"Connect the app to a Freighter wallet configured for Stellar testnet."},"68":{"id":"/getting-started/connect-freighter-1","page_id":"/getting-started/connect-freighter","tags":[],"type":"text","url":"/getting-started/connect-freighter","content":"The app requires Freighter and the Stellar testnet network. Install the wallet from freighter.app, open its network selector and choose **Testnet**, then reload the app."},"69":{"id":"/getting-started/connect-freighter-2","page_id":"/getting-started/connect-freighter","tags":[],"type":"text","url":"/getting-started/connect-freighter","content":"Choose **Connect Freighter** in the app. The backend checks `isConnected()`, requests access, reads the selected address and checks `getNetwork()` before creating the session. If Freighter is missing or its network is not Testnet, the app displays an error and leaves the button available to try again."},"70":{"id":"/getting-started/connect-freighter-3","page_id":"/getting-started/connect-freighter","tags":[],"type":"text","url":"/getting-started/connect-freighter","content":"Every transaction is signed in Freighter. The app does not receive or store the wallet's secret key."},"71":{"id":"/getting-started/connect-freighter-4","page_id":"/getting-started/connect-freighter","tags":[],"type":"text","url":"/getting-started/connect-freighter","content":"Source: `packages/app/src/chain/testnet.ts` (`TestnetBackend.connect`); `packages/app/src/screens/Welcome.tsx`."},"72":{"id":"/getting-started/quickstart","page_id":"/getting-started/quickstart","type":"page","content":"Quickstart","breadcrumbs":["EcoRouter Docs","Getting started"],"tags":[],"url":"/getting-started/quickstart"},"73":{"id":"/getting-started/quickstart-0","page_id":"/getting-started/quickstart","tags":[],"type":"text","url":"/getting-started/quickstart","content":"Connect a Freighter wallet to Stellar testnet and make a policy-limited payment."},"74":{"id":"/getting-started/quickstart-1","page_id":"/getting-started/quickstart","type":"heading","tags":[],"url":"/getting-started/quickstart#before-you-start","content":"Before you start"},"75":{"id":"/getting-started/quickstart-2","page_id":"/getting-started/quickstart","type":"heading","tags":[],"url":"/getting-started/quickstart#add-funds","content":"Add funds"},"76":{"id":"/getting-started/quickstart-3","page_id":"/getting-started/quickstart","type":"heading","tags":[],"url":"/getting-started/quickstart#add-a-spender-and-pay","content":"Add a spender and pay"},"77":{"id":"/getting-started/quickstart-4","page_id":"/getting-started/quickstart","tags":[],"type":"text","url":"/getting-started/quickstart","content":"EcoRouter is deployed on Stellar testnet. The app reads its default contract ids from `deployments/testnet.json` through `packages/app/src/chain/config.ts`."},"78":{"id":"/getting-started/quickstart-5","page_id":"/getting-started/quickstart","tags":[],"type":"text","url":"/getting-started/quickstart#before-you-start","content":"Install Freighter from freighter.app."},"79":{"id":"/getting-started/quickstart-6","page_id":"/getting-started/quickstart","tags":[],"type":"text","url":"/getting-started/quickstart#before-you-start","content":"In Freighter, select **Testnet**."},"80":{"id":"/getting-started/quickstart-7","page_id":"/getting-started/quickstart","tags":[],"type":"text","url":"/getting-started/quickstart#before-you-start","content":"Open the app at ecorouter.xyz/app."},"81":{"id":"/getting-started/quickstart-8","page_id":"/getting-started/quickstart","tags":[],"type":"text","url":"/getting-started/quickstart#before-you-start","content":"Select **Connect Freighter** and approve the connection."},"82":{"id":"/getting-started/quickstart-9","page_id":"/getting-started/quickstart","tags":[],"type":"text","url":"/getting-started/quickstart#before-you-start","content":"The app checks that Freighter is installed and on the expected network before enabling a session. See Connect Freighter."},"83":{"id":"/getting-started/quickstart-10","page_id":"/getting-started/quickstart","tags":[],"type":"text","url":"/getting-started/quickstart#add-funds","content":"In **Settings**, enter a positive amount and choose **Add funds**. Freighter signs a USDC transfer from your wallet to the team-account contract. See Add money."},"84":{"id":"/getting-started/quickstart-11","page_id":"/getting-started/quickstart","tags":[],"type":"text","url":"/getting-started/quickstart#add-a-spender-and-pay","content":"The owner adds a spender under **Spenders** and sets an allowance, period, cap, payment count, expiry and approved service ids. Open **Pay**, select a service from the registry and enter an amount. The app simulates `check` before it submits `pay`; the contract makes the final decision."},"85":{"id":"/getting-started/quickstart-12","page_id":"/getting-started/quickstart","tags":[],"type":"text","url":"/getting-started/quickstart#add-a-spender-and-pay","content":"Sources: `packages/app/src/chain/testnet.ts` (`connect`, `deposit`, `check`, `pay`); `contracts/team-account/src/lib.rs` (`check`, `pay`, `set_policy`)."},"86":{"id":"/how-it-works/architecture","page_id":"/how-it-works/architecture","type":"page","content":"Team account","breadcrumbs":["EcoRouter Docs","How it works"],"tags":[],"url":"/how-it-works/architecture"},"87":{"id":"/how-it-works/architecture-0","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture","content":"One shared USDC account, held by a Soroban contract, that every spender pays from."},"88":{"id":"/how-it-works/architecture-1","page_id":"/how-it-works/architecture","type":"heading","tags":[],"url":"/how-it-works/architecture#the-owner","content":"The owner"},"89":{"id":"/how-it-works/architecture-2","page_id":"/how-it-works/architecture","type":"heading","tags":[],"url":"/how-it-works/architecture#balance-and-spend","content":"Balance and spend"},"90":{"id":"/how-it-works/architecture-3","page_id":"/how-it-works/architecture","type":"heading","tags":[],"url":"/how-it-works/architecture#pausing-the-account","content":"Pausing the account"},"91":{"id":"/how-it-works/architecture-4","page_id":"/how-it-works/architecture","type":"heading","tags":[],"url":"/how-it-works/architecture#request-path","content":"Request path"},"92":{"id":"/how-it-works/architecture-5","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture","content":"A team account is one instance of the `team-account` contract on Stellar. It holds the team's USDC and a policy for every spender. Nobody holds the money directly: not the owner's wallet, not a teammate, not an agent's key. Money leaves the account only through the contract's own functions, after its checks pass."},"93":{"id":"/how-it-works/architecture-6","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#the-owner","content":"Each team account has one **owner**, the address that created it. Only the owner can:"},"94":{"id":"/how-it-works/architecture-7","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#the-owner","content":"withdraw funds,"},"95":{"id":"/how-it-works/architecture-8","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#the-owner","content":"add, change, pause, resume and remove spenders,"},"96":{"id":"/how-it-works/architecture-9","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#the-owner","content":"pause and unpause the whole account,"},"97":{"id":"/how-it-works/architecture-10","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#the-owner","content":"approve or decline approval requests,"},"98":{"id":"/how-it-works/architecture-11","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#the-owner","content":"hand ownership to another address (a two-step propose and accept)."},"99":{"id":"/how-it-works/architecture-12","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#the-owner","content":"Anyone can fund the account: it is an ordinary USDC transfer to the contract's address. The app's **Deposit** action does exactly that."},"100":{"id":"/how-it-works/architecture-13","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#the-owner","content":"In the app, the owner sees the **Overview** (balance, spend this period, spenders) and the **Approvals** screen."},"101":{"id":"/how-it-works/architecture-14","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#balance-and-spend","content":"The balance is the USDC the contract holds. \"Spent this period\" is the sum of what spenders have paid inside their current periods. Each spender's allowance is tracked separately, so one spender running out never blocks another."},"102":{"id":"/how-it-works/architecture-15","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#balance-and-spend","content":"Amounts are USDC in 7-decimal integer units on chain. The app shows dollars and cents, and its pre-check uses the same integer arithmetic as the contract."},"103":{"id":"/how-it-works/architecture-16","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#pausing-the-account","content":"Pausing the account stops every payment from every spender at the first check, before anything else is looked at. It also blocks settlement of approved requests. Deposits and owner actions still work. Unpause to resume."},"104":{"id":"/how-it-works/architecture-17","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#request-path","content":"The app reads the team-account and service-registry contracts through Soroban RPC. Freighter signs state-changing transactions. The agent SDK uses the same RPC contract and signs with an agent's Stellar key. Both clients can simulate `check`; the contract's `pay` method is the authority that transfers USDC."},"105":{"id":"/how-it-works/architecture-18","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#request-path","content":"The service registry maps a service id to its payee address. `pay` accepts the service id, not a destination address, and the account contract resolves the current payee before transferring."},"106":{"id":"/how-it-works/architecture-19","page_id":"/how-it-works/architecture","tags":[],"type":"text","url":"/how-it-works/architecture#request-path","content":"Sources: `packages/app/src/chain/testnet.ts`; `packages/sdk/src/index.ts`; `contracts/team-account/src/lib.rs`; `contracts/service-registry/src/lib.rs`."},"107":{"id":"/how-it-works/smart-contracts","page_id":"/how-it-works/smart-contracts","type":"page","content":"Contracts reference","breadcrumbs":["EcoRouter Docs","How it works"],"tags":[],"url":"/how-it-works/smart-contracts"},"108":{"id":"/how-it-works/smart-contracts-0","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts","content":"Public functions, types, events and errors of the team-account and service-registry Soroban contracts."},"109":{"id":"/how-it-works/smart-contracts-1","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#team-account","content":"team-account"},"110":{"id":"/how-it-works/smart-contracts-2","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#construction","content":"Construction"},"111":{"id":"/how-it-works/smart-contracts-3","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#owner-functions","content":"Owner functions"},"112":{"id":"/how-it-works/smart-contracts-4","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#spender-functions","content":"Spender functions"},"113":{"id":"/how-it-works/smart-contracts-5","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Check order in `pay`"},"114":{"id":"/how-it-works/smart-contracts-6","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#dry-run","content":"Dry run"},"115":{"id":"/how-it-works/smart-contracts-7","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#views","content":"Views"},"116":{"id":"/how-it-works/smart-contracts-8","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#types","content":"Types"},"117":{"id":"/how-it-works/smart-contracts-9","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#events","content":"Events"},"118":{"id":"/how-it-works/smart-contracts-10","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#errors","content":"Errors"},"119":{"id":"/how-it-works/smart-contracts-11","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#service-registry","content":"service-registry"},"120":{"id":"/how-it-works/smart-contracts-12","page_id":"/how-it-works/smart-contracts","type":"heading","tags":[],"url":"/how-it-works/smart-contracts#building","content":"Building"},"121":{"id":"/how-it-works/smart-contracts-13","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts","content":"Two Soroban contracts make up EcoRouter on Stellar. Both live in the repository under `contracts/`."},"122":{"id":"/how-it-works/smart-contracts-14","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts","content":"| Contract       | Path                     | Purpose                                                                       |\n| -------------- | ------------------------ | ----------------------------------------------------------------------------- |\n| `team-account` | `contracts/team-account` | Holds the team's USDC, stores a policy per spender, runs the checks and pays. |","table":"table-0"},"123":{"id":"/how-it-works/smart-contracts-15","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts","content":"| Contract           | Path                         | Purpose                                              |\n| ------------------ | ---------------------------- | ---------------------------------------------------- |\n| `service-registry` | `contracts/service-registry` | Resolves a service id to the address that gets paid. |","table":"table-0"},"124":{"id":"/how-it-works/smart-contracts-16","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts","content":"This page summarizes the public interface. The Rust source in `contracts/` is authoritative. Amounts are in the asset's atomic units (USDC has 7 decimals). Times are ledger timestamps in seconds."},"125":{"id":"/how-it-works/smart-contracts-17","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#construction","content":"`__constructor(owner, asset, registry)` sets the owner, the token contract to pay in (USDC) and the service registry. The account starts unpaused with no spenders."},"126":{"id":"/how-it-works/smart-contracts-18","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#construction","content":"There is no deposit function. To fund the account, transfer USDC to the contract's address; `balance()` reads the contract's token balance."},"127":{"id":"/how-it-works/smart-contracts-19","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#owner-functions","content":"All of these require the owner's signature."},"128":{"id":"/how-it-works/smart-contracts-20","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#owner-functions","content":"| Function                                  | Effect                                                                                                                                                                                                                                                                                                    |\n| ----------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `set_policy(spender, input: PolicyInput)` | Creates a spender or fully replaces its policy. A new spender starts a fresh period; an existing one keeps its period, usage and pause state. Fails with `InvalidPolicy` if any limit is not positive, `max_payment > allowance`, `expires_at` is not in the future, or more than 32 services are listed. |","table":"table-1"},"129":{"id":"/how-it-works/smart-contracts-21","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#owner-functions","content":"| Function                              | Effect                         |\n| ------------------------------------- | ------------------------------ |\n| `set_spender_paused(spender, paused)` | Pauses or resumes one spender. |","table":"table-1"},"130":{"id":"/how-it-works/smart-contracts-22","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#owner-functions","content":"| Function                  | Effect                                  |\n| ------------------------- | --------------------------------------- |\n| `remove_spender(spender)` | Deletes the spender's policy and usage. |","table":"table-1"},"131":{"id":"/how-it-works/smart-contracts-23","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#owner-functions","content":"| Function             | Effect                                                                                                               |\n| -------------------- | -------------------------------------------------------------------------------------------------------------------- |\n| `set_paused(paused)` | Pauses or resumes the whole account. A paused account authorizes nothing, including settlement of approved requests. |","table":"table-1"},"132":{"id":"/how-it-works/smart-contracts-24","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#owner-functions","content":"| Function               | Effect                         |\n| ---------------------- | ------------------------------ |\n| `withdraw(to, amount)` | Moves USDC out of the account. |","table":"table-1"},"133":{"id":"/how-it-works/smart-contracts-25","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#owner-functions","content":"| Function      | Effect                                                 |\n| ------------- | ------------------------------------------------------ |\n| `approve(id)` | Approves a pending, unexpired request. Moves no money. |","table":"table-1"},"134":{"id":"/how-it-works/smart-contracts-26","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#owner-functions","content":"| Function      | Effect                                                |\n| ------------- | ----------------------------------------------------- |\n| `decline(id)` | Declines a pending or approved-but-unsettled request. |","table":"table-1"},"135":{"id":"/how-it-works/smart-contracts-27","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#owner-functions","content":"| Function                   | Effect                                                                     |\n| -------------------------- | -------------------------------------------------------------------------- |\n| `propose_owner(new_owner)` | First step of an ownership transfer. The new owner calls `accept_owner()`. |","table":"table-1"},"136":{"id":"/how-it-works/smart-contracts-28","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#spender-functions","content":"| Function                                              | Auth    | Effect                                                                                                                                                                                                                           |\n| ----------------------------------------------------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `pay(spender, service, amount, memo, key) -> Receipt` | spender | Runs the checks below, transfers to the payee the registry returns, and emits a `pay` event. There is no recipient parameter. `key` is a 32-byte one-time key chosen by the caller, so a retried submission can never pay twice. |","table":"table-2"},"137":{"id":"/how-it-works/smart-contracts-29","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#spender-functions","content":"| Function                                                  | Auth    | Effect                                                                                                                                                                                                                   |\n| --------------------------------------------------------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `request_approval(spender, service, amount, memo) -> u64` | spender | Files a request for a payment that one of the exception-eligible rules refused. People only. Records the rule, how far over it was, and the payee the registry returns now. Nothing moves. Requests expire after 7 days. |","table":"table-2"},"138":{"id":"/how-it-works/smart-contracts-30","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#spender-functions","content":"| Function             | Auth                              | Effect                                                                                                                                                                                                                                                                                            |\n| -------------------- | --------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `settle(id, caller)` | owner or the spender who filed it | Pays an approved request. Refuses if the account is paused, the request is not approved or has expired, the service no longer resolves, **the payee changed since the request was filed** (`PayeeChanged`), or the balance is too low. Settled exceptions do not consume the spender's allowance. |","table":"table-2"},"139":{"id":"/how-it-works/smart-contracts-31","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Account paused → `AccountPaused`"},"140":{"id":"/how-it-works/smart-contracts-32","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Spender exists → `UnknownSpender`"},"141":{"id":"/how-it-works/smart-contracts-33","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Spender paused → `SpenderPaused`"},"142":{"id":"/how-it-works/smart-contracts-34","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Policy expired → `PolicyExpired`"},"143":{"id":"/how-it-works/smart-contracts-35","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Amount > 0 → `InvalidAmount`"},"144":{"id":"/how-it-works/smart-contracts-36","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Service on the spender's allowlist → `ServiceNotAllowed`"},"145":{"id":"/how-it-works/smart-contracts-37","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Replay key unused → `DuplicatePayment`"},"146":{"id":"/how-it-works/smart-contracts-38","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Per-payment cap (`max_payment`) → `OverPaymentCap`"},"147":{"id":"/how-it-works/smart-contracts-39","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Payments per period (`max_payments`) → `OverFrequency`"},"148":{"id":"/how-it-works/smart-contracts-40","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Allowance left this period → `OverAllowance`"},"149":{"id":"/how-it-works/smart-contracts-41","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Registry resolves the service → `UnknownService`, `ServiceSuspended` or `RegistryUnavailable`"},"150":{"id":"/how-it-works/smart-contracts-42","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Balance covers the amount → `InsufficientFunds`"},"151":{"id":"/how-it-works/smart-contracts-43","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Transfer, then the `pay` receipt event"},"152":{"id":"/how-it-works/smart-contracts-44","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#check-order-in-pay","content":"Rules 6, 8, 9 and 10 are **exception-eligible**: a person whose payment fails one of them can call `request_approval`. Agents get `AgentCannotRequest`."},"153":{"id":"/how-it-works/smart-contracts-45","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#dry-run","content":"`check(spender, service, amount) -> Verdict` runs the same rules without auth or state changes and returns `{ rule, over_by, allowance_left, period_spent, period_count }`. `rule` is `0` when the payment would go through, otherwise the error code that would refuse it. The app uses this to show the arithmetic before anything is signed."},"154":{"id":"/how-it-works/smart-contracts-46","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#views","content":"`version()`, `owner()`, `asset()`, `registry()`, `paused()`, `balance()`, `spenders()`, `policy(spender) -> Option<Policy>`, `usage(spender) -> Usage`, `request(id) -> Option<ApprovalRequest>`, `requests(from, limit)`, `is_key_used(spender, key)`."},"155":{"id":"/how-it-works/smart-contracts-47","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#events","content":"| Topics                  | Emitted by                                                  |\n| ----------------------- | ----------------------------------------------------------- |\n| `pay`, spender, service | `pay` (the receipt: payee, amount, memo, key, period_spent) |","table":"table-3"},"156":{"id":"/how-it-works/smart-contracts-48","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#events","content":"| Topics                 | Emitted by         |\n| ---------------------- | ------------------ |\n| `request`, `filed`, id | `request_approval` |","table":"table-3"},"157":{"id":"/how-it-works/smart-contracts-49","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#events","content":"| Topics                   | Emitted by           |\n| ------------------------ | -------------------- |\n| `request`, `decided`, id | `approve`, `decline` |","table":"table-3"},"158":{"id":"/how-it-works/smart-contracts-50","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#events","content":"| Topics                   | Emitted by |\n| ------------------------ | ---------- |\n| `request`, `settled`, id | `settle`   |","table":"table-3"},"159":{"id":"/how-it-works/smart-contracts-51","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#events","content":"| Topics                                          | Emitted by            |\n| ----------------------------------------------- | --------------------- |\n| `policy`, `set` / `paused` / `removed`, spender | owner spender changes |","table":"table-3"},"160":{"id":"/how-it-works/smart-contracts-52","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#events","content":"| Topics                           | Emitted by               |\n| -------------------------------- | ------------------------ |\n| `account`, `paused` / `withdraw` | `set_paused`, `withdraw` |","table":"table-3"},"161":{"id":"/how-it-works/smart-contracts-53","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#errors","content":"`AccountPaused` (1), `UnknownSpender` (2), `SpenderPaused` (3), `PolicyExpired` (4), `InvalidAmount` (5), `ServiceNotAllowed` (6), `DuplicatePayment` (7), `OverPaymentCap` (8), `OverFrequency` (9), `OverAllowance` (10), `UnknownService` (11), `ServiceSuspended` (12), `InsufficientFunds` (13), `InvalidPolicy` (14), `UnknownRequest` (15), `RequestNotPending` (16), `RequestNotApproved` (17), `RequestExpired` (18), `PayeeChanged` (19), `NotAuthorized` (20), `NoExceptionNeeded` (21), `NotEligibleForException` (22), `AgentCannotRequest` (23), `RegistryUnavailable` (24), `NoPendingOwner` (25)."},"162":{"id":"/how-it-works/smart-contracts-54","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#service-registry","content":"| Function               | Auth | Effect                   |\n| ---------------------- | ---- | ------------------------ |\n| `__constructor(owner)` |      | Sets the registry owner. |","table":"table-4"},"163":{"id":"/how-it-works/smart-contracts-55","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#service-registry","content":"| Function                    | Auth           | Effect                                                      |\n| --------------------------- | -------------- | ----------------------------------------------------------- |\n| `register(id, name, payee)` | registry owner | Adds a service. Ids are never reused (`AlreadyRegistered`). |","table":"table-4"},"164":{"id":"/how-it-works/smart-contracts-56","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#service-registry","content":"| Function                   | Auth          | Effect                                      |\n| -------------------------- | ------------- | ------------------------------------------- |\n| `set_payee(id, new_payee)` | current payee | Rotates the payout address for the service. |","table":"table-4"},"165":{"id":"/how-it-works/smart-contracts-57","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#service-registry","content":"| Function                       | Auth           | Effect                                                                  |\n| ------------------------------ | -------------- | ----------------------------------------------------------------------- |\n| `set_suspended(id, suspended)` | registry owner | Suspends or resumes a service. A suspended service resolves to nothing. |","table":"table-4"},"166":{"id":"/how-it-works/smart-contracts-58","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#service-registry","content":"| Function                 | Auth | Effect                                                                                              |\n| ------------------------ | ---- | --------------------------------------------------------------------------------------------------- |\n| `resolve(id) -> Address` | none | Returns the payee. Fails with `UnknownService` or `ServiceSuspended`; there is no fallback address. |","table":"table-4"},"167":{"id":"/how-it-works/smart-contracts-59","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#service-registry","content":"| Function                     | Auth | Effect                                    |\n| ---------------------------- | ---- | ----------------------------------------- |\n| `get(id) -> Option<Service>` | none | Returns `{ id, name, payee, suspended }`. |","table":"table-4"},"168":{"id":"/how-it-works/smart-contracts-60","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#service-registry","content":"| Function                 | Auth | Effect                   |\n| ------------------------ | ---- | ------------------------ |\n| `list() -> Vec<Service>` | none | All registered services. |","table":"table-4"},"169":{"id":"/how-it-works/smart-contracts-61","page_id":"/how-it-works/smart-contracts","tags":[],"type":"text","url":"/how-it-works/smart-contracts#service-registry","content":"| Function                                      | Auth              | Effect                       |\n| --------------------------------------------- | ----------------- | ---------------------------- |\n| `propose_owner(new_owner)` / `accept_owner()` | owner / new owner | Two-step ownership transfer. |","table":"table-4"},"170":{"id":"/how-it-works/smart-contracts-62","page_id