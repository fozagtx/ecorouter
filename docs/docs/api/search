 request |"],[206,"| Code | Name             | Title           |\n| ---- | ---------------- | --------------- |\n| 18   | `RequestExpired` | Request expired |"],[190,"| Code | Name             | Title         |\n| ---- | ---------------- | ------------- |\n| 2    | `UnknownSpender` | Not a spender |"],[197,"| Code | Name            | Title                         |\n| ---- | --------------- | ----------------------------- |\n| 9    | `OverFrequency` | Too many payments this period |"],[198,"| Code | Name            | Title              |\n| ---- | --------------- | ------------------ |\n| 10   | `OverAllowance` | Over the allowance |"],[189,"| Code | Name            | Title          |\n| ---- | --------------- | -------------- |\n| 1    | `AccountPaused` | Account paused |"],[202,"| Code | Name            | Title          |\n| ---- | --------------- | -------------- |\n| 14   | `InvalidPolicy` | Invalid policy |"],[191,"| Code | Name            | Title          |\n| ---- | --------------- | -------------- |\n| 3    | `SpenderPaused` | Spender paused |"],[192,"| Code | Name            | Title          |\n| ---- | --------------- | -------------- |\n| 4    | `PolicyExpired` | Policy expired |"],[193,"| Code | Name            | Title          |\n| ---- | --------------- | -------------- |\n| 5    | `InvalidAmount` | Invalid amount |"],[208,"| Code | Name            | Title       |\n| ---- | --------------- | ----------- |\n| 20   | `NotAuthorized` | Not allowed |"],[207,"| Code | Name           | Title         |\n| ---- | -------------- | ------------- |\n| 19   | `PayeeChanged` | Payee changed |"],[123,"| Contract           | Path                         | Purpose                                              |\n| ------------------ | ---------------------------- | ---------------------------------------------------- |\n| `service-registry` | `contracts/service-registry` | Resolves a service id to the address that gets paid. |"],[122,"| Contract       | Path                     | Purpose                                                                       |\n| -------------- | ------------------------ | ----------------------------------------------------------------------------- |\n| `team-account` | `contracts/team-account` | Holds the team's USDC, stores a policy per spender, runs the checks and pays. |"],[282,"| Deployment step         | Transaction                                                      |\n| ----------------------- | ---------------------------------------------------------------- |\n| Deploy service registry | b5030a721acb49e629e3b6e050efed3f28069d22bb2c66358bcd6f8ea09cc4be |"],[281,"| Deployment step         | Transaction                                                      |\n| ----------------------- | ---------------------------------------------------------------- |\n| Upload service registry | 1bcb8b1e37413caaffbdbd64d72ba2300e5ea9283b3887ad60c95484a557868a |"],[284,"| Deployment step     | Transaction                                                      |\n| ------------------- | ---------------------------------------------------------------- |\n| Deploy team account | 638322ab55104b9f5dd816c87515ffb704aaeadc376c9b6b50d377127474dd69 |"],[283,"| Deployment step     | Transaction                                                      |\n| ------------------- | ---------------------------------------------------------------- |\n| Upload team account | 9b01f1468fa41f27bc8afc6adf9a46130bdb13d66ed66174998931d8ea8fa3b4 |"],[285,"| Deployment step    | Transaction                                                      |\n| ------------------ | ---------------------------------------------------------------- |\n| Register inference | 50af1d1c1305e3da3effc6f326f83a9470859b5736d78ceb312f0fdfa8841b27 |"],[289,"| Deployment step  | Transaction                                                      |\n| ---------------- | ---------------------------------------------------------------- |\n| Register storage | 89e40117243