{
  "name": "ecorouter",
  "version": "0.1.0",
  "description": "Local capability routing and Stellar x402 orchestration for autonomous agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fozagtx/ecorouter.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://fozagtx.github.io/ecorouter",
  "bugs": {
    "url": "https://github.com/fozagtx/ecorouter/issues"
  },
  "license": "Apache-2.0"
}
