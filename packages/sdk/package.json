{
  "name": "ecorouter",
  "version": "0.3.0",
  "description": "Route each agent step to the cheapest provider that fits its spending cap",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.js",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {},
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fozagtx/ecorouter.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://fozagtx.github.io/ecorouter",
  "bugs": {
    "url": "https://github.com/fozagtx/ecorouter/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "ai-agents",
    "inference",
    "llm-router",
    "spending-caps",
    "airwallex"
  ],
  "bin": {
    "ecorouter": "./dist/cli.js"
  }
}
