{
  "name": "ecorouter",
  "version": "0.2.0",
  "description": "Pay from an EcoRouter team account on Stellar as an AI agent",
  "type": "module",
  "bin": {
    "ecorouter-agent": "./dist/worker.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.js",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fozagtx/ecorouter.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://fozagtx.github.io/ecorouter",
  "bugs": {
    "url": "https://github.com/fozagtx/ecorouter/issues"
  },
  "license": "Apache-2.0"
}
