---
import TechnicalViewport from "./TechnicalViewport.astro";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const input = "w-full h-10 bg-white border border-ink/60 rounded-[3px] px-3 text-xs font-mono text-ink focus:outline-none focus:border-ink";
const label = "block text-[10px] uppercase tracking-[0.16em] text-ink-muted font-medium mb-1.5";
---

<section id="simulator" class="bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="rails px-5 sm:px-10 py-16 md:py-24 space-y-10">
      <div class="max-w-3xl space-y-3">
        <div class="eyebrow">03 · Testbench</div>
        <h2 class="text-3xl sm:text-[40px] leading-[1.1] font-medium tracking-[-0.03em] text-ink">
          Watch it choose who gets paid
        </h2>
        <p class="text-base sm:text-[17px] text-ink-secondary leading-relaxed">
          Change two provider quotes and your policy. This runs the SDK's own selectProvider and USDC maths in your browser, so the winner here is the winner your agent would pay on Stellar.
        </p>
      </div>

      <TechnicalViewport topLeft="TESTBENCH · web.search" topRight="SDK · selectProvider()" bottomLeft="UNITS · 7 DECIMAL ATOMIC" bottomRight="NO FUNDS MOVE HERE">
        <div class="p-4 sm:p-6 space-y-5 font-mono">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {["a", "b"].map((id, i) => (
              <fieldset class="card p-3 sm:p-4 space-y-3">
                <legend class="px-1 text-[11px] text-ink font-medium">search-{id}</legend>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class={label} for={`sim-price-${id}`}>Quote (USDC)</label>
                    <input id={`sim-price-${id}`} class={input} type="text" inputmode="decimal" value={i === 0 ? "0.0012" : "0.0018"} />
                  </div>
                  <div>
                    <label class={label} for={`sim-quality-${id}`}>qualityScore</label>
                    <input id={`sim-quality-${id}`} class={input} type="number" min="0" max="1" step="0.01" value={i === 0 ? "0.82" : "0.93"} />
                  </div>
                </div>
              </fieldset>
            ))}
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-end">
            <div class="sm:col-span-4">
              <label class={label} for="sim-cap">maxSpendUsdc</label>
              <select id="sim-cap" class={input}>
                <option value="0.05">0.05 USDC</option>
                <option value="0.0015">0.0015 USDC (tight)</option>
                <option value="0.001">0.001 USDC (too tight)</option>
              </select>
            </div>
            <div class="sm:col-span-4">
              <label class={label} for="sim-minq">minimumQuality</label>
              <input id="sim-minq" class={input} type="number" min="0" max="1" step="0.01" value="0.8" />
            </div>
            <div class="sm:col-span-4">
              <button id="sim-run-btn" type="button" class="w-full h-10 px-4 rounded-[3px] bg-ink hover:bg-[#26272B] text-white text-xs font-medium flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                Run selection
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg>
              </button>
            </div>
          </div>

          <div class="card overflow-hidden text-xs">
            <div class="h-8 px-3 bg-surface-soft border-b-[1.5px] border-ink flex items-center justify-between text-[11px]">
              <span class="font-medium text-ink">OUTPUT</span>
              <span id="sim-status" class="text-ink-muted uppercase tracking-wider text-[10px] font-medium">Idle</span>
            </div>
            <div id="sim-console" class="bg-white p-4 min-h-[190px] max-h-[300px] overflow-y-auto space-y-1.5 text-ink-secondary leading-relaxed" data-lenis-prevent>
              <div class="text-ink-muted">// Set the quotes and press Run selection.</div>
            </div>
          </div>
        </div>
      </TechnicalViewport>
      <a href={`${basePath}/docs/playground/`} class="inline-flex items-center gap-2 text-[13px] font-mono font-medium text-ink border-b-[1.5px] border-ink pb-0.5 hover:text-accent hover:border-accent">Validate real x402 challenges in the docs playground <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<script>
  import { selectProvider } from "../../../sdk/src/router/select.ts";
  import { parseUsdc, formatUsdc } from "../../../sdk/src/money.ts";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const runBtn = $<HTMLButtonElement>("sim-run-btn");
  const consoleEl = $<HTMLDivElement>("sim-console");
  const statusEl = $<HTMLSpanElement>("sim-status");
  const delay = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]!));

  const setStatus = (text: string, cls: string) => {
    statusEl.textContent = text;
    statusEl.className = `uppercase tracking-wider text-[10px] font-semibold ${cls}`;
  };
  const line = (tag: string, cls: string, msg: string) => {
    const div = document.createElement("div");
    div.innerHTML = `<span class="${cls} font-semibold">${tag}</span> ${msg}`;
    consoleEl.appendChild(div);
    consoleEl.scrollTop = consoleEl.scrollHeight;
  };

  runBtn?.addEventListener("click", async () => {
    runBtn.disabled = true;
    consoleEl.innerHTML = "";
    setStatus("Running", "text-ink");

    try {
      const cap = parseUsdc(($<HTMLSelectElement>("sim-cap")).value);
      const minQ = Number(($<HTMLInputElement>("sim-minq")).value);
      const providers = ["a", "b"].map((id) => {
        const raw = $<HTMLInputElement>(`sim-price-${id}`).value.trim();
        const q = Number($<HTMLInputElement>(`sim-quality-${id}`).value);
        if (!(q > 0 && q <= 1)) throw new TypeError(`search-${id}: qualityScore must be between 0 and 1`);
        return { providerId: `search-${id}`, priceAtomic: parseUsdc(raw), qualityScore: q, successRate: 1 };
      });

      line("PROBE", "text-accent", `2 providers quoted for web.search: ${providers.map((p) => `${p.providerId} ${formatUsdc(p.priceAtomic)} USDC`).join(", ")}`);
      await delay(260);

      const eligible = providers.filter((p) => {
        if (p.qualityScore < minQ) {
          line("SKIP", "text-ink-muted", `${p.providerId} quality ${p.qualityScore} &lt; minimumQuality ${minQ}`);
          return false;
        }
        if (p.priceAtomic > cap) {
          line("SKIP", "text-ink-muted", `${p.providerId} ${formatUsdc(p.priceAtomic)} USDC &gt; maxSpendUsdc ${formatUsdc(cap)}`);
          return false;
        }
        line("PASS", "text-ok", `${p.providerId} within policy (${p.priceAtomic.toString()} atomic units)`);
        return true;
      });
      await delay(260);

      if (!eligible.length) {
        line("STOP", "text-destructive", "NO_ELIGIBLE_PROVIDER: nothing is paid, the agent keeps its budget");
        setStatus("Rejected before payment", "text-destructive");
        return;
      }

      const winner = selectProvider(eligible);
      eligible.forEach((p) => {
        const cost = Number(p.priceAtomic) / (p.qualityScore * p.successRate);
        line("SCORE", "text-ink", `${p.providerId} economicCost = ${p.priceAtomic} / (${p.qualityScore} × ${p.successRate}) = ${Math.round(cost).toLocaleString()}`);
      });
      await delay(300);
      line("SELECT", "text-accent", `${winner.providerId} wins at ${formatUsdc(winner.priceAtomic)} USDC`);
      await delay(260);
      line("SETTLE", "text-ok", `session key signs, Soroban __check_auth approves against the mandate, ${formatUsdc(winner.priceAtomic)} USDC moves on stellar:testnet`);
      setStatus(`Pays ${winner.providerId}`, "text-ok");
    } catch (err) {
      line("ERROR", "text-destructive", esc(err instanceof Error ? err.message : String(err)));
      setStatus("Invalid input", "text-destructive");
    } finally {
      runBtn.disabled = false;
    }
  });
</script>
