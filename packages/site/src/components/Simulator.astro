---
import ViewfinderFrame from "./ViewfinderFrame.astro";
---

<section id="simulator" class="py-16 md:py-24 relative bg-[#F1F1ED] border-t border-[#D9D9D4]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-8">
    <!-- Header -->
    <div class="space-y-2">
      <div class="text-[10.5px] font-mono uppercase tracking-[0.2em] text-[#85858B] font-medium">
        03 // INTERACTIVE CAPABILITY TESTBENCH
      </div>
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#0C0C0D]">
        Simulate capability execution.
      </h2>
      <p class="text-sm sm:text-base text-[#55555A] max-w-xl font-normal leading-relaxed">
        Test how EcoRouter challenges endpoints, enforces maxSpendUsdc caps, and selects providers.
      </p>
    </div>

    <!-- Simulator Shell wrapped in ViewfinderFrame -->
    <ViewfinderFrame
      frameId="FRAME · 002"
      liveTag="TESTBENCH // ACTIVE"
      scaleTag="RATE · EXACT"
      layerTag="LAYER · TESTBENCH"
      refTag="REF · SIM-02"
    >
      <div class="rounded-[4px] border border-[#D9D9D4] bg-white p-5 sm:p-6 space-y-6">
        <!-- Controls (40px height, 4px radius) -->
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-end">
          <div class="sm:col-span-5 space-y-1.5 font-mono">
            <label class="text-[11px] uppercase tracking-[0.16em] text-[#85858B]">Capability</label>
            <select id="sim-capability" class="w-full h-10 bg-white border border-[#D9D9D4] rounded-[4px] px-3 text-xs font-mono text-[#0C0C0D] focus:outline-none focus:border-[#0C0C0D] focus:ring-2 focus:ring-[#725CFF]/20">
              <option value="crawl">web-crawl (Extract Markdown)</option>
              <option value="sandbox">python-sandbox (Code Execution)</option>
              <option value="indexer">onchain-indexer (RPC Indexing)</option>
            </select>
          </div>

          <div class="sm:col-span-4 space-y-1.5 font-mono">
            <label class="text-[11px] uppercase tracking-[0.16em] text-[#85858B]">maxSpendUsdc</label>
            <select id="sim-cap" class="w-full h-10 bg-white border border-[#D9D9D4] rounded-[4px] px-3 text-xs font-mono text-[#0C0C0D] focus:outline-none focus:border-[#0C0C0D] focus:ring-2 focus:ring-[#725CFF]/20">
              <option value="0.005">$0.005 USDC (Standard)</option>
              <option value="0.010">$0.010 USDC (High Compute)</option>
              <option value="0.001">$0.001 USDC (Strict Budget)</option>
            </select>
          </div>

          <div class="sm:col-span-3">
            <button
              id="sim-run-btn"
              class="w-full h-10 px-4 rounded-[4px] bg-[#0C0C0D] hover:bg-[#252528] text-white font-mono text-xs font-medium active:scale-98 transition-colors flex items-center justify-center gap-2 cursor-pointer border border-[#0C0C0D]"
            >
              <span>Execute Probe</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </button>
          </div>
        </div>

        <!-- Live Terminal Console -->
        <div class="font-mono text-xs border border-[#D9D9D4] rounded-[4px] overflow-hidden">
          <div class="h-8 px-3 bg-[#F1F1ED] border-b border-[#D9D9D4] flex items-center justify-between text-[11px] text-[#55555A]">
            <span class="font-medium text-[#0C0C0D]">OUTPUT STREAM</span>
            <span id="sim-status" class="text-[#85858B] uppercase tracking-wider text-[10px]">IDLE</span>
          </div>

          <div id="sim-console" class="bg-[#141410] p-4 min-h-[180px] max-h-[280px] overflow-y-auto space-y-1.5 text-[#abab9c] leading-relaxed">
            <div class="text-white/40">// Select capability and click 'Execute Probe' to inspect runtime negotiation.</div>
          </div>
        </div>
      </div>
    </ViewfinderFrame>
  </div>
</section>

<script is:inline>
  const runBtn = document.getElementById("sim-run-btn");
  const capSelect = document.getElementById("sim-capability");
  const budgetSelect = document.getElementById("sim-cap");
  const consoleEl = document.getElementById("sim-console");
  const statusEl = document.getElementById("sim-status");

  const delay = (ms) => new Promise(res => setTimeout(res, ms));

  if (runBtn && consoleEl) {
    runBtn.addEventListener("click", async () => {
      runBtn.disabled = true;
      runBtn.classList.add("opacity-50", "cursor-not-allowed");
      statusEl.textContent = "RUNNING";
      statusEl.className = "text-[#0C0C0D] font-semibold text-[10px] uppercase";

      const cap = capSelect.value;
      const budget = budgetSelect.value;

      consoleEl.innerHTML = "";

      const append = (html) => {
        const div = document.createElement("div");
        div.innerHTML = html;
        consoleEl.appendChild(div);
        consoleEl.scrollTop = consoleEl.scrollHeight;
      };

      append(`<span class="text-white/40">[00ms]</span> <span class="text-purple-400">DISPATCH</span> request: ${cap} | maxSpend: $${budget}`);
      await delay(250);

      append(`<span class="text-white/40">[34ms]</span> <span class="text-amber-400">HTTP 402</span> challenged: node-alpha ($0.0008), node-beta ($0.0016)`);
      await delay(300);

      append(`<span class="text-white/40">[48ms]</span> <span class="text-blue-400">VALIDATE</span> fees &le; $${budget} policy cap ➔ <span class="text-emerald-400">OK</span>`);
      await delay(250);

      append(`<span class="text-white/40">[62ms]</span> <span class="text-purple-400">SELECT</span> node-alpha selected (score: 0.98, cost: $0.0008)`);
      await delay(350);

      append(`<span class="text-white/40">[98ms]</span> <span class="text-emerald-400 font-bold">SETTLED</span> 200 OK — 1,240 tokens returned (spent: $0.0008)`);

      statusEl.textContent = "COMPLETE (200 OK)";
      statusEl.className = "text-emerald-400 font-bold text-[10px] uppercase";

      runBtn.disabled = false;
      runBtn.classList.remove("opacity-50", "cursor-not-allowed");
    });
  }
</script>
