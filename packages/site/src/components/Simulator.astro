---
---

<section id="simulator" class="py-20 md:py-28 relative bg-[#fafaf7] border-t border-black/8">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-black/8 text-xs font-mono text-[#606056] mb-3 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#d25611]"></span>
        <span>Interactive Demo</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#0c0c09] mb-3">
        Test the x402 V2 Capability Engine.
      </h2>
      <p class="text-sm sm:text-base text-[#606056]">
        Select a capability and hop budget. Trigger an autonomous probe, verify the mandate, and watch EcoRouter settle payment and return execution data in real time.
      </p>
    </div>

    <!-- Simulator Shell -->
    <div class="rounded-2xl border border-black/8 bg-white shadow-xl p-4 sm:p-6 lg:p-8">
      <!-- Controls -->
      <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 pb-6 border-b border-black/8 items-end">
        <div class="sm:col-span-5 space-y-1.5">
          <label class="text-xs font-mono text-[#606056] uppercase tracking-wider">Select Capability</label>
          <select id="sim-capability" class="w-full bg-[#fafaf7] border border-black/10 rounded-lg px-3 py-2 text-xs font-mono text-[#0c0c09] focus:outline-none focus:border-[#d25611]">
            <option value="crawl">web-crawl (Deep Markdown Scraper)</option>
            <option value="sandbox">python-sandbox (Isolated Exec)</option>
            <option value="indexer">onchain-indexer (Base L2 RPC)</option>
          </select>
        </div>

        <div class="sm:col-span-4 space-y-1.5">
          <label class="text-xs font-mono text-[#606056] uppercase tracking-wider">Hop Cap (USDC)</label>
          <select id="sim-cap" class="w-full bg-[#fafaf7] border border-black/10 rounded-lg px-3 py-2 text-xs font-mono text-[#0c0c09] focus:outline-none focus:border-[#d25611]">
            <option value="0.005">$0.005 USDC (Standard)</option>
            <option value="0.010">$0.010 USDC (High Compute)</option>
            <option value="0.001">$0.001 USDC (Budget Low)</option>
          </select>
        </div>

        <div class="sm:col-span-3">
          <button
            id="sim-run-btn"
            class="w-full py-2 px-4 rounded-lg bg-[#d25611] hover:bg-[#e8804a] text-white font-mono text-xs font-semibold shadow-sm active:scale-95 transition-all flex items-center justify-center gap-2"
          >
            <span>Execute Probe</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </button>
        </div>
      </div>

      <!-- Live Terminal Output -->
      <div class="mt-6 font-mono text-xs">
        <div class="flex items-center justify-between pb-2 mb-3 text-black/50 text-[11px] border-b border-black/8">
          <span>CONSOLE OUTPUT</span>
          <span id="sim-status" class="text-emerald-600 font-medium">READY</span>
        </div>

        <div id="sim-console" class="bg-[#141410] rounded-xl p-4 border border-black/10 min-h-[220px] max-h-[340px] overflow-y-auto space-y-2 text-[#abab9c] leading-relaxed">
          <div class="text-white/40">// Select parameters and click 'Execute Probe' to initiate the machine-to-machine flow.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const runBtn = document.getElementById('sim-run-btn');
  const capSelect = document.getElementById('sim-capability');
  const budgetSelect = document.getElementById('sim-cap');
  const consoleEl = document.getElementById('sim-console');
  const statusEl = document.getElementById('sim-status');

  const delay = (ms) => new Promise(res => setTimeout(res, ms));

  if (runBtn && consoleEl) {
    runBtn.addEventListener('click', async () => {
      runBtn.disabled = true;
      runBtn.classList.add('opacity-50', 'cursor-not-allowed');
      statusEl.textContent = 'RUNNING';
      statusEl.className = 'text-[#d25611] animate-pulse font-semibold';

      const cap = capSelect.value;
      const budget = budgetSelect.value;

      consoleEl.innerHTML = '';

      const append = (html) => {
        const div = document.createElement('div');
        div.innerHTML = html;
        consoleEl.appendChild(div);
        consoleEl.scrollTop = consoleEl.scrollHeight;
      };

      append(`<span class="text-white/40">[00ms]</span> <span class="text-purple-400">DISPATCH</span> Requesting capability <strong>${cap}</strong> with max hop budget: <strong>$${budget}</strong>`);
      await delay(300);

      append(`<span class="text-white/40">[38ms]</span> <span class="text-amber-400">HTTP 402</span> Payment Required received from remote provider`);
      append(`&nbsp;&nbsp;&nbsp;&nbsp;↳ Invoice: <span class="text-white/80">0.0008 USDC</span> | Chain: <span class="text-white/80">Base L2</span> | Recipient: <span class="text-white/80">0x91b2...4f8c</span>`);
      await delay(400);

      append(`<span class="text-white/40">[52ms]</span> <span class="text-blue-400">MANDATE</span> Validating local cryptographic limits...`);
      append(`&nbsp;&nbsp;&nbsp;&nbsp;↳ Check: required $0.0008 &le; budget $${budget} ➔ <span class="text-emerald-400 font-bold">PASSED</span>`);
      await delay(350);

      append(`<span class="text-white/40">[69ms]</span> <span class="text-purple-400">ARBITRAGE</span> Evaluated 3 candidates. Node Alpha selected (latency: 34ms, score: 99.8)`);
      await delay(450);

      append(`<span class="text-white/40">[104ms]</span> <span class="text-emerald-400 font-bold">X402 SETTLED</span> Payment signature attached to retry request.`);
      append(`<span class="text-white/40">[122ms]</span> <span class="text-emerald-400 font-bold">HTTP 200 OK</span> Payload streamed successfully (elapsed: 122ms).`);

      await delay(200);
      let payloadJson = '';
      if (cap === 'crawl') {
        payloadJson = `{\n  "status": "success",\n  "title": "Autonomous Agent Protocols",\n  "tokens": 1240,\n  "markdown": "# Architecture\\n...scraped clean content...",\n  "costUSDC": "0.0008"\n}`;
      } else if (cap === 'sandbox') {
        payloadJson = `{\n  "status": "success",\n  "exitCode": 0,\n  "stdout": "Matrix dot product computed in 4.2ms: shape (512, 512)",\n  "costUSDC": "0.0008"\n}`;
      } else {
        payloadJson = `{\n  "status": "success",\n  "latestBlock": 21980455,\n  "transactionsParsed": 142,\n  "costUSDC": "0.0008"\n}`;
      }

      append(`<pre class="mt-2 p-3 bg-black/60 rounded border border-white/10 text-emerald-300 font-mono text-[11px] overflow-x-auto">${payloadJson}</pre>`);

      statusEl.textContent = 'COMPLETE (200 OK)';
      statusEl.className = 'text-emerald-600 font-bold';

      runBtn.disabled = false;
      runBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    });
  }
</script>
