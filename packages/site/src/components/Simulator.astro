---
import TechnicalViewport from "./TechnicalViewport.astro";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="simulator" class="py-16 md:py-28 relative overflow-hidden bg-[#05070E] border-t border-[#D2D2CE] text-white">
  <!-- Outside Background Image: stage-bg with Faded Transition Effect -->
  <div class="absolute inset-0 pointer-events-none select-none overflow-hidden z-0 flex items-center justify-center">
    <img
      src={`${basePath}/stage-bg.png`}
      alt="Simulator testbench stage backdrop"
      class="w-full h-full object-cover object-center opacity-90 scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#F6F6F3] via-transparent 25% to-[#F6F6F3]"></div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-8 relative z-10">
    <!-- Header -->
    <div class="space-y-2">
      <div class="text-[10.5px] font-mono uppercase tracking-[0.2em] text-[#93A4C8] font-medium">
        03 // INTERACTIVE CAPABILITY TESTBENCH
      </div>
      <h2 class="text-2xl sm:text-3xl font-medium tracking-[-0.035em] text-white">
        Simulate capability execution
      </h2>
      <p class="text-sm sm:text-base text-[#C4D2EC] max-w-xl font-normal leading-relaxed">
        Test how EcoRouter challenges endpoints, enforces maxSpendUsdc caps, and selects providers deterministically.
      </p>
    </div>

    <!-- Simulator Technical Viewport -->
    <TechnicalViewport
      netTag="TESTBENCH · SIMULATOR"
      versionTag="PROTOCOL · X402 V2"
      systemTag="SYSTEM · READY"
      scaleTag="RATE · EXACT"
      layerTag="LAYER · TESTBENCH"
      refTag="REF · SIM-02"
    >
      <div class="bg-white p-5 sm:p-6 space-y-6 text-[#0B0B0C] shadow-2xl">
        <!-- Controls (40px height, 3px radius) -->
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-end">
          <div class="sm:col-span-5 space-y-1.5 font-mono">
            <label class="text-[10.5px] uppercase tracking-[0.18em] text-[#7D7D84]">Capability</label>
            <select id="sim-capability" class="w-full h-10 bg-white border border-[#D2D2CE] rounded-[3px] px-3 text-xs font-mono text-[#0B0B0C] focus:outline-none focus:border-[#0B0B0C]">
              <option value="crawl">web-crawl (Extract Markdown)</option>
              <option value="sandbox">python-sandbox (Code Execution)</option>
              <option value="indexer">onchain-indexer (RPC Indexing)</option>
            </select>
          </div>

          <div class="sm:col-span-4 space-y-1.5 font-mono">
            <label class="text-[10.5px] uppercase tracking-[0.18em] text-[#7D7D84]">maxSpendUsdc</label>
            <select id="sim-cap" class="w-full h-10 bg-white border border-[#D2D2CE] rounded-[3px] px-3 text-xs font-mono text-[#0B0B0C] focus:outline-none focus:border-[#0B0B0C]">
              <option value="0.005">$0.005 USDC (Standard)</option>
              <option value="0.010">$0.010 USDC (High Compute)</option>
              <option value="0.001">$0.001 USDC (Strict Budget)</option>
            </select>
          </div>

          <div class="sm:col-span-3">
            <button
              id="sim-run-btn"
              class="w-full h-10 px-4 rounded-[3px] bg-[#0B0B0C] hover:bg-[#252528] text-white font-mono text-xs font-medium active:scale-98 transition-colors flex items-center justify-center gap-2 cursor-pointer border border-[#0B0B0C]"
            >
              <span>Execute Probe</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </button>
          </div>
        </div>

        <!-- Live Terminal Console -->
        <div class="font-mono text-xs border border-[#DADAD6] rounded-none overflow-hidden">
          <div class="h-8 px-3 bg-[#FAFAF8] border-b border-[#DADAD6] flex items-center justify-between text-[11px] text-[#55555A]">
            <span class="font-medium text-[#0B0B0C]">OUTPUT STREAM</span>
            <span id="sim-status" class="text-[#7D7D84] uppercase tracking-wider text-[10px]">IDLE</span>
          </div>

          <div id="sim-console" class="bg-[#141410] p-4 min-h-[180px] max-h-[280px] overflow-y-auto space-y-1.5 text-[#abab9c] leading-relaxed">
            <div class="text-white/40">// Select capability and click 'Execute Probe' to inspect runtime negotiation.</div>
          </div>
        </div>
      </div>
    </TechnicalViewport>
  </div>
</section>

<script is:inline>
  const runBtn = document.getElementById("sim-run-btn");
  const capSelect = document.getElementById("sim-capability");
  const budgetSelect = document.getElementById("sim-cap");
  const consoleEl = document.getElementById("sim-console");
  const statusEl = document.getElementById("sim-status");

  const delay = (ms) => new Promise(res => setTimeout(res, ms));

  if (runBtn && consoleEl) {
    runBtn.addEventListener("click", async () => {
      runBtn.disabled = true;
      runBtn.classList.add("opacity-50", "cursor-not-allowed");
      statusEl.textContent = "RUNNING";
      statusEl.className = "text-[#0B0B0C] font-semibold text-[10px] uppercase";

      const cap = capSelect.value;
      const budget = budgetSelect.value;

      consoleEl.innerHTML = "";

      const append = (html) => {
        const div = document.createElement("div");
        div.innerHTML = html;
        consoleEl.appendChild(div);
        consoleEl.scrollTop = consoleEl.scrollHeight;
      };

      append(`<span class="text-white/40">[00ms]</span> <span class="text-purple-400">DISPATCH</span> request: ${cap} | maxSpend: $${budget}`);
      await delay(250);

      append(`<span class="text-white/40">[34ms]</span> <span class="text-amber-400">HTTP 402</span> challenged: node-alpha ($0.0008), node-beta ($0.0016)`);
      await delay(300);

      append(`<span class="text-white/40">[48ms]</span> <span class="text-blue-400">VALIDATE</span> fees &le; $${budget} policy cap ➔ <span class="text-emerald-400">OK</span>`);
      await delay(250);

      append(`<span class="text-white/40">[62ms]</span> <span class="text-purple-400">SELECT</span> node-alpha selected (score: 0.98, cost: $0.0008)`);
      await delay(350);

      append(`<span class="text-white/40">[98ms]</span> <span class="text-emerald-400 font-bold">SETTLED</span> 200 OK — 1,240 tokens returned (spent: $0.0008)`);

      statusEl.textContent = "COMPLETE (200 OK)";
      statusEl.className = "text-emerald-400 font-bold text-[10px] uppercase";

      runBtn.disabled = false;
      runBtn.classList.remove("opacity-50", "cursor-not-allowed");
    });
  }
</script>
