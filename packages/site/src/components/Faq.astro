---
const faqs = [
  {
    q: "What is EcoRouter?",
    a: "EcoRouter is an open-source TypeScript SDK that handles capability discovery, provider arbitrage, and x402 payment settlement directly in your application process."
  },
  {
    q: "How does provider selection work?",
    a: "When you call execute(), EcoRouter queries all registered providers for that capability in parallel, checks their 402 challenge terms against your spending policy, and selects the optimal provider based on price and quality."
  },
  {
    q: "Is there a centralized server or proxy?",
    a: "No. EcoRouter runs locally inside your agent runtime. Your credentials, policies, and requests never pass through third-party servers."
  },
  {
    q: "How does it prevent overspending?",
    a: "Every execution accepts a maxSpendUsdc policy. If all providers quote above your maximum limit, EcoRouter aborts the call with a NoEligibleProviderError before making any payment."
  }
];
---

<section id="faq" class="py-16 md:py-20 relative bg-[#fafaf7] border-t border-black/8">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="mb-10 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#0c0c09]">
        FAQ
      </h2>
    </div>

    <div class="space-y-3">
      {faqs.map((item) => (
        <details class="group rounded-xl border border-black/8 bg-white overflow-hidden transition-colors hover:border-black/20 shadow-2xs">
          <summary class="p-4 sm:p-5 flex items-center justify-between cursor-pointer list-none select-none text-sm font-medium text-[#0c0c09] group-open:text-[#d25611]">
            <span>{item.q}</span>
            <span class="w-5 h-5 rounded-full bg-black/5 flex items-center justify-center text-xs font-mono text-[#606056] group-hover:text-[#0c0c09] group-open:rotate-45 transition-transform duration-200 shrink-0">
              ＋
            </span>
          </summary>
          <div class="px-4 pb-5 sm:px-5 sm:pb-5 text-xs text-[#606056] leading-relaxed border-t border-black/5 pt-3">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
