---
import AsciiGrid from "./AsciiGrid.astro";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const spenders = [
  { name: "Sam", kind: "Person", spent: 340, allowance: 900, cap: 250, note: "6 of 20 payments" },
  { name: "Research agent", kind: "AI agent", spent: 1020, allowance: 1200, cap: 120, note: "tops up inference credits" },
  { name: "Data feed agent", kind: "AI agent", spent: 80, allowance: 150, cap: 5, note: "$5 every day · market-data" },
];
const usd = (n: number) => `$${n.toLocaleString("en-US")}`;
const activity = [
  { who: "Data feed agent", svc: "market-data", amt: "$5.00", state: "Settled" },
  { who: "Research agent", svc: "inference-credits", amt: "$120.00", state: "Settled" },
  { who: "Sam", svc: "gpu-rental", amt: "$320.00", state: "Held" },
];
---

<section class="bg-white" aria-label="Product preview">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="rails px-0 sm:px-4 pb-16 md:pb-24">
      <div class="relative overflow-hidden rounded-[6px] card">
        <img
          src={`${basePath}/sky-stage.jpg`}
          alt=""
          class="absolute inset-0 w-full h-full object-cover object-top select-none pointer-events-none"
          loading="eager"
        />
        <AsciiGrid rows={64} class="text-accent/50" />
        <div class="relative px-3 py-10 sm:px-10 sm:py-16 md:px-16 md:py-20">
          <div class="mx-auto max-w-[940px] bg-white/95 backdrop-blur card shadow-float rounded-[4px] overflow-hidden">
            <!-- window bar -->
            <div class="min-h-10 px-4 py-2.5 border-b border-line flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
              <div class="flex items-center gap-2 min-w-0">
                <span class="w-1.5 h-1.5 bg-accent shrink-0"></span>
                <span class="font-medium text-ink truncate">Team account · Overview</span>
              </div>
              <span class="inline-flex w-fit items-center gap-1.5 px-1.5 py-0.5 text-[10px] uppercase tracking-wider text-ok bg-ok/10 border border-ok/25">
                <span class="w-1 h-1 rounded-full bg-ok"></span>
                Active · stellar:testnet
              </span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] divide-y lg:divide-y-0 lg:divide-x divide-line">
              <!-- account card -->
              <div class="p-4 sm:p-6 space-y-5 min-w-0">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="eyebrow !text-[10px]">Owner</div>
                    <div class="mt-1 flex items-center gap-2">
                      <span class="w-6 h-6 rounded-full bg-ink text-white text-[11px] font-mono flex items-center justify-center shrink-0">A</span>
                      <span class="text-[15px] font-semibold text-ink">Ada</span>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="eyebrow !text-[10px]">Balance</div>
                    <div class="mt-1 font-mono text-[15px] font-semibold text-ink">3,560.00 <span class="text-ink-muted text-[11px] font-medium">USDC</span></div>
                  </div>
                </div>

                <div>
                  <div class="flex items-baseline justify-between gap-2 mb-2">
                    <span class="text-sm text-ink-secondary">Spent this month</span>
                    <span class="font-mono text-sm text-ink"><span class="font-semibold">$1,440</span> <span class="text-ink-muted">of $2,000</span></span>
                  </div>
                  <div class="h-2.5 bg-surface-muted border border-line overflow-hidden">
                    <div class="h-full bg-ink" style="width: 72%"></div>
                  </div>
                  <div class="mt-1.5 flex justify-between font-mono text-[10px] uppercase tracking-wider text-ink-muted">
                    <span>3 spenders</span><span>resets Nov 1</span>
                  </div>
                </div>

                <!-- held payment -->
                <div class="border-[1.5px] border-warn bg-warn-soft p-3.5 space-y-2.5">
                  <div class="flex items-center justify-between gap-2">
                    <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider text-warn font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-warn"></span>
                      Held for approval
                    </span>
                    <span class="font-mono text-[13px] font-semibold text-ink">$320.00</span>
                  </div>
                  <div class="text-[13px] text-ink leading-snug">Sam → <span class="font-mono text-[12px]">gpu-rental</span></div>
                  <div class="font-mono text-[11px] text-ink-secondary leading-relaxed">
                    rule: per-payment cap $250 · over by <span class="text-warn font-semibold">$70</span>
                  </div>
                  <div class="flex gap-2 pt-0.5">
                    <span class="inline-flex items-center h-7 px-2.5 text-[11px] font-mono font-medium bg-ink text-white">Approve</span>
                    <span class="inline-flex items-center h-7 px-2.5 text-[11px] font-mono font-medium bg-white text-ink border border-ink">Decline</span>
                  </div>
                </div>
              </div>

              <!-- spenders -->
              <div class="p-4 sm:p-6 space-y-4 min-w-0">
                <div class="flex items-center justify-between">
                  <span class="eyebrow !text-[10px]">Spenders</span>
                  <span class="font-mono text-[10px] uppercase tracking-wider text-ink-muted">allowance / month</span>
                </div>
                <ul class="space-y-3">
                  {spenders.map((s) => {
                    const pct = Math.round((s.spent / s.allowance) * 100);
                    return (
                      <li class="border border-line-strong bg-white p-3 space-y-2">
                        <div class="flex items-center justify-between gap-3">
                          <div class="flex items-center gap-2 min-w-0">
                            <span class={`w-6 h-6 shrink-0 flex items-center justify-center text-[10px] font-mono ${s.kind === "Person" ? "rounded-full bg-surface-muted text-ink border border-line-strong" : "rounded-[3px] bg-accent text-white"}`}>
                              {s.kind === "Person" ? s.name[0] : "AI"}
                            </span>
                            <span class="text-[14px] font-medium text-ink truncate">{s.name}</span>
                            <span class={`hidden sm:inline font-mono text-[9px] uppercase tracking-wider px-1.5 py-0.5 border ${s.kind === "Person" ? "text-ink-secondary border-line bg-surface-soft" : "text-accent border-accent/30 bg-accent-soft"}`}>{s.kind}</span>
                          </div>
                          <span class="font-mono text-[12px] text-ink shrink-0"><span class="font-semibold">{usd(s.spent)}</span><span class="text-ink-muted"> / {usd(s.allowance)}</span></span>
                        </div>
                        <div class="h-1.5 bg-surface-muted overflow-hidden">
                          <div class={`h-full ${s.kind === "Person" ? "bg-ink" : "bg-accent"}`} style={`width: ${pct}%`}></div>
                        </div>
                        <div class="flex justify-between gap-2 font-mono text-[10.5px] text-ink-muted">
                          <span class="truncate">{s.note}</span>
                          <span class="shrink-0">cap {usd(s.cap)}</span>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </div>

            <!-- activity -->
            <div class="border-t border-line bg-surface-soft px-4 sm:px-6 py-3 font-mono text-[11px]">
              <div class="eyebrow !text-[10px] mb-2">Recent receipts</div>
              <ul class="divide-y divide-line">
                {activity.map((a) => (
                  <li class="py-1.5 flex items-center justify-between gap-3">
                    <span class="min-w-0 truncate text-ink-secondary"><span class="text-ink">{a.who}</span> → {a.svc}</span>
                    <span class="flex items-center gap-3 shrink-0">
                      <span class="text-ink">{a.amt}</span>
                      <span class={`w-[64px] text-right uppercase tracking-wider text-[10px] font-semibold ${a.state === "Held" ? "text-warn" : "text-ok"}`}>{a.state}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
