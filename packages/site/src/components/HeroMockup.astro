---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

// Illustrative run. Prices and latencies are example quotes, not live data.
const agents = [
  { name: "Research agent", spent: 31.4, cap: 50, note: "per day · max $0.40 per step" },
  { name: "Support agent", spent: 8.2, cap: 20, note: "per day · max $0.05 per step" },
  { name: "Lead-gen agent", spent: 46.9, cap: 60, note: "per day · max $0.25 per step" },
];
const steps = [
  { n: "01", step: "Plan the task", kind: "reasoning", provider: "Anthropic", logo: "anthropic.svg", price: "$0.0210", ms: "1.9s", state: "Routed" },
  { n: "02", step: "Find sources", kind: "search", provider: "Exa", logo: "exa.png", price: "$0.0050", ms: "0.6s", state: "Routed" },
  { n: "03", step: "Read 8 pages", kind: "scrape", provider: "Firecrawl", logo: "firecrawl.png", price: "$0.0080", ms: "3.1s", state: "Routed" },
  { n: "04", step: "Company context", kind: "context", provider: "context.dev", logo: "context.png", price: "$0.0040", ms: "0.4s", state: "Routed" },
  { n: "05", step: "Draft summary", kind: "reasoning", provider: "Groq", logo: "groq.png", price: "$0.0012", ms: "0.3s", state: "Rerouted" },
];
const usd = (n: number) => `$${n.toFixed(2)}`;
---

<section class="bg-white" aria-label="Product preview">
  <div class="max-w-[1180px] mx-auto px-5 relative z-10 mt-0 md:-mt-40 pb-24 md:pb-32">
      <div class="outer-technical-frame p-3 sm:p-6 md:p-8">
          <div class="mx-auto max-w-[940px] bg-white card shadow-float overflow-hidden">
            <div class="min-h-10 px-4 py-3 border-b border-line flex flex-wrap items-center justify-between gap-2 text-[13px]">
              <div class="flex items-center gap-2 min-w-0">
                <span class="w-2 h-2 rounded-full bg-accent shrink-0"></span>
                <span class="font-medium text-ink truncate">Router · run #4182 · "Brief me on Acme's pricing"</span>
              </div>
              <span class="inline-flex w-fit items-center gap-1.5 px-3 py-1 rounded-full text-[12px] text-ink-secondary bg-surface-muted">
                Example run
              </span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] divide-y lg:divide-y-0 lg:divide-x divide-line">
              <div class="min-w-0">
                <div class="px-4 sm:px-6 pt-4 pb-2 flex items-center justify-between">
                  <span class="eyebrow">Steps and where they went</span>
                  <span class="text-[12px] text-ink-muted">price · latency</span>
                </div>
                <ul class="divide-y divide-line">
                  {steps.map((s) => (
                    <li class={`px-4 sm:px-6 py-3 flex items-center gap-3 ${s.state === "Rerouted" ? "bg-warn-soft" : ""}`}>
                      <span class="text-[12px] text-ink-muted w-5 shrink-0">{s.n}</span>
                      <span class="flex-1 min-w-0">
                        <span class="block text-[13px] text-ink truncate">{s.step}</span>
                        <span class="flex items-center gap-1.5 text-[12px] text-ink-secondary">
                          <img src={`${basePath}/logos/${s.logo}`} alt="" class="w-3.5 h-3.5 object-contain" />
                          {s.provider} <span class="text-ink-muted">· {s.kind}</span>
                        </span>
                      </span>
                      <span class="text-right shrink-0 font-sans tabular-nums text-[12px]">
                        <span class="block text-ink">{s.price}</span>
                        <span class="block text-ink-muted">{s.ms}</span>
                      </span>
                      <span class={`w-[64px] text-right text-[11px] font-medium shrink-0 ${s.state === "Rerouted" ? "text-warn" : "text-ok"}`}>{s.state}</span>
                    </li>
                  ))}
                </ul>
                <div class="px-4 sm:px-6 py-3 border-t border-line text-[12px] text-ink-secondary leading-relaxed">
                  This run has a <span class="tabular-nums text-ink">$0.05</span> cap. Step 05 was quoted on Anthropic at <span class="tabular-nums text-ink">$0.0190</span> with <span class="tabular-nums text-ink">$0.0120</span> left, so the router moved it to the next provider that met the 2s latency target.
                </div>
              </div>

              <div class="p-4 sm:p-6 space-y-4 min-w-0">
                <div class="flex items-center justify-between">
                  <span class="eyebrow">Spending caps</span>
                  <span class="text-[12px] text-ink-muted">resets 00:00 UTC</span>
                </div>
                <ul class="space-y-3">
                  {agents.map((a) => {
                    const pct = Math.round((a.spent / a.cap) * 100);
                    return (
                      <li class="border border-line rounded-xl bg-white p-3 space-y-2">
                        <div class="flex items-center justify-between gap-3">
                          <span class="flex items-center gap-2 min-w-0">
                            <span class="w-6 h-6 shrink-0 flex items-center justify-center text-[10px] rounded-full bg-accent text-white">AI</span>
                            <span class="text-[14px] font-medium text-ink truncate">{a.name}</span>
                          </span>
                          <span class="font-sans tabular-nums text-[12px] text-ink shrink-0"><span class="font-semibold">{usd(a.spent)}</span><span class="text-ink-muted"> / {usd(a.cap)}</span></span>
                        </div>
                        <div class="h-1.5 bg-surface-muted rounded-full overflow-hidden">
                          <div class={`h-full rounded-full ${pct > 75 ? "bg-warn" : "bg-accent"}`} style={`width: ${pct}%`}></div>
                        </div>
                        <div class="text-[12px] text-ink-muted truncate">{a.note}</div>
                      </li>
                    );
                  })}
                </ul>
                <div class="rounded-xl bg-surface-muted p-3 text-[12px] text-ink-secondary leading-relaxed flex items-start gap-2">
                  <img src={`${basePath}/logos/airwallex.png`} alt="" class="w-4 h-4 mt-0.5 shrink-0" />
                  <span>Funding wallet and per-provider virtual cards on Airwallex. Integration in progress.</span>
                </div>
              </div>
            </div>
          </div>
      </div>
  </div>
</section>
