---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const stages = [
  { n: "01 / PROBE", tag: "402", title: "Ask for prices", body: "Calls every provider for the capability at once and reads their x402 payment challenge.", rows: [["search-a", "0.0012"], ["search-b", "0.0018"]] },
  { n: "02 / VALIDATE", tag: "PASS", title: "Check the mandate", body: "Network, asset, per-payment cap and your policy limit are checked before money moves.", rows: [["maxSpend", "≤ 0.05"], ["eligible", "2 / 2"]] },
  { n: "03 / SCORE", tag: "BEST", title: "Pick the best value", body: "Price divided by quality and success rate. Same inputs, same winner, every time.", rows: [["winner", "search-a"], ["cost", "14,634"]] },
  { n: "04 / SETTLE", tag: "USDC", title: "Pay on Stellar", body: "The session key signs, the Soroban account approves, and the paid result comes back.", rows: [["network", "stellar:testnet"], ["asset", "USDC"]] },
];
---

<section id="how" class="bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="rails px-0 sm:px-4 pb-16 md:pb-24">
      <div class="relative overflow-hidden rounded-[6px] border border-line">
        <img
          src={`${basePath}/sky-stage.jpg`}
          alt=""
          class="absolute inset-0 w-full h-full object-cover object-top select-none pointer-events-none"
          loading="eager"
        />
        <div class="relative px-3 py-10 sm:px-10 sm:py-16 md:px-16 md:py-20">
          <div class="mx-auto max-w-[920px] bg-white/95 backdrop-blur border border-line shadow-float rounded-[4px] overflow-hidden font-mono">
            <div class="min-h-10 px-4 py-2.5 border-b border-line flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
              <div class="flex flex-wrap items-center gap-2">
                <span class="w-1.5 h-1.5 bg-accent"></span>
                <span class="font-medium text-ink">router.execute(&#123; capability: "web.search" &#125;)</span>
              </div>
              <span class="inline-flex w-fit items-center gap-1.5 px-1.5 py-0.5 text-[10px] uppercase tracking-wider text-ok bg-ok/10 border border-ok/25">
                <span class="w-1 h-1 rounded-full bg-ok"></span>
                Within mandate
              </span>
            </div>

            <div class="px-4 py-5 sm:px-6 border-b border-line bg-surface-soft">
              <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-3">
                <div class="provider-node is-winner"><span>search-a</span><strong>0.0012 USDC</strong></div>
                <div class="provider-node animate-float-delay-1"><span>search-b</span><strong>0.0018 USDC</strong></div>
                <div class="provider-node animate-float-delay-2"><span>mandate left</span><strong>3.80 USDC</strong></div>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 lg:divide-x divide-line text-xs">
              {stages.map((s, i) => (
                <div class={`p-4 space-y-2 ${i % 2 === 1 ? 'sm:border-l lg:border-l-0 border-line' : ''} ${i >= 2 ? 'sm:border-t lg:border-t-0 border-line' : ''}`}>
                  <div class="flex items-center justify-between text-[10px] uppercase tracking-[0.14em] text-ink-muted">
                    <span>{s.n}</span>
                    <span class={`font-semibold ${s.tag === 'PASS' ? 'text-ok' : 'text-ink'}`}>{s.tag}</span>
                  </div>
                  <div class="text-ink font-semibold text-[13px] font-sans">{s.title}</div>
                  <p class="text-[12px] text-ink-secondary leading-normal font-sans">{s.body}</p>
                  <div class="bg-surface-soft p-2 border border-line text-[11px] space-y-1">
                    {s.rows.map(([k, v]) => (
                      <div class="flex justify-between gap-2"><span class="text-ink-muted">{k}</span><span class="text-ink font-medium truncate">{v}</span></div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
