---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const primitives = [
  { k: "PARALLEL", title: "Ask every provider at once", body: "Each provider for a capability gets an x402 probe in parallel. Slow or broken ones time out after five seconds and drop out." },
  { k: "POLICY", title: "A hard limit on every call", body: "Each execute() carries maxSpendUsdc and minimumQuality. Quotes above the limit never reach the payment step." },
  { k: "LOCAL", title: "Runs inside your agent", body: "No hosted proxy or registry. Keys stay in your process, and an executionId makes retries safe." },
];
const code = `import { EcoRouter } from "ecorouter";

const router = new EcoRouter({
  account: process.env.ECOROUTER_ACCOUNT!,
  sessionSecret: process.env.ECOROUTER_SESSION_SECRET!,
  paymentClient, // your local Stellar x402 client
  providers: [
    { id: "search-a", capability: "web.search", endpoint: process.env.SEARCH_A_URL!, qualityScore: 0.82 },
    { id: "search-b", capability: "web.search", endpoint: process.env.SEARCH_B_URL!, qualityScore: 0.93 }
  ]
});

const result = await router.execute({
  capability: "web.search",
  input: { query: "latest lithium carbonate prices" },
  policy: { maxSpendUsdc: "0.05", minimumQuality: 0.8 }
});

console.log(result.decision.providerId, result.payment.transactionHash, result.mandate.remainingUsdc);`;
---

<section id="features" class="bg-surface-soft border-y border-line">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="rails px-5 sm:px-10 py-16 md:py-24 space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="eyebrow">02 · The runtime</div>
        <h2 class="text-3xl sm:text-[40px] leading-[1.1] font-medium tracking-[-0.03em] text-ink">
          Ask for a capability, not a vendor
        </h2>
        <p class="text-base sm:text-[17px] text-ink-secondary leading-relaxed">
          Your agent says it needs web.search. EcoRouter finds who sells it, compares live prices, pays the best one in USDC on Stellar and hands back the same result shape every time.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {primitives.map((p, i) => (
          <div class="bg-white card p-6 space-y-3 shadow-subtle">
            <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.16em] text-ink-muted">
              <span>Primitive 0{i + 1}</span>
              <span class="text-ink px-1.5 py-0.5 bg-surface-soft border border-line">{p.k}</span>
            </div>
            <h3 class="text-[17px] font-semibold text-ink tracking-tight">{p.title}</h3>
            <p class="text-sm text-ink-secondary leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>

      <div id="quickstart" class="bg-white card shadow-card overflow-hidden font-mono">
        <div class="h-10 px-4 bg-surface-soft border-b-[1.5px] border-ink flex items-center justify-between text-xs">
          <div class="flex items-center gap-2 min-w-0">
            <span class="eyebrow !text-[10px] hidden sm:inline">Quickstart</span>
            <span class="text-ink-muted hidden sm:inline">/</span>
            <span class="font-medium text-ink truncate">search-agent.ts</span>
          </div>
          <button
            type="button"
            data-copy={code}
            class="h-7 px-2.5 rounded-[3px] bg-white border border-ink hover:bg-surface-muted text-ink text-[11px] flex items-center gap-1.5 cursor-pointer"
          >
            Copy
            <svg class="w-3 h-3 text-ink-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
          </button>
        </div>
        <pre class="p-4 sm:p-6 text-[12px] sm:text-[12.5px] leading-relaxed text-ink-secondary overflow-x-auto"><code><span class="text-accent">import</span> &#123; EcoRouter &#125; <span class="text-accent">from</span> <span class="text-ok">"ecorouter"</span>;

<span class="text-accent">const</span> <span class="text-ink">router</span> = <span class="text-accent">new</span> <span class="text-ink font-medium">EcoRouter</span>(&#123;
  account: process.env.<span class="text-ink">ECOROUTER_ACCOUNT</span>!,
  sessionSecret: process.env.<span class="text-ink">ECOROUTER_SESSION_SECRET</span>!,
  paymentClient, <span class="text-ink-muted">// your local Stellar x402 client</span>
  providers: [
    &#123; id: <span class="text-ok">"search-a"</span>, capability: <span class="text-ok">"web.search"</span>, endpoint: process.env.<span class="text-ink">SEARCH_A_URL</span>!, qualityScore: <span class="text-ink">0.82</span> &#125;,
    &#123; id: <span class="text-ok">"search-b"</span>, capability: <span class="text-ok">"web.search"</span>, endpoint: process.env.<span class="text-ink">SEARCH_B_URL</span>!, qualityScore: <span class="text-ink">0.93</span> &#125;
  ]
&#125;);

<span class="text-accent">const</span> <span class="text-ink">result</span> = <span class="text-accent">await</span> router.<span class="text-ink font-medium">execute</span>(&#123;
  capability: <span class="text-ok">"web.search"</span>,
  input: &#123; query: <span class="text-ok">"latest lithium carbonate prices"</span> &#125;,
  policy: &#123; maxSpendUsdc: <span class="text-ok">"0.05"</span>, minimumQuality: <span class="text-ink">0.8</span> &#125;
&#125;);

console.<span class="text-ink font-medium">log</span>(result.decision.providerId, result.payment.transactionHash, result.mandate.remainingUsdc);</code></pre>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 -mt-4">
        <a href={`${basePath}/docs/quickstart/`} class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-[3px] text-[13px] font-mono font-medium bg-ink hover:bg-[#26272B] text-white border-[1.5px] border-ink">Full quickstart <span aria-hidden="true">→</span></a>
        <a href={`${basePath}/docs/api/ecorouter/`} class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-[3px] text-[13px] font-mono font-medium bg-white hover:bg-surface-muted text-ink border-[1.5px] border-ink">API reference <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
