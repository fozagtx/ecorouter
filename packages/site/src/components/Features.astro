---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section id="features" class="py-16 md:py-24 relative overflow-hidden">
  <div id="capabilities" class="absolute -top-16 pointer-events-none" aria-hidden="true"></div>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-16 relative z-10">
    <!-- Section Header -->
    <div class="space-y-2">
      <div class="text-[10px] sm:text-[10.5px] font-mono uppercase tracking-[0.2em] text-[#5D5D64] font-medium">
        01 // CORE SYSTEM ARCHITECTURE
      </div>
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#0B0B0C]">
        Deterministic capability routing primitives
      </h2>
      <p class="text-sm sm:text-base text-[#3D3D42] max-w-2xl font-normal leading-relaxed">
        Autonomous agents need to purchase external compute, web searches, and indexing without exposing infinite credit lines or hardcoded secrets.
      </p>
    </div>

    <!-- 3 Core Technical Primitives under Curves Canopy Backdrop -->
    <div class="relative rounded-[2px] bg-[#05070E] border border-white/10 p-5 sm:p-8 md:p-10 overflow-hidden shadow-xl">
      <!-- Outside Backdrop: curves-bg.png with Faded Vignette -->
      <div class="absolute inset-0 pointer-events-none select-none overflow-hidden z-0">
        <img
          src={`${basePath}/curves-bg.png`}
          alt="Glowing curved routing canopy"
          class="w-full h-full object-cover object-top opacity-90 scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#05070E] via-transparent to-[#05070E]/30"></div>
      </div>

      <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- 1 -->
        <div class="p-5 sm:p-6 rounded-[1px] border border-white/20 bg-white/95 text-[#0B0B0C] shadow-lg backdrop-blur-sm space-y-3">
          <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-[0.2em] text-[#65656C]">
            <span>PRIMITIVE 01</span>
            <span class="font-semibold text-[#0B0B0C] px-1.5 py-0.5 bg-[#F1F1EE] border border-[#D2D2CE]">PARALLEL</span>
          </div>
          <h3 class="text-sm font-semibold text-[#0B0B0C]">HTTP 402 Probing</h3>
          <p class="text-xs text-[#3D3D42] leading-relaxed">
            Queries registered capability endpoints simultaneously for live 402 payment requirements, verifying fees before dispatching funds.
          </p>
        </div>

        <!-- 2 -->
        <div class="p-5 sm:p-6 rounded-[1px] border border-white/20 bg-white/95 text-[#0B0B0C] shadow-lg backdrop-blur-sm space-y-3">
          <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-[0.2em] text-[#65656C]">
            <span>PRIMITIVE 02</span>
            <span class="font-semibold text-[#0B0B0C] px-1.5 py-0.5 bg-[#F1F1EE] border border-[#D2D2CE]">POLICY</span>
          </div>
          <h3 class="text-sm font-semibold text-[#0B0B0C]">Deterministic Spend Caps</h3>
          <p class="text-xs text-[#3D3D42] leading-relaxed">
            Enforces an explicit <code class="text-[#0B0B0C] font-mono bg-[#F1F1EE] px-1 py-0.5 rounded-[2px] border border-[#D2D2CE]">maxSpendUsdc</code> policy per execution. Providers quoting above the limit are rejected.
          </p>
        </div>

        <!-- 3 -->
        <div class="p-5 sm:p-6 rounded-[1px] border border-white/20 bg-white/95 text-[#0B0B0C] shadow-lg backdrop-blur-sm space-y-3">
          <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-[0.2em] text-[#65656C]">
            <span>PRIMITIVE 03</span>
            <span class="font-semibold text-[#0B0B0C] px-1.5 py-0.5 bg-[#F1F1EE] border border-[#D2D2CE]">LOCAL</span>
          </div>
          <h3 class="text-sm font-semibold text-[#0B0B0C]">In-Process &amp; Idempotent</h3>
          <p class="text-xs text-[#3D3D42] leading-relaxed">
            Runs directly in your application. Uses an optional <code class="text-[#0B0B0C] font-mono bg-[#F1F1EE] px-1 py-0.5 rounded-[2px] border border-[#D2D2CE]">executionId</code> for safe deterministic retries.
          </p>
        </div>
      </div>
    </div>

    <!-- Quickstart Code Section with Stage Backdrop Outside -->
    <div class="relative rounded-[2px] bg-[#05070E] border border-white/10 p-5 sm:p-8 overflow-hidden shadow-xl">
      <!-- Outside Backdrop: stage-bg.png with Faded Vignette -->
      <div class="absolute inset-0 pointer-events-none select-none overflow-hidden z-0">
        <img
          src={`${basePath}/stage-bg.png`}
          alt="Code terminal stage"
          class="w-full h-full object-cover object-center opacity-85 scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#05070E] via-transparent to-[#05070E]/70"></div>
      </div>

      <div id="quickstart" class="relative z-10 rounded-[4px] border border-[#D2D2CE] bg-white overflow-hidden font-mono shadow-2xl">
        <div class="h-9 px-4 bg-[#EFEFEC] border-b border-[#D2D2CE] flex items-center justify-between text-xs">
          <div class="flex items-center gap-2">
            <span class="text-[10.5px] uppercase tracking-[0.16em] text-[#7D7D84]">02 // QUICKSTART</span>
            <span class="text-[#7D7D84]">|</span>
            <span class="font-medium text-[#0B0B0C]">example.ts</span>
          </div>
          <button
            onclick="copyText(`import { EcoRouter } from 'ecorouter';\n\nconst router = new EcoRouter({\n  account: process.env.STELLAR_ACCOUNT,\n  sessionSecret: process.env.SESSION_SECRET,\n  providers: [\n    { id: 'tavily', capability: 'web-search', endpoint: 'https://api.tavily.com/x402', qualityScore: 0.95 },\n    { id: 'brave', capability: 'web-search', endpoint: 'https://api.brave.com/x402', qualityScore: 0.90 }\n  ]\n});\n\nconst result = await router.execute({\n  capability: 'web-search',\n  input: { query: 'latest open source agents' },\n  policy: { maxSpendUsdc: '0.01', minimumQuality: 0.85 }\n});\n\nconsole.log(result.providerId, result.spentUsdc);`)"
            class="h-6 px-2 rounded-[3px] bg-white border border-[#D2D2CE] hover:bg-[#EFEFEC] text-[#0B0B0C] text-[11px] flex items-center gap-1.5 transition-colors cursor-pointer"
          >
            <span>Copy</span>
            <svg class="w-3 h-3 text-[#7D7D84]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
          </button>
        </div>

        <div class="p-4 sm:p-5 bg-[#141410] text-[#abab9c] text-xs leading-relaxed overflow-x-auto">
          <pre><code><span class="text-purple-400">import</span> &#123; EcoRouter &#125; <span class="text-purple-400">from</span> <span class="text-emerald-300">"ecorouter"</span>;

<span class="text-white/40">// 1. Initialize router with smart account and candidate providers</span>
<span class="text-purple-400">const</span> router = <span class="text-purple-400">new</span> <span class="text-amber-300">EcoRouter</span>(&#123;
  account: process.env.<span class="text-[#fbfbf9]">STELLAR_ACCOUNT</span>,
  sessionSecret: process.env.<span class="text-[#fbfbf9]">SESSION_SECRET</span>,
  providers: [
    &#123; id: <span class="text-emerald-300">"tavily"</span>, capability: <span class="text-emerald-300">"web-search"</span>, endpoint: <span class="text-emerald-300">"https://api.tavily.com/x402"</span>, qualityScore: <span class="text-amber-300">0.95</span> &#125;,
    &#123; id: <span class="text-emerald-300">"brave"</span>, capability: <span class="text-emerald-300">"web-search"</span>, endpoint: <span class="text-emerald-300">"https://api.brave.com/x402"</span>, qualityScore: <span class="text-amber-300">0.90</span> &#125;
  ]
&#125;);

<span class="text-white/40">// 2. Execute capability under hard spending bounds</span>
<span class="text-purple-400">const</span> result = <span class="text-purple-400">await</span> router.<span class="text-blue-400">execute</span>(&#123;
  capability: <span class="text-emerald-300">"web-search"</span>,
  input: &#123; query: <span class="text-emerald-300">"latest autonomous agent runtime specifications"</span> &#125;,
  policy: &#123; maxSpendUsdc: <span class="text-amber-300">"0.01"</span>, minimumQuality: <span class="text-amber-300">0.85</span> &#125;
&#125;);

console.<span class="text-blue-400">log</span>(result.providerId, result.spentUsdc, result.data);</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>
