---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const kinds = [
  { k: "Reasoning", title: "Model calls", body: "Planning, drafting and tool use. Routed by token price, context size and measured time to first token.", logos: ["anthropic.svg", "openai.svg", "groq.png", "mistralai.svg", "deepseek.png", "googlegemini.svg"] },
  { k: "Search", title: "Web search", body: "Neural and keyword search for sources. Routed by price per query and how fast results come back.", logos: ["exa.png", "tavily.png", "perplexity.svg"] },
  { k: "Scrape", title: "Crawl and extract", body: "Turn URLs into clean text or structured fields. Routed by price per page and success rate on recent calls.", logos: ["firecrawl.png", "context.png"] },
  { k: "Context", title: "Company and brand data", body: "Logos, descriptions and firmographics for a domain. Routed by price per lookup and freshness.", logos: ["context.png"] },
  { k: "Open models", title: "Hosted open weights", body: "Llama, Qwen and DeepSeek served by several hosts at different prices. The same model, the cheapest host that is up.", logos: ["together.png", "fireworks.png", "openrouter.png", "huggingface.svg"] },
  { k: "Rerank", title: "Rerank and embed", body: "Score and filter what search returned before it reaches a model. Cheap steps that make the expensive ones smaller.", logos: ["cohere.png", "openai.svg"] },
];
---

<section id="resources" class="bg-surface-soft border-y border-line">
  <div class="max-w-[1180px] mx-auto px-5 py-24 md:py-32 space-y-12">
      <div class="max-w-3xl space-y-3">
        <div class="eyebrow">02 · Resources</div>
        <h2 class="text-[40px] sm:text-[48px] leading-[1.05] font-semibold tracking-[-0.04em] text-ink">
          Not just models. Every paid tool an agent touches.
        </h2>
        <p class="text-[17px] sm:text-[18px] text-ink-secondary leading-relaxed max-w-[640px]">
          An agent run is a chain of paid calls: a model plans, a search API finds pages, a scraper reads them, a context API fills in the company. EcoRouter prices and caps all of them in one place, so one budget covers the whole run.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {kinds.map((p) => (
          <div class="card p-5 space-y-3 min-w-0 flex flex-col">
            <div>
              <span class="text-[12px] text-ink-secondary px-3 py-1 rounded-full bg-surface-muted">{p.k}</span>
            </div>
            <h3 class="text-[16px] font-semibold text-ink tracking-[-0.02em] leading-snug">{p.title}</h3>
            <p class="text-sm text-ink-secondary leading-relaxed">{p.body}</p>
            <div class="mt-auto pt-2 flex items-center gap-2">
              {p.logos.map((l) => <img src={`${basePath}/logos/${l}`} alt="" class="w-5 h-5 object-contain" loading="lazy" />)}
            </div>
          </div>
        ))}
      </div>
  </div>
</section>
