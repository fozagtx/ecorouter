---
interface Props {
  topLeft?: string;
  topRight?: string;
  bottomLeft?: string;
  bottomCenter?: string;
  bottomRight?: string;
  class?: string;
}

const {
  topLeft = "NETWORK · STELLAR TESTNET",
  topRight = "SOROBAN · ACCOUNT",
  bottomLeft = "ASSET · USDC",
  bottomCenter = "",
  bottomRight = "x402 · V2 EXACT",
  class: className = "",
} = Astro.props;
---

<div class={`w-full ${className}`}>
  <div class="flex items-center justify-between gap-4 eyebrow !text-[10px] sm:!text-[11px] mb-2.5 px-1">
    <span class="flex items-center gap-1.5 text-ink">
      <span class="w-1.5 h-1.5 bg-accent"></span>
      {topLeft}
    </span>
    <span>{topRight}</span>
  </div>

  <div class="outer-technical-frame p-3 sm:p-6 md:p-8">
    <div class="capture-corner tl"></div>
    <div class="capture-corner tr"></div>
    <div class="capture-corner bl"></div>
    <div class="capture-corner br"></div>
    <div class="relative z-10 bg-white card shadow-card overflow-hidden">
      <slot />
    </div>
  </div>

  <div class="flex items-center justify-between eyebrow !text-[10px] sm:!text-[11px] mt-2.5 px-1">
    <span>{bottomLeft}</span>
    {bottomCenter && <span class="hidden sm:inline">{bottomCenter}</span>}
    <span>{bottomRight}</span>
  </div>
</div>
