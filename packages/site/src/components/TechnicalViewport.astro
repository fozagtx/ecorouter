---
interface Props {
  netTag?: string;
  versionTag?: string;
  systemTag?: string;
  scaleTag?: string;
  layerTag?: string;
  refTag?: string;
  class?: string;
}

const {
  netTag = "NETWORK · ECOROUTER",
  versionTag = "VERSION · 0.1.0",
  systemTag = "SYSTEM · ACTIVE",
  scaleTag = "SCALE · 1:1",
  layerTag = "LAYER · EXECUTION",
  refTag = "REF · ECO-01",
  class: className = ""
} = Astro.props;
---

<div class={`technical-viewport-container w-full max-w-[1040px] mx-auto select-none ${className}`}>
  <!-- Metadata ABOVE outer frame -->
  <div class="flex items-end justify-between text-[10.5px] font-mono uppercase tracking-[0.2em] text-[#7D7D84] mb-3 px-1 pointer-events-none">
    <div class="space-y-0.5">
      <div class="flex items-center gap-1.5 font-medium text-[#0B0B0C]">
        <span class="w-1.5 h-1.5 bg-[#725CFF] rounded-[0.5px]"></span>
        <span>{netTag}</span>
      </div>
      <div class="text-[10px] text-[#7D7D84]">{versionTag}</div>
    </div>
    <div class="flex items-center gap-1.5 text-[#55555A]">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>{systemTag}</span>
    </div>
  </div>

  <!-- Outer Observation Frame -->
  <div class="outer-technical-frame relative border border-[#D0D0CC] rounded-[1px] bg-[#FAFAF8] p-5 sm:p-10 md:p-11 transition-colors duration-200">
    <!-- Four Inset L-shaped Camera Registration Brackets in Gutter -->
    <div class="capture-corner tl"></div>
    <div class="capture-corner tr"></div>
    <div class="capture-corner bl"></div>
    <div class="capture-corner br"></div>

    <!-- Inner Product Viewport -->
    <div class="inner-product-viewport relative z-10 bg-white border border-[#DADAD6] rounded-none overflow-hidden">
      <slot />
    </div>
  </div>

  <!-- Metadata BELOW outer frame -->
  <div class="flex items-center justify-between text-[10.5px] font-mono uppercase tracking-[0.2em] text-[#7D7D84] mt-3 px-1 pointer-events-none">
    <span>{scaleTag}</span>
    <span class="hidden sm:inline text-[#A9A9A4]">{layerTag}</span>
    <span>{refTag}</span>
  </div>
</div>
