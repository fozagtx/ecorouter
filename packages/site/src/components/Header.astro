---
import Logo from './Logo.astro';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="sticky top-0 z-50 w-full h-14 bg-white/90 backdrop-blur-md border-b border-black/8 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-full flex items-center justify-between gap-4">
    <!-- Left: Brand Logo & Pill -->
    <div class="flex items-center gap-3">
      <a href={`${basePath}/`} class="flex items-center gap-2.5 group">
        <div class="w-7 h-7 rounded-inner bg-[#d25611] flex items-center justify-center text-white shadow-sm shadow-[#d25611]/25 group-hover:scale-105 transition-transform">
          <Logo class="w-4 h-4 text-white" />
        </div>
        <span class="font-bold text-base tracking-tight text-[#0c0c09] group-hover:text-black transition-colors">EcoRouter</span>
      </a>
      <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-mono font-medium bg-[#f4f4f0] text-[#606056] border border-black/8">
        v0.9.4
      </span>
    </div>

    <!-- Center: Desktop Nav -->
    <nav class="hidden md:flex items-center gap-6 text-sm text-[#606056]">
      <a href="#capabilities" class="hover:text-[#0c0c09] transition-colors">Capabilities</a>
      <a href="#architecture" class="hover:text-[#0c0c09] transition-colors">Architecture</a>
      <a href="#x402-protocol" class="hover:text-[#0c0c09] transition-colors">x402 V2 Protocol</a>
      <a href="#simulator" class="hover:text-[#0c0c09] transition-colors">Simulator</a>
      <a href="#faq" class="hover:text-[#0c0c09] transition-colors">FAQ</a>
    </nav>

    <!-- Right: Actions & Links -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href="https://github.com/fozagtx/ecorouter"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono bg-[#f4f4f0] hover:bg-[#eaeae5] text-[#0c0c09] border border-black/8 transition-all"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>

      <button
        onclick="copyText('pnpm add ecorouter')"
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-[#0c0c09] text-white hover:bg-[#20201a] active:scale-95 transition-all shadow-sm"
        title="Copy install command"
      >
        <span>$ pnpm add ecorouter</span>
        <svg class="w-3 h-3 text-white/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
