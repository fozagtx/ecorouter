---
import Logo from "./Logo.astro";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  { href: "#app", label: "Product" },
  { href: "#router", label: "Router" },
  { href: "#airwallex", label: "Airwallex" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="relative z-30 w-full px-5 sm:px-8 pt-5">
  <div class="max-w-[1120px] mx-auto h-12 flex items-center justify-between gap-4">
    <a href={`${basePath}/`} class="flex items-center gap-2 shrink-0">
      <Logo class="w-6 h-6 text-ink" />
      <span class="font-display font-semibold text-[18px] tracking-[-0.03em] text-ink">EcoRouter</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="hidden md:flex items-center gap-1 text-[15px] text-ink-secondary">
        {links.map((l) => <a href={l.href} class="px-3 py-2 rounded-lg hover:text-ink">{l.label}</a>)}
      </nav>
      <a href="https://github.com/fozagtx/ecorouter" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex px-3 py-2 text-[15px] text-ink-secondary hover:text-ink">GitHub</a>
      <a href="#router" class="inline-flex items-center h-9 px-4 rounded-full bg-ink text-white text-[14px] font-semibold hover:bg-accent">Try the router</a>
    </div>
  </div>
</header>
