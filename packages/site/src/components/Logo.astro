---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = "w-4 h-4", size = 24 } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Layer 1: Top 'e' curved plane -->
  <path d="M16 4C9.5 4 5 8.2 5 13.5h19.5c-.2-4.8-4.5-9.5-8.5-9.5z" fill="currentColor" />
  <path d="M16 7.2c2.6 0 4.4 2 4.7 4.5h-9.4c.3-2.5 2.1-4.5 4.7-4.5z" fill="#d25611" />

  <!-- Layer 2: Middle Routing Shelf (Crossbar) -->
  <path d="M4 14.5C4 13.7 4.7 13 5.5 13h21c.8 0 1.5.7 1.5 1.5s-.7 1.5-1.5 1.5h-21c-.8 0-1.5-.7-1.5-1.5z" fill="currentColor" />
  <path d="M5.5 16h21v1.2H5.5z" fill="currentColor" opacity="0.35" />

  <!-- Layer 3: Bottom Foundation Plane (lower loop of 'e') -->
  <path d="M5 18c.3 5.2 4.8 9 11.5 9 4.8 0 8.5-2 10.2-5.2l-3.2-1.8c-1.2 2-3.8 3.5-7 3.5-4.5 0-7.4-2.5-7.8-5.5H5z" fill="currentColor" />
  <path d="M16 27c3.8 0 7-1.3 8.7-3.5l1 1C23.8 27.2 20.2 29 16 29c-7.2 0-12-4.2-12.3-9.8H5c.3 4.8 4.7 7.8 11 7.8z" fill="currentColor" opacity="0.25" />
</svg>
