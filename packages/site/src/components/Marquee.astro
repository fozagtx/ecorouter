---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const items = [
  { name: "OpenAI", type: "Models", logo: "openai.svg" },
  { name: "Anthropic", type: "Models", logo: "anthropic.svg" },
  { name: "Firecrawl", type: "Scrape", logo: "firecrawl.png" },
  { name: "context.dev", type: "Context", logo: "context.png" },
  { name: "Exa", type: "Search", logo: "exa.png" },
  { name: "Tavily", type: "Search", logo: "tavily.png" },
  { name: "Groq", type: "Fast inference", logo: "groq.png" },
  { name: "OpenRouter", type: "Models", logo: "openrouter.png" },
  { name: "Together AI", type: "Open models", logo: "together.png" },
  { name: "Fireworks AI", type: "Open models", logo: "fireworks.png" },
  { name: "Mistral AI", type: "Models", logo: "mistralai.svg" },
  { name: "Google Gemini", type: "Models", logo: "googlegemini.svg" },
  { name: "DeepSeek", type: "Models", logo: "deepseek.png" },
  { name: "Cohere", type: "Rerank", logo: "cohere.png" },
  { name: "Perplexity", type: "Answers", logo: "perplexity.svg" },
  { name: "Replicate", type: "Media", logo: "replicate.svg" },
  { name: "Hugging Face", type: "Endpoints", logo: "huggingface.svg" },
  { name: "Ollama", type: "Local", logo: "ollama.svg" },
];
---

<section class="bg-[#FCFCF9] overflow-hidden relative">
  <div class="max-w-[1180px] mx-auto px-5 pt-8">
    <span class="eyebrow">Providers on the routing table</span>
  </div>
  <div class="relative w-full overflow-hidden flex items-center py-5">
    <div class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-[#FCFCF9] to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-[#FCFCF9] to-transparent z-10 pointer-events-none"></div>
    <div class="animate-marquee flex items-center gap-9 px-5">
      {items.concat(items).map((item) => (
        <div class="flex items-center gap-2.5 text-[14px] text-ink-secondary shrink-0 group">
          <img src={`${basePath}/logos/${item.logo}`} alt="" class="w-5 h-5 object-contain grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition" loading="lazy" />
          <span class="font-medium">{item.name}</span>
          <span class="text-[12px] text-ink-muted">{item.type}</span>
        </div>
      ))}
    </div>
  </div>
</section>
