---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

const integrations = [
  { name: "Model Context Protocol", type: "Standard", logo: "mcp.svg" },
  { name: "OpenAI Swarm", type: "Framework", logo: "openai.svg" },
  { name: "LangGraph", type: "Orchestrator", logo: "langchain.svg" },
  { name: "CrewAI", type: "Multi-Agent", logo: "crewai.svg" },
  { name: "ElizaOS", type: "Autonomous", logo: "elizaos.svg" },
  { name: "Base AgentKit", type: "On-Chain", logo: "base.svg" },
  { name: "Solana Agent SDK", type: "On-Chain", logo: "solana.svg" },
  { name: "Stellar Soroban", type: "Settlement", logo: "stellar.svg" },
  { name: "Firecrawl", type: "Capability", logo: "firecrawl.svg" },
  { name: "Tavily Search", type: "Capability", logo: "tavily.svg" },
  { name: "E2B Sandboxes", type: "Runtime", logo: "e2b.svg" },
];
---

<section class="py-8 border-y border-[#D2D2CE] bg-[#EFEFEC] overflow-hidden relative font-mono">
  <div class="max-w-6xl mx-auto px-4 mb-3 text-center">
    <span class="text-[10.5px] uppercase tracking-[0.2em] text-[#7D7D84] font-medium">
      COMPATIBLE WITH HTTP 402 PROVIDERS &amp; AGENT RUNTIMES
    </span>
  </div>

  <div class="relative w-full overflow-hidden flex items-center">
    <!-- Fade Gradients -->
    <div class="absolute left-0 top-0 bottom-0 w-16 bg-gradient-to-r from-[#EFEFEC] to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-[#EFEFEC] to-transparent z-10 pointer-events-none"></div>

    <div class="animate-marquee flex items-center gap-3 py-1">
      {integrations.concat(integrations).map((item) => (
        <div class="flex items-center gap-2.5 px-3.5 py-2 rounded-[4px] bg-white border border-[#D2D2CE] text-xs text-[#0B0B0C] shrink-0 hover:border-[#0B0B0C] transition-all cursor-default">
          <div class="w-4 h-4 shrink-0 flex items-center justify-center">
            <img
              src={`${basePath}/logos/${item.logo}`}
              alt={`${item.name} logo`}
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <span class="font-medium font-sans">{item.name}</span>
          <span class="text-[10px] font-mono text-[#7D7D84] uppercase bg-[#EFEFEC] px-1.5 py-0.5 rounded-[2px] border border-[#D2D2CE]">{item.type}</span>
        </div>
      ))}
    </div>
  </div>
</section>
