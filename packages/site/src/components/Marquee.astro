---
const integrations = [
  { name: "Model Context Protocol (MCP)", type: "Standard" },
  { name: "OpenAI Swarm", type: "Framework" },
  { name: "LangGraph", type: "Orchestrator" },
  { name: "CrewAI", type: "Multi-Agent" },
  { name: "ElizaOS", type: "Autonomous" },
  { name: "Base AgentKit", type: "On-Chain" },
  { name: "Solana Agent SDK", type: "On-Chain" },
  { name: "Firecrawl", type: "Capability" },
  { name: "Tavily Search", type: "Capability" },
  { name: "E2B Sandboxes", type: "Runtime" },
];
---

<section class="py-8 border-y border-[#D8D8D3] bg-[#F1F1EE] overflow-hidden relative font-mono">
  <div class="max-w-6xl mx-auto px-4 mb-3 text-center">
    <span class="text-[10.5px] uppercase tracking-[0.16em] text-[#888883] font-medium">
      COMPATIBLE WITH HTTP 402 PROVIDERS &amp; AGENT RUNTIMES
    </span>
  </div>

  <div class="relative w-full overflow-hidden flex items-center">
    <!-- Fade Gradients -->
    <div class="absolute left-0 top-0 bottom-0 w-16 bg-gradient-to-r from-[#F1F1EE] to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-[#F1F1EE] to-transparent z-10 pointer-events-none"></div>

    <div class="animate-marquee flex items-center gap-3 py-1">
      {integrations.concat(integrations).map((item) => (
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-[3px] bg-white border border-[#D8D8D3] text-xs text-[#111111] shrink-0 hover:border-[#B8B8B2] transition-colors cursor-default">
          <span class="w-1.5 h-1.5 rounded-[1px] bg-[#111111]"></span>
          <span class="font-medium">{item.name}</span>
          <span class="text-[10px] text-[#888883] uppercase bg-[#F1F1EE] px-1 py-0.5 rounded-[2px] border border-[#D8D8D3]/60">{item.type}</span>
        </div>
      ))}
    </div>
  </div>
</section>
