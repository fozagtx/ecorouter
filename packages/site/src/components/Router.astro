---
const kinds = [
  { id: "reasoning", label: "Reasoning" },
  { id: "search", label: "Search" },
  { id: "scrape", label: "Scrape" },
  { id: "context", label: "Context" },
];
const breaks = [
  { id: "price", label: "Price ×3" },
  { id: "slow", label: "Latency ×5" },
  { id: "down", label: "Offline" },
];
---

<section id="router" class="bg-paper pb-28 sm:pb-36">
  <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
    <div class="rule-label"><span>Route a step</span><span class="rule"></span></div>

    <div class="mt-10 border-t border-ink grid grid-cols-1 lg:grid-cols-2">
      <!-- controls -->
      <div class="pt-8 lg:pr-10 lg:border-r border-line-strong space-y-9">
        <div>
          <div class="flex items-baseline justify-between gap-4">
            <span class="text-[15px] text-ink-secondary">Step</span>
            <span id="rt-kind-label" class="font-display text-[24px] tracking-[-0.02em] text-ink">Reasoning</span>
          </div>
          <div class="mt-3 grid grid-cols-4 gap-1.5" role="radiogroup" aria-label="Step kind">
            {kinds.map((k, i) => <button type="button" class="rt-kind chip-tab !h-9 !normal-case !text-[12.5px]" data-kind={k.id} aria-selected={i === 0 ? "true" : "false"}>{k.label}</button>)}
          </div>
        </div>

        <div>
          <div class="flex items-baseline justify-between gap-4">
            <label for="rt-left" class="text-[15px] text-ink-secondary">Budget left on the run</label>
            <span id="rt-left-label" class="font-display text-[24px] tabular-nums tracking-[-0.02em] text-ink">$0.0500</span>
          </div>
          <input id="rt-left" class="slider mt-3" type="range" min="1" max="50" step="1" value="50" />
          <div class="flex justify-between font-mono text-[11px] text-ink-muted"><span>$0.001</span><span>$0.0125</span><span>$0.025</span><span>$0.0375</span><span>$0.05</span></div>
        </div>

        <div>
          <div class="flex items-baseline justify-between gap-4">
            <label for="rt-lat" class="text-[15px] text-ink-secondary">Latency target</label>
            <span id="rt-lat-label" class="font-display text-[24px] tabular-nums tracking-[-0.02em] text-ink">2.0s</span>
          </div>
          <input id="rt-lat" class="slider mt-3" type="range" min="2" max="50" step="1" value="20" />
          <div class="flex justify-between font-mono text-[11px] text-ink-muted"><span>0.2s</span><span>1.4s</span><span>2.6s</span><span>3.8s</span><span>5.0s</span></div>
        </div>

        <div class="space-y-3">
          <label id="rt-frontier-wrap" class="flex items-center justify-between gap-4 cursor-pointer select-none">
            <span class="text-[15px] text-ink-secondary">Needs a frontier model</span>
            <input id="rt-frontier" type="checkbox" class="accent-ink w-4 h-4" checked />
          </label>
          <div class="flex items-center justify-between gap-4">
            <span class="text-[15px] text-ink-secondary">Break the current pick</span>
            <div class="flex gap-1.5">
              {breaks.map((b) => <button type="button" class="rt-break chip-tab !normal-case !text-[12px]" data-break={b.id} aria-selected="false">{b.label}</button>)}
            </div>
          </div>
        </div>

        <div class="pt-8 border-t border-line-strong grid grid-cols-2 gap-6 pb-8">
          <div>
            <div class="text-[14px] text-ink-secondary">Routed to</div>
            <div id="rt-pick" class="mt-1 font-display text-[34px] sm:text-[40px] leading-tight tracking-[-0.03em] text-ink truncate">Gemini</div>
            <div id="rt-why" class="mt-1 text-[13px] text-accent min-h-[20px]"></div>
          </div>
          <div>
            <div class="text-[14px] text-ink-secondary">Cost · left after</div>
            <div id="rt-cost" class="mt-1 font-display text-[34px] sm:text-[40px] leading-tight tabular-nums tracking-[-0.03em] text-ink">$0.0060</div>
            <div id="rt-after" class="mt-1 text-[13px] text-ink-muted tabular-nums"></div>
          </div>
        </div>
      </div>

      <!-- quote table -->
      <div class="pt-8 lg:pl-10">
        <div id="rt-title" class="font-display text-[18px] font-medium tracking-[-0.02em] text-ink">Quotes for a reasoning step</div>
        <div class="mt-6 flex justify-between text-[13px] text-ink-muted pb-3 border-b border-line-strong">
          <span>Provider</span><span>Price · latency</span>
        </div>
        <ul id="rt-quotes" class="divide-y divide-line-strong border-b border-line-strong" aria-live="polite"></ul>
        <p class="mt-5 text-[13px] leading-relaxed text-ink-muted">
          Keep providers that are online, allowed, under the budget left and under the latency target. Take the cheapest; ties go to the faster one. If none are left, stop before calling anyone. Example quotes, not live prices.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  type Kind = "reasoning" | "search" | "scrape" | "context";
  interface Quote { id: string; name: string; sub: string; price: number; secs: number; frontier?: boolean }

  // Example quotes per step. Not live prices.
  const QUOTES: Record<Kind, Quote[]> = {
    reasoning: [
      { id: "anthropic", name: "Anthropic", sub: "frontier", price: 0.019, secs: 1.9, frontier: true },
      { id: "openai", name: "OpenAI", sub: "frontier", price: 0.016, secs: 2.4, frontier: true },
      { id: "gemini", name: "Gemini", sub: "frontier", price: 0.006, secs: 1.4, frontier: true },
      { id: "mistral", name: "Mistral AI", sub: "fast", price: 0.004, secs: 1.1 },
      { id: "groq", name: "Groq", sub: "fast · open weights", price: 0.0012, secs: 0.3 },
      { id: "deepseek", name: "DeepSeek", sub: "open weights", price: 0.0009, secs: 3.8 },
    ],
    search: [
      { id: "exa", name: "Exa", sub: "neural search", price: 0.005, secs: 0.6 },
      { id: "tavily", name: "Tavily", sub: "search for agents", price: 0.008, secs: 0.4 },
      { id: "perplexity", name: "Perplexity", sub: "answer + sources", price: 0.012, secs: 2.6 },
    ],
    scrape: [
      { id: "firecrawl", name: "Firecrawl", sub: "8 pages to markdown", price: 0.008, secs: 3.1 },
      { id: "contextdev", name: "context.dev", sub: "8 pages to markdown", price: 0.011, secs: 2.2 },
    ],
    context: [
      { id: "contextdev", name: "context.dev", sub: "brand + company lookup", price: 0.004, secs: 0.4 },
      { id: "firecrawl", name: "Firecrawl", sub: "extract from homepage", price: 0.009, secs: 2.8 },
    ],
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const leftEl = $<HTMLInputElement>("rt-left");
  const latEl = $<HTMLInputElement>("rt-lat");
  const frontierEl = $<HTMLInputElement>("rt-frontier");
  const frontierWrap = $<HTMLLabelElement>("rt-frontier-wrap");
  const kindBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".rt-kind"));
  const breakBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".rt-break"));
  let kind: Kind = "reasoning";
  const broken = { price: false, slow: false, down: false };

  const usd = (n: number) => `$${n.toFixed(4)}`;
  const fill = (el: HTMLInputElement) => el.style.setProperty("--fill", `${((+el.value - +el.min) / (+el.max - +el.min)) * 100}%`);

  interface Verdict { q: Quote; price: number; secs: number; down: boolean; reason: string | null }

  function evaluate(left: number, target: number, frontier: boolean, hitId: string | null): Verdict[] {
    return QUOTES[kind].map((q) => {
      const hit = q.id === hitId;
      const price = hit && broken.price ? q.price * 3 : q.price;
      const secs = hit && broken.slow ? q.secs * 5 : q.secs;
      const down = hit && broken.down;
      let reason: string | null = null;
      if (down) reason = "offline";
      else if (frontier && !q.frontier) reason = "not frontier";
      else if (price > left) reason = "over budget";
      else if (secs > target) reason = "too slow";
      return { q, price, secs, down, reason };
    });
  }
  const pick = (vs: Verdict[]) => vs.filter((v) => !v.reason).sort((a, b) => a.price - b.price || a.secs - b.secs)[0] ?? null;

  function run() {
    const left = +leftEl.value / 1000;
    const target = +latEl.value / 10;
    fill(leftEl); fill(latEl);
    $("rt-left-label").textContent = usd(left);
    $("rt-lat-label").textContent = `${target.toFixed(1)}s`;
    frontierWrap.style.display = kind === "reasoning" ? "" : "none";
    const frontier = kind === "reasoning" && frontierEl.checked;

    const before = pick(evaluate(left, target, frontier, null));
    const anyBreak = broken.price || broken.slow || broken.down;
    const hitId = before && anyBreak ? before.q.id : null;
    const vs = evaluate(left, target, frontier, hitId);
    const chosen = pick(vs);

    $("rt-title").textContent = `Quotes for a ${kind} step`;
    $("rt-kind-label").textContent = kind[0].toUpperCase() + kind.slice(1);
    $("rt-quotes").innerHTML = vs.slice().sort((a, b) => a.price - b.price).map((v) => {
      const isPick = chosen?.q.id === v.q.id;
      const status = isPick ? `<span class="text-accent">${hitId && before && before.q.id !== chosen!.q.id ? "rerouted here" : "picked"}</span>` : v.reason ? `<span class="text-destructive">${v.reason}</span>` : `<span class="text-ink-muted">fits</span>`;
      return `<li class="py-4 flex items-center justify-between gap-4 ${isPick ? "" : "opacity-80"}">
        <div class="min-w-0">
          <div class="text-[16px] ${isPick ? "font-semibold text-ink" : "text-ink"}">${v.q.name}${v.q.id === hitId ? ' <span class="font-mono text-[11px] text-warn">broken</span>' : ""}</div>
          <div class="text-[12.5px] text-ink-muted">${v.q.sub} · ${status}</div>
        </div>
        <div class="text-right shrink-0 tabular-nums">
          <div class="text-[16px] ${isPick ? "font-semibold text-ink" : "text-ink"}">${v.down ? "n/a" : usd(v.price)}</div>
          <div class="text-[12.5px] ${v.reason === "too slow" ? "text-destructive" : "text-ink-muted"}">${v.down ? "n/a" : v.secs.toFixed(1) + "s"}</div>
        </div>
      </li>`;
    }).join("");

    if (!chosen) {
      $("rt-pick").textContent = "Stopped";
      $("rt-why").textContent = "No provider fits. Nothing is called or spent.";
      $("rt-why").className = "mt-1 text-[13px] text-destructive min-h-[20px]";
      $("rt-cost").textContent = "$0.0000";
      $("rt-after").textContent = `${usd(left)} left`;
    } else {
      const rerouted = hitId && before && before.q.id !== chosen.q.id;
      $("rt-pick").textContent = chosen.q.name;
      $("rt-why").textContent = rerouted ? `Rerouted from ${before!.q.name}` : "Cheapest that fits";
      $("rt-why").className = `mt-1 text-[13px] ${rerouted ? "text-warn" : "text-accent"} min-h-[20px]`;
      $("rt-cost").textContent = usd(chosen.price);
      $("rt-after").textContent = `${usd(left - chosen.price)} left · ${chosen.secs.toFixed(1)}s`;
    }
  }

  kindBtns.forEach((b) => b.addEventListener("click", () => {
    kind = b.dataset.kind as Kind;
    kindBtns.forEach((x) => x.setAttribute("aria-selected", String(x === b)));
    run();
  }));
  breakBtns.forEach((b) => b.addEventListener("click", () => {
    const id = b.dataset.break as keyof typeof broken;
    broken[id] = !broken[id];
    b.setAttribute("aria-selected", String(broken[id]));
    run();
  }));
  [leftEl, latEl, frontierEl].forEach((el) => el.addEventListener("input", run));
  run();
</script>
