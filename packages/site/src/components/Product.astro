---
import Logo from "./Logo.astro";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const tabs = [
  { id: "route", label: "Route" },
  { id: "caps", label: "Caps" },
  { id: "quotes", label: "Quotes" },
  { id: "settle", label: "Settlement" },
];
const steps = [
  { label: "Plan the task", kind: "reasoning" },
  { label: "Find sources", kind: "search" },
  { label: "Read the pages", kind: "scrape" },
  { label: "Company facts", kind: "context" },
  { label: "Write the brief", kind: "reasoning" },
];
const caps = [
  { name: "Research agent", period: "per day", pct: 63, step: "per step ceiling set", state: "active" },
  { name: "Support agent", period: "per day", pct: 41, step: "per step ceiling set", state: "active" },
  { name: "Lead-gen agent", period: "per week", pct: 92, step: "near cap, cheaper providers only", state: "tight" },
  { name: "Nightly eval", period: "per month", pct: 100, step: "cap reached, steps refused", state: "stopped" },
];
const quotes = [
  { kind: "reasoning", rows: [["Anthropic", "anthropic.svg"], ["OpenAI", "openai.svg"], ["Gemini", "googlegemini.svg"], ["Groq", "groq.png"], ["Mistral AI", "mistralai.svg"], ["DeepSeek", "deepseek.png"]] },
  { kind: "search", rows: [["Exa", "exa.png"], ["Tavily", "tavily.png"], ["Perplexity", "perplexity.svg"]] },
  { kind: "scrape", rows: [["Firecrawl", "firecrawl.png"], ["context.dev", "context.png"]] },
  { kind: "context", rows: [["context.dev", "context.png"]] },
];
const cards = [
  ["Anthropic", "anthropic.svg"], ["OpenAI", "openai.svg"], ["Firecrawl", "firecrawl.png"], ["context.dev", "context.png"], ["Exa", "exa.png"], ["Groq", "groq.png"],
];
---

<section id="app" class="bg-paper pt-28 sm:pt-36 pb-24">
  <div class="max-w-[1120px] mx-auto px-5 sm:px-8">
    <h2 class="max-w-[900px] mx-auto text-center font-display text-[32px] sm:text-[44px] leading-[1.12] font-medium tracking-[-0.035em] text-ink">
      Every model call, search and scrape, sourced at the
      <span class="bg-gradient-to-r from-accent to-[#E9A06B] bg-clip-text text-transparent">best live price</span>
      inside its cap.
    </h2>

    <div class="mt-20 sm:mt-24 rule-label flex-wrap">
      <span>The router</span>
      <span class="rule hidden sm:block"></span>
      <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="Router views">
        {tabs.map((t, i) => <button type="button" role="tab" class="chip-tab" data-tab={t.id} aria-selected={i === 0 ? "true" : "false"}>{t.label}</button>)}
      </div>
    </div>

    <div class="mt-6 window">
      <div class="window-bar">
        <i style="background:#FF5F57"></i><i style="background:#FEBC2E"></i><i style="background:#28C840"></i>
        <span class="ml-3 font-mono text-[11.5px] text-[#8D8A83]">ecorouter · research-agent</span>
        <span class="ml-auto font-mono text-[10.5px] px-2 py-0.5 rounded bg-white/5 text-[#8D8A83]">illustration</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-[210px_1fr] min-h-[520px]">
        <!-- sidebar -->
        <aside class="hidden md:flex flex-col gap-1 p-3 border-r border-[#2A2927] bg-[#131312]">
          <div class="flex items-center gap-2 px-2 py-2 mb-2">
            <Logo class="w-5 h-5 text-white" />
            <span class="font-display text-[14px] font-semibold text-white">EcoRouter</span>
          </div>
          {tabs.map((t, i) => (
            <button type="button" data-tab={t.id} class={`side-tab text-left px-2.5 py-2 rounded-lg text-[13px] ${i === 0 ? "bg-white/10 text-white" : "text-[#A3A099] hover:text-white"}`}>{t.label}</button>
          ))}
          <div class="mt-6 px-2.5 font-mono text-[10px] uppercase tracking-[0.06em] text-[#6F6C66]">Agents</div>
          {["Research agent", "Support agent", "Lead-gen agent", "Nightly eval"].map((a, i) => (
            <div class="flex items-center justify-between px-2.5 py-1.5 text-[12.5px] text-[#A3A099]">
              <span class="truncate">{a}</span>
              <span class={`w-1.5 h-1.5 rounded-full ${i === 3 ? "bg-[#C2362B]" : i === 2 ? "bg-[#E7A23B]" : "bg-[#3BB27F]"}`}></span>
            </div>
          ))}
        </aside>

        <div class="relative p-4 sm:p-6">
          <!-- ROUTE -->
          <div data-pane="route" class="pane">
            <div class="flex items-center justify-between mb-5">
              <div>
                <div class="text-[15px] font-semibold text-white">Run: brief me on a company</div>
                <div class="font-mono text-[11px] text-[#8D8A83]">each step routed fresh</div>
              </div>
              <span id="rd-status" class="font-mono text-[11px] px-2 py-0.5 rounded bg-[#3BB27F]/15 text-[#5FD3A0]">routed</span>
            </div>
            <div id="rd" class="relative grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] gap-4 sm:gap-10">
              <svg id="rd-wires" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></svg>
              <div class="relative space-y-2">
                <div class="font-mono text-[10px] uppercase tracking-[0.06em] text-[#6F6C66] mb-2">Steps</div>
                {steps.map((s, i) => (
                  <div data-step={i} class="rd-step w-cell px-3 py-2 transition-all duration-300">
                    <div class="text-[12.5px] sm:text-[13px] text-white truncate">{s.label}</div>
                    <div class="font-mono text-[10.5px] text-[#8D8A83]">{s.kind}</div>
                  </div>
                ))}
              </div>
              <div class="relative flex flex-col items-center justify-center gap-3">
                <div id="rd-core" class="w-12 h-12 sm:w-20 sm:h-20 rounded-xl sm:rounded-2xl flex items-center justify-center" style="background:linear-gradient(150deg,#fff,#EFD3BF);box-shadow:0 0 60px rgba(210,86,17,0.45)">
                  <Logo class="w-6 h-6 sm:w-10 sm:h-10 text-ink" />
                </div>
                <ul class="space-y-1 font-mono text-[10.5px] text-[#A3A099]">
                  <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-sm bg-[#3BB27F]"></span>cap</li>
                  <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-sm bg-[#3BB27F]"></span>latency</li>
                  <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-sm bg-[#3BB27F]"></span>health</li>
                </ul>
              </div>
              <div class="relative">
                <div class="font-mono text-[10px] uppercase tracking-[0.06em] text-[#6F6C66] mb-2">Providers</div>
                <div id="rd-providers" class="space-y-2"></div>
              </div>
            </div>
            <div id="rd-note" class="mt-6 pt-4 border-t border-[#2A2927] text-[13px] text-[#A3A099] min-h-[44px]" aria-live="polite"></div>
          </div>

          <!-- CAPS -->
          <div data-pane="caps" class="pane hidden">
            <div class="text-[15px] font-semibold text-white">Spending caps</div>
            <div class="font-mono text-[11px] text-[#8D8A83] mb-5">checked before any provider is called</div>
            <ul class="space-y-3">
              {caps.map((c) => (
                <li class="w-cell p-4">
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-[14px] text-white">{c.name}</span>
                    <span class={`font-mono text-[11px] ${c.state === "stopped" ? "text-[#F07A6E]" : c.state === "tight" ? "text-[#E7A23B]" : "text-[#5FD3A0]"}`}>{c.state}</span>
                  </div>
                  <div class="mt-3 h-1.5 rounded-full bg-white/10 overflow-hidden">
                    <div class={`h-full rounded-full ${c.state === "stopped" ? "bg-[#C2362B]" : c.state === "tight" ? "bg-[#E7A23B]" : "bg-accent"}`} style={`width:${c.pct}%`}></div>
                  </div>
                  <div class="mt-2 flex justify-between font-mono text-[11px] text-[#8D8A83]"><span>{c.step}</span><span>{c.period}</span></div>
                </li>
              ))}
            </ul>
          </div>

          <!-- QUOTES -->
          <div data-pane="quotes" class="pane hidden">
            <div class="text-[15px] font-semibold text-white">Quote board</div>
            <div class="font-mono text-[11px] text-[#8D8A83] mb-5">providers per step kind, refreshed on a window</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {quotes.map((q) => (
                <div class="w-cell p-4">
                  <div class="font-mono text-[11px] uppercase tracking-[0.06em] text-accent mb-3">{q.kind}</div>
                  <ul class="space-y-2">
                    {q.rows.map(([n, l]) => (
                      <li class="flex items-center gap-2.5 text-[13px] text-[#E9E7E1]">
                        <span class="w-6 h-6 rounded-md bg-white flex items-center justify-center shrink-0"><img src={`${basePath}/logos/${l}`} alt="" class="w-4 h-4 object-contain" /></span>
                        {n}
                        <span class="ml-auto font-mono text-[10.5px] text-[#6F6C66]">price · p50</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <!-- SETTLEMENT -->
          <div data-pane="settle" class="pane hidden">
            <div class="flex items-center gap-2 text-[15px] font-semibold text-white"><img src={`${basePath}/logos/airwallex.png`} alt="" class="w-5 h-5" /> Settlement on Airwallex</div>
            <div class="font-mono text-[11px] text-[#8D8A83] mb-5">one virtual card per provider, limits mirror the caps · planned</div>
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-6 items-center">
              <ul class="space-y-2">
                {cards.map(([n, l], i) => (
                  <li class="w-cell px-3 py-2.5 flex items-center gap-3">
                    <span class="w-6 h-6 rounded-md bg-white flex items-center justify-center shrink-0"><img src={`${basePath}/logos/${l}`} alt="" class="w-4 h-4 object-contain" /></span>
                    <span class="text-[13px] text-white">{n}</span>
                    <span class="font-mono text-[11px] text-[#6F6C66]">card ···· {String(4100 + i * 37).slice(-4)}</span>
                    <span class={`ml-auto font-mono text-[10.5px] uppercase ${i === 0 ? "text-[#E7A23B]" : "text-[#6F6C66]"}`}>{i === 0 ? "connecting" : "planned"}</span>
                  </li>
                ))}
              </ul>
              <div class="hidden lg:flex flex-col items-center gap-3 pr-6">
                <div class="tile tile-sm" style="background:linear-gradient(150deg,#fff,#F6D2C4)"><img src={`${basePath}/logos/airwallex.png`} alt="" class="relative z-10 w-12 h-12" /></div>
                <div class="font-mono text-[11px] text-[#8D8A83] text-center">airwallex sandbox<br />api-demo.airwallex.com</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type Row = { name: string; logo: string; state: "picked" | "fits" | "skip"; reason?: string };
  type Scene = { step: number; rows: Row[]; note: string; rerouted?: boolean };

  const SCENES: Scene[] = [
    { step: 0, note: "Planning needs a frontier model. Anthropic is the cheapest one under the latency target.", rows: [
      { name: "Anthropic", logo: "anthropic.svg", state: "picked" },
      { name: "OpenAI", logo: "openai.svg", state: "skip", reason: "slower" },
      { name: "Gemini", logo: "googlegemini.svg", state: "fits" },
    ] },
    { step: 1, note: "Search goes to Exa. Perplexity is over this agent's per-step ceiling.", rows: [
      { name: "Exa", logo: "exa.png", state: "picked" },
      { name: "Tavily", logo: "tavily.png", state: "fits" },
      { name: "Perplexity", logo: "perplexity.svg", state: "skip", reason: "over step cap" },
    ] },
    { step: 2, note: "Reading eight pages: Firecrawl is cheaper per page right now.", rows: [
      { name: "Firecrawl", logo: "firecrawl.png", state: "picked" },
      { name: "context.dev", logo: "context.png", state: "fits" },
    ] },
    { step: 3, note: "Company facts come from context.dev. Firecrawl would work but is slower for a lookup.", rows: [
      { name: "context.dev", logo: "context.png", state: "picked" },
      { name: "Firecrawl", logo: "firecrawl.png", state: "skip", reason: "slower" },
    ] },
    { step: 4, rerouted: true, note: "Anthropic no longer fits the budget left on this run, so the last step reroutes to Groq.", rows: [
      { name: "Anthropic", logo: "anthropic.svg", state: "skip", reason: "over run budget" },
      { name: "Groq", logo: "groq.png", state: "picked" },
      { name: "Mistral AI", logo: "mistralai.svg", state: "fits" },
    ] },
  ];

  const base = (document.querySelector('link[rel="icon"]') as HTMLLinkElement | null)?.getAttribute("href")?.replace(/\/logo\.svg$/, "") ?? "";
  const wires = document.getElementById("rd-wires") as unknown as SVGSVGElement;
  const provEl = document.getElementById("rd-providers")!;
  const noteEl = document.getElementById("rd-note")!;
  const statusEl = document.getElementById("rd-status")!;
  const core = document.getElementById("rd-core")!;
  const stepEls = Array.from(document.querySelectorAll<HTMLElement>(".rd-step"));
  const ACCENT = "#D25611", WARN = "#E7A23B";

  function draw(scene: Scene) {
    const box = wires.getBoundingClientRect();
    const stepEl = stepEls[scene.step];
    const picked = provEl.querySelector<HTMLElement>('[data-state="picked"]');
    if (!stepEl || !picked || box.width === 0) return;
    const a = stepEl.getBoundingClientRect(), c = core.getBoundingClientRect(), p = picked.getBoundingClientRect();
    const x1 = a.right - box.left, y1 = a.top + a.height / 2 - box.top;
    const cx1 = c.left - box.left, cx2 = c.right - box.left, cy = c.top + c.height / 2 - box.top;
    const x2 = p.left - box.left, y2 = p.top + p.height / 2 - box.top;
    const color = scene.rerouted ? WARN : ACCENT;
    const curve = (sx: number, sy: number, ex: number, ey: number) => {
      const mx = (sx + ex) / 2;
      return `M${sx},${sy} C${mx},${sy} ${mx},${ey} ${ex},${ey}`;
    };
    const pair = (d: string) => `<path d="${d}" fill="none" stroke="${color}" stroke-opacity="0.25" stroke-width="2"/><path class="wire-live" d="${d}" fill="none" stroke="${color}" stroke-width="2"/>`;
    wires.innerHTML = pair(curve(x1, y1, cx1, cy)) + pair(curve(cx2, cy, x2, y2));
  }

  let i = 0;
  function show() {
    const scene = SCENES[i];
    const color = scene.rerouted ? WARN : ACCENT;
    stepEls.forEach((el, n) => {
      const on = n === scene.step;
      el.style.borderColor = on ? color : "";
      el.style.boxShadow = on ? `0 0 0 1px ${color}, 0 10px 30px -10px ${color}` : "";
      el.style.opacity = n < scene.step ? "0.45" : "1";
    });
    provEl.innerHTML = scene.rows.map((r) => {
      const border = r.state === "picked" ? `border-color:${color};box-shadow:0 0 0 1px ${color}` : "";
      const fade = r.state === "skip" ? "opacity-50" : "";
      const tag = r.state === "picked"
        ? `<span class="font-mono text-[10px]" style="color:${color}">${scene.rerouted ? "rerouted" : "picked"}</span>`
        : r.state === "skip" ? `<span class="font-mono text-[10px] text-[#F07A6E] truncate">${r.reason}</span>` : `<span class="font-mono text-[10px] text-[#6F6C66]">fits</span>`;
      return `<div data-state="${r.state}" class="w-cell ${fade} px-2.5 py-2 flex items-center gap-2 min-w-0 transition-all" style="${border}">
        <span class="hidden sm:flex w-6 h-6 rounded-md bg-white items-center justify-center shrink-0"><img src="${base}/logos/${r.logo}" alt="" class="w-4 h-4 object-contain" /></span>
        <span class="min-w-0 flex-1"><span class="block text-[12.5px] text-white truncate">${r.name}</span>${tag}</span>
      </div>`;
    }).join("");
    statusEl.textContent = scene.rerouted ? "rerouted" : "routed";
    statusEl.className = scene.rerouted
      ? "font-mono text-[11px] px-2 py-0.5 rounded bg-[#E7A23B]/15 text-[#E7A23B]"
      : "font-mono text-[11px] px-2 py-0.5 rounded bg-[#3BB27F]/15 text-[#5FD3A0]";
    noteEl.textContent = scene.note;
    draw(scene);
  }

  // Tabs: chips above the window and the window sidebar switch the same panes
  function select(id: string) {
    document.querySelectorAll<HTMLElement>("#app .pane").forEach((p) => p.classList.toggle("hidden", p.dataset.pane !== id));
    document.querySelectorAll<HTMLElement>("#app .chip-tab").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.tab === id)));
    document.querySelectorAll<HTMLElement>("#app .side-tab").forEach((b) => {
      const on = b.dataset.tab === id;
      b.classList.toggle("bg-white/10", on);
      b.classList.toggle("text-white", on);
      b.classList.toggle("text-[#A3A099]", !on);
    });
    if (id === "route") draw(SCENES[i]);
  }
  document.querySelectorAll<HTMLElement>("#app [data-tab]").forEach((b) => b.addEventListener("click", () => select(b.dataset.tab!)));

  show();
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    setInterval(() => { i = (i + 1) % SCENES.length; show(); }, 2800);
  }
  window.addEventListener("resize", () => draw(SCENES[i]));
  document.fonts?.ready.then(() => draw(SCENES[i]));
</script>
