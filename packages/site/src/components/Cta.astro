---
import Logo from "./Logo.astro";
---

<section class="relative overflow-hidden atmo border-t border-line-strong">
  <div class="relative max-w-[1120px] mx-auto px-5 sm:px-8 py-28 sm:py-36 flex flex-col items-center text-center">
    <div class="float">
      <div class="tile tile-sm"><Logo class="relative z-10 w-14 h-14 text-ink" /></div>
    </div>
    <h2 class="mt-12 font-display text-[40px] sm:text-[56px] leading-[1.02] font-medium tracking-[-0.045em] text-ink">Let your agents check the price first.</h2>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href="#router" class="btn-primary h-12 px-6 text-[15px] !rounded-full">Try the router</a>
      <a href="https://github.com/fozagtx/ecorouter" target="_blank" rel="noopener noreferrer" class="btn-secondary h-12 px-6 text-[15px] !rounded-full">Read the code</a>
    </div>
    <p class="mt-4 text-[13px] text-ink-muted">Hackathon build · Airwallex settlement in progress</p>
  </div>
</section>
