---
import Logo from './Logo.astro';
---

<footer class="py-10 border-t border-[#D2D2CE] bg-[#EFEFEC] font-mono text-xs text-[#55555A]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-6">
    <!-- Brand -->
    <div class="flex items-center gap-2.5">
      <div class="w-6 h-6 rounded-[3px] bg-[#0B0B0C] flex items-center justify-center text-white">
        <Logo class="w-3.5 h-3.5 text-white" />
      </div>
      <span class="font-semibold text-[#0B0B0C]">EcoRouter</span>
      <span class="text-[#D2D2CE]">|</span>
      <span class="text-[11px] text-[#7D7D84]">APACHE 2.0</span>
    </div>

    <!-- Navigation -->
    <div class="flex items-center gap-6 text-[11.5px]">
      <a href="#features" class="hover:text-[#0B0B0C] transition-colors">How it works</a>
      <a href="#quickstart" class="hover:text-[#0B0B0C] transition-colors">Quickstart</a>
      <a href="#simulator" class="hover:text-[#0B0B0C] transition-colors">Simulator</a>
      <a href="#faq" class="hover:text-[#0B0B0C] transition-colors">FAQ</a>
      <a href="https://github.com/fozagtx/ecorouter" target="_blank" rel="noopener noreferrer" class="hover:text-[#0B0B0C] transition-colors">GitHub ↗</a>
      <a href="https://www.npmjs.com/package/ecorouter" target="_blank" rel="noopener noreferrer" class="hover:text-[#0B0B0C] transition-colors">npm ↗</a>
    </div>

    <!-- Install Pill/Command -->
    <div>
      <button
        onclick="copyText('pnpm add ecorouter')"
        class="h-7 px-2.5 rounded-[3px] bg-white hover:bg-[#EFEFEC] text-[#0B0B0C] border border-[#D2D2CE] transition-colors flex items-center gap-1.5 text-[11px] cursor-pointer"
      >
        <span class="text-[#7D7D84]">$</span>
        <span>pnpm add ecorouter</span>
      </button>
    </div>
  </div>
</footer>
