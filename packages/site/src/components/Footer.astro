---
import Logo from './Logo.astro';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="pt-20 pb-12 border-t border-black/8 bg-[#fafaf7] relative overflow-hidden">
  <!-- Giant Slogan Banner -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-16 pb-16 border-b border-black/8">
    <div class="text-center">
      <div class="text-[11px] font-mono uppercase tracking-widest text-[#d25611] font-semibold mb-4">
        The Autonomous Agent Capability Fabric
      </div>
      <div class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[#0c0c09] leading-[1.05] max-w-4xl mx-auto">
        Declare Capability.<br class="hidden sm:inline" />
        Enforce Limits. Settle On-Chain.
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <button
          onclick="copyText('pnpm add ecorouter')"
          class="px-5 py-2.5 rounded-full text-xs font-mono font-medium bg-[#0c0c09] text-white hover:bg-[#20201a] active:scale-95 transition-all flex items-center gap-2 shadow-sm"
        >
          <span>$ pnpm add ecorouter</span>
          <svg class="w-3.5 h-3.5 text-white/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
        <a
          href="https://github.com/fozagtx/ecorouter"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-full text-xs font-mono bg-white text-[#0c0c09] hover:bg-[#f4f4f0] border border-black/10 transition-colors inline-flex items-center gap-2 shadow-xs"
        >
          <span>View on GitHub</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 4 Columns -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-2 md:grid-cols-4 gap-8 mb-16 text-xs font-mono">
    <div>
      <div class="font-semibold text-[#0c0c09] uppercase tracking-wider mb-4">Product</div>
      <ul class="space-y-2.5 text-[#606056]">
        <li><a href="#capabilities" class="hover:text-[#0c0c09] transition-colors">Capabilities</a></li>
        <li><a href="#x402-protocol" class="hover:text-[#0c0c09] transition-colors">x402 V2 Protocol</a></li>
        <li><a href="#architecture" class="hover:text-[#0c0c09] transition-colors">Dynamic Arbitrage</a></li>
        <li><a href="#simulator" class="hover:text-[#0c0c09] transition-colors">Live Simulator</a></li>
        <li><a href="https://github.com/fozagtx/ecorouter/releases" class="hover:text-[#0c0c09] transition-colors">Release Notes</a></li>
      </ul>
    </div>

    <div>
      <div class="font-semibold text-[#0c0c09] uppercase tracking-wider mb-4">Developers</div>
      <ul class="space-y-2.5 text-[#606056]">
        <li><a href="https://github.com/fozagtx/ecorouter#quickstart" class="hover:text-[#0c0c09] transition-colors">TypeScript SDK</a></li>
        <li><a href="https://github.com/fozagtx/ecorouter#python-sdk" class="hover:text-[#0c0c09] transition-colors">Python SDK</a></li>
        <li><a href="https://github.com/fozagtx/ecorouter#cli" class="hover:text-[#0c0c09] transition-colors">CLI Daemon</a></li>
        <li><a href="https://github.com/fozagtx/ecorouter" class="hover:text-[#0c0c09] transition-colors">GitHub Repository</a></li>
      </ul>
    </div>

    <div>
      <div class="font-semibold text-[#0c0c09] uppercase tracking-wider mb-4">Ecosystem</div>
      <ul class="space-y-2.5 text-[#606056]">
        <li><a href="https://modelcontextprotocol.io" target="_blank" rel="noopener" class="hover:text-[#0c0c09] transition-colors">Model Context Protocol</a></li>
        <li><a href="https://base.org" target="_blank" rel="noopener" class="hover:text-[#0c0c09] transition-colors">Base L2 Settlement</a></li>
        <li><a href="https://solana.com" target="_blank" rel="noopener" class="hover:text-[#0c0c09] transition-colors">Solana Agent Network</a></li>
        <li><a href="https://github.com/fozagtx/ecorouter/blob/main/LICENSE" class="hover:text-[#0c0c09] transition-colors">Apache 2.0 License</a></li>
      </ul>
    </div>

    <div>
      <div class="font-semibold text-[#0c0c09] uppercase tracking-wider mb-4">Security</div>
      <ul class="space-y-2.5 text-[#606056]">
        <li><span class="text-emerald-600">●</span> All Systems Operational</li>
        <li><a href="https://github.com/fozagtx/ecorouter/security" class="hover:text-[#0c0c09] transition-colors">Security Advisories</a></li>
        <li><a href="https://github.com/fozagtx/ecorouter/blob/main/SECURITY.md" class="hover:text-[#0c0c09] transition-colors">Vulnerability Disclosure</a></li>
      </ul>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 border-t border-black/6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[#606056]">
    <div class="flex items-center gap-2">
      <div class="w-5 h-5 rounded bg-[#d25611] flex items-center justify-center text-white">
        <Logo class="w-3 h-3 text-white" />
      </div>
      <span class="text-[#0c0c09] font-medium">EcoRouter</span>
      <span class="text-black/20">|</span>
      <span>Open Source Software under Apache 2.0</span>
    </div>

    <div>
      <span>© 2026 EcoRouter. Built for autonomous agent economies.</span>
    </div>
  </div>
</footer>
