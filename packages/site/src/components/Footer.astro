---
import Logo from './Logo.astro';
---

<footer class="py-12 border-t border-black/8 bg-white font-mono text-xs text-[#606056]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-6">
    <!-- Brand -->
    <div class="flex items-center gap-2.5">
      <div class="w-6 h-6 rounded bg-[#d25611] flex items-center justify-center text-white">
        <Logo class="w-3.5 h-3.5 text-white" />
      </div>
      <span class="font-bold text-[#0c0c09]">EcoRouter</span>
      <span class="text-black/20">|</span>
      <span>Apache 2.0</span>
    </div>

    <!-- Navigation -->
    <div class="flex items-center gap-6">
      <a href="#quickstart" class="hover:text-[#0c0c09] transition-colors">Quickstart</a>
      <a href="#simulator" class="hover:text-[#0c0c09] transition-colors">Simulator</a>
      <a href="#faq" class="hover:text-[#0c0c09] transition-colors">FAQ</a>
      <a href="https://github.com/fozagtx/ecorouter" target="_blank" rel="noopener noreferrer" class="hover:text-[#0c0c09] transition-colors">GitHub ↗</a>
    </div>

    <!-- Install command -->
    <div>
      <button
        onclick="copyText('pnpm add ecorouter')"
        class="px-3 py-1 rounded bg-[#f4f4f0] hover:bg-[#eaeae5] text-[#0c0c09] border border-black/8 transition-colors flex items-center gap-2 text-[11px]"
      >
        <span>$ pnpm add ecorouter</span>
      </button>
    </div>
  </div>
</footer>
