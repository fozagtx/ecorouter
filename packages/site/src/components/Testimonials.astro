---
const reviews = [
  {
    quote: "Our autonomous scraping agents used to burn $400/day on failed API retry storms. With EcoRouter's per-hop mandates and circuit breakers, our billing dropped 74% overnight.",
    author: "Elena Rostova",
    role: "Lead AI Engineer",
    company: "VectorScale Labs"
  },
  {
    quote: "Giving raw credit cards or unrestricted API tokens to autonomous LLMs is insane. EcoRouter’s cryptographic budget caps are the only reason our compliance team allowed production agent deployment.",
    author: "Marcus Chen",
    role: "VP Infrastructure",
    company: "SynthData Corp"
  },
  {
    quote: "x402 V2 is the future of machine commerce. Our agents buy search, browser sandboxes, and indexing on demand with micro-USDC. We don't have accounts with any of the providers.",
    author: "Liam O'Connor",
    role: "Founder",
    company: "Autonomy Labs"
  },
  {
    quote: "The multi-provider arbitrage is unreal. When one web scraper suffers degraded latency, EcoRouter automatically shifts the flow to another endpoint in under 15ms. Zero downtime.",
    author: "Sophia Patel",
    role: "Staff Platform Engineer",
    company: "Hyperspace Research"
  },
  {
    quote: "We plugged EcoRouter into our Claude MCP tooling pipeline in 15 minutes. It handles the economic layer completely transparently. The cleanest developer experience I’ve seen.",
    author: "David Lindqvist",
    role: "Core Contributor",
    company: "OpenAgent Protocol"
  },
  {
    quote: "No subscriptions. No tier locks. Just declare what capability you want, sign a mandate, and your agent executes safely. This is what decentralized AI infrastructure should look like.",
    author: "Amina Al-Mansoor",
    role: "Autonomous Systems Lead",
    company: "Nexus Autonomy"
  }
];
---

<section class="py-20 md:py-28 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f4f4f0] border border-black/8 text-xs font-mono text-[#606056] mb-3 shadow-xs">
        <span>FIELD VALIDATION</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#0c0c09] mb-3">
        Engineered for teams building autonomous AI agents.
      </h2>
      <p class="text-sm sm:text-base text-[#606056]">
        How autonomous engineering teams eliminate vendor lock-in and cap LLM spending risks.
      </p>
    </div>

    <!-- 1px Hairline Grid -->
    <div class="rounded-2xl border border-black/8 bg-black/8 overflow-hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px shadow-sm">
      {reviews.map((r) => (
        <div class="bg-white p-6 sm:p-8 flex flex-col justify-between hover:bg-[#fafaf7] transition-colors">
          <p class="text-sm text-[#4a4a40] leading-relaxed mb-6 font-normal">
            "{r.quote}"
          </p>
          <div class="pt-4 border-t border-black/6 flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#f4f4f0] border border-black/8 flex items-center justify-center font-mono font-bold text-xs text-[#d25611]">
              {r.author[0]}
            </div>
            <div>
              <div class="text-xs font-semibold text-[#0c0c09]">{r.author}</div>
              <div class="text-[11px] font-mono text-[#606056]">{r.role} • {r.company}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
