---
import AsciiGrid from "./AsciiGrid.astro";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="relative overflow-hidden bg-white">
  <AsciiGrid class="text-accent/40 [mask-image:linear-gradient(to_bottom,black_55%,transparent)]" />
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="rails px-5 sm:px-10 pt-16 pb-10 md:pt-24 md:pb-14">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-7">
        <span class="inline-flex items-center gap-2 h-7 pl-1.5 pr-2.5 rounded-pill border border-ink bg-white text-[12px] font-mono text-ink-secondary">
          <span class="w-4 h-4 rounded-full bg-ink flex items-center justify-center">
            <img src={`${basePath}/logos/stellar.svg`} alt="" class="w-2.5 h-2.5 invert" />
          </span>
          Built on Stellar
        </span>
        <span class="inline-flex items-center gap-1.5 h-7 px-2.5 rounded-pill border border-line-strong bg-white text-[12px] font-mono text-ink-muted">
          <span class="w-1.5 h-1.5 rounded-full bg-warn"></span>
          Testnet only · not audited
        </span>
      </div>

      <h1 class="text-[38px] leading-[1.04] sm:text-[56px] md:text-[68px] lg:text-[76px] font-medium tracking-[-0.035em] text-ink max-w-[960px]">
        Spending rules for teams and their AI agents, enforced on Stellar
      </h1>

      <p class="mt-6 text-[17px] sm:text-[19px] leading-[1.5] text-ink-secondary max-w-[660px]">
        One shared USDC account. Every person and every agent on your team pays under its own allowance, per-payment cap and list of approved services.
        <span class="text-ink font-medium">The agent proposes. Only the contract authorizes.</span>
      </p>

      <div class="mt-9 flex flex-col sm:flex-row gap-3">
        <a
          href={`${basePath}/app/`}
          class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-[3px] text-[13px] font-mono font-medium bg-ink hover:bg-[#26272B] text-white border-[1.5px] border-ink"
        >
          Open the app
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="#how"
          class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-[3px] text-[13px] font-mono font-medium bg-white hover:bg-surface-soft text-ink border-[1.5px] border-ink"
        >
          See how it works
          <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="mt-4 font-mono text-[11px] text-ink-muted">Try the sandbox with test dollars. No wallet needed.</p>
    </div>
  </div>
</section>
