---
---

<section class="pt-16 pb-10 md:pt-24 md:pb-14 font-jetbrains">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <!-- Clean Tag -->
    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[#f4f4f0] border border-black/8 text-[11px] text-[#606056] mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-[#d25611]"></span>
      <span>v0.1.0</span>
    </div>

    <!-- Minimal Headline in JetBrains Mono -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#0c0c09] leading-tight mb-4 max-w-3xl mx-auto">
      HTTP 402 capability routing for AI agents.
    </h1>

    <!-- Single Line Description -->
    <p class="text-sm sm:text-base text-[#606056] max-w-xl mx-auto mb-8 font-normal">
      Compare live provider prices. Enforce spend caps. Settle per request.
    </p>

    <!-- Clean Install Pill -->
    <div class="flex items-center justify-center gap-3">
      <button
        onclick="copyText('pnpm add ecorouter')"
        class="inline-flex items-center gap-2.5 px-4 py-2 rounded-lg text-xs sm:text-sm bg-[#0c0c09] text-white hover:bg-[#20201a] active:scale-95 transition-all group shadow-xs cursor-pointer"
        title="Copy install command"
      >
        <span class="text-[#d25611] font-bold">$</span>
        <span>pnpm add ecorouter</span>
        <svg class="w-3.5 h-3.5 text-white/60 group-hover:text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </button>

      <a
        href="https://github.com/fozagtx/ecorouter"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs sm:text-sm bg-[#f4f4f0] hover:bg-[#eaeae5] text-[#0c0c09] border border-black/8 transition-all"
      >
        <span>GitHub ↗</span>
      </a>
    </div>
  </div>
</section>
