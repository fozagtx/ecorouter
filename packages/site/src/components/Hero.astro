---
import CopyInstall from "./CopyInstall.astro";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="relative bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="rails px-5 sm:px-10 pt-16 pb-10 md:pt-24 md:pb-14">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-7">
        <span class="inline-flex items-center gap-2 h-7 pl-1.5 pr-2.5 rounded-pill border border-line bg-white text-[12px] font-mono text-ink-secondary">
          <span class="w-4 h-4 rounded-full bg-ink flex items-center justify-center">
            <img src={`${basePath}/logos/stellar.svg`} alt="" class="w-2.5 h-2.5 invert" />
          </span>
          Built on Stellar
        </span>
        <span class="eyebrow">Soroban · USDC · x402</span>
      </div>

      <h1 class="text-[40px] leading-[1.04] sm:text-[56px] md:text-[68px] lg:text-[76px] font-medium tracking-[-0.035em] text-ink max-w-[920px]">
        The agentic spending runtime for agents on Stellar
      </h1>

      <p class="mt-6 text-[17px] sm:text-[19px] leading-[1.5] text-ink-secondary max-w-[640px]">
        Your agent gets a Soroban smart account with a hard USDC budget. It buys the APIs it needs over x402, picks the best value provider, and settles on Stellar without ever spending past the mandate you set.
      </p>

      <div class="mt-9 flex flex-col sm:flex-row gap-3">
        <CopyInstall />
        <a
          href="#quickstart"
          class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-[3px] text-[13px] font-mono font-medium bg-white hover:bg-surface-soft text-ink border border-line-strong"
        >
          Read the quickstart
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
