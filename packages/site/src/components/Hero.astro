---
---

<section class="relative pt-16 pb-8 md:pt-20 md:pb-10 bg-technical-grid">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <!-- Technical Label / Eyebrow -->
    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-[3px] bg-[#ECECE8] border border-[#D8D8D3] text-[10.5px] font-mono uppercase tracking-[0.16em] text-[#4F4F4A] mb-6">
      <span class="w-1.5 h-1.5 rounded-[1px] bg-[#111111]"></span>
      <span>CAPABILITY RUNTIME • v0.1.0</span>
    </div>

    <!-- Restrained Editorial H1 -->
    <h1 class="text-3xl sm:text-4xl md:text-[44px] font-semibold tracking-tight text-[#111111] leading-[1.1] mb-4 max-w-3xl mx-auto">
      Budget-bounded capability spending for autonomous agents.
    </h1>

    <!-- Direct Technical Description -->
    <p class="text-base sm:text-lg text-[#4F4F4A] max-w-xl mx-auto mb-8 font-normal leading-relaxed">
      Enforce hard spend policies across HTTP 402 providers. Compare live quotes in parallel and authorize atomic micro-settlements.
    </p>

    <!-- 4px Rectangular Action Buttons -->
    <div class="flex items-center justify-center gap-3">
      <button
        onclick="copyText('pnpm add ecorouter')"
        class="inline-flex items-center gap-2.5 px-4 h-10 rounded-[4px] text-xs sm:text-sm font-mono font-medium bg-[#111111] hover:bg-[#292929] text-white active:scale-98 transition-colors cursor-pointer border border-[#111111]"
        title="Copy install command"
      >
        <span class="text-[#888883]">$</span>
        <span>pnpm add ecorouter</span>
        <svg class="w-3.5 h-3.5 text-[#888883]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </button>

      <a
        href="https://github.com/fozagtx/ecorouter"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 h-10 rounded-[4px] text-xs sm:text-sm font-mono font-medium bg-white hover:bg-[#F3F3F0] text-[#111111] border border-[#D0D0CB] transition-colors"
      >
        <span>GitHub ↗</span>
      </a>
    </div>
  </div>
</section>
