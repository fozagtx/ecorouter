---
---

<section class="relative pt-20 pb-10 md:pt-24 md:pb-12 bg-technical-grid">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <!-- Floating Technical Metadata Eyebrow (No chunky badge) -->
    <div class="flex items-center justify-center gap-3 text-[11px] font-mono uppercase tracking-[0.2em] text-[#7D7D84] mb-6 select-none">
      <span>PLATFORM · 01</span>
      <span class="text-[#D2D2CE]">/</span>
      <span class="text-[#0B0B0C] font-medium flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 bg-[#725CFF] rounded-[0.5px]"></span>
        SYSTEM · ACTIVE
      </span>
    </div>

    <!-- Dense Modern Grotesk H1 (Geist/Inter, Title Case, Tight Tracking) -->
    <h1 class="text-[42px] sm:text-[60px] md:text-[68px] lg:text-[74px] font-medium tracking-[-0.045em] text-[#0B0B0C] leading-[0.98] mb-6 max-w-[760px] mx-auto">
      Budget-bounded<br class="hidden sm:inline" /> capability spending
    </h1>

    <!-- Restrained Technical Supporting Copy -->
    <p class="text-base sm:text-[17px] text-[#55555A] max-w-[580px] mx-auto mb-8 font-normal leading-[1.48]">
      Enforce hard spend policies across HTTP 402 providers. Compare live quotes in parallel and authorize atomic micro-settlements.
    </p>

    <!-- Compact Rectangular Action Buttons -->
    <div class="flex items-center justify-center gap-3">
      <button
        onclick="copyText('pnpm add ecorouter')"
        class="inline-flex items-center gap-2.5 px-4 h-10 rounded-[3px] text-xs sm:text-[13px] font-mono font-medium bg-[#0B0B0C] hover:bg-[#252528] text-white active:scale-98 transition-colors cursor-pointer border border-[#0B0B0C]"
        title="Copy install command"
      >
        <span class="text-[#7D7D84]">$</span>
        <span>pnpm add ecorouter</span>
        <svg class="w-3.5 h-3.5 text-[#7D7D84]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </button>

      <a
        href="https://github.com/fozagtx/ecorouter"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 h-10 rounded-[3px] text-xs sm:text-[13px] font-mono font-medium bg-white hover:bg-[#EFEFEC] text-[#0B0B0C] border border-[#D2D2CE] transition-colors"
      >
        <span>GitHub ↗</span>
      </a>
    </div>
  </div>
</section>
