---

<section class="relative pt-16 pb-8 md:pt-20 md:pb-10 bg-technical-grid">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <!-- Technical Label / Eyebrow -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[3px] bg-[#F1F1ED] border border-[#D9D9D4] text-[10.5px] font-mono uppercase tracking-[0.2em] text-[#55555A] mb-6 select-none">
      <span class="w-1.5 h-1.5 rounded-[1px] bg-[#725CFF]"></span>
      <span>PLATFORM · 01 // SYSTEM ACTIVE</span>
    </div>

    <!-- Futuristic Display H1 in Michroma -->
    <h1 class="text-3xl sm:text-5xl lg:text-[64px] font-display uppercase tracking-[0.02em] text-[#0C0C0D] leading-[1.02] mb-5 max-w-4xl mx-auto">
      Budget-Bounded<br class="hidden sm:inline" /> Capability Spending
    </h1>

    <!-- Direct Technical Description -->
    <p class="text-base sm:text-lg text-[#55555A] max-w-xl mx-auto mb-8 font-normal leading-relaxed">
      Enforce hard spend policies across dynamic HTTP 402 providers. Compare live quotes in parallel and authorize atomic micro-settlements.
    </p>

    <!-- 4px Rectangular Action Buttons -->
    <div class="flex items-center justify-center gap-3">
      <button
        onclick="copyText('pnpm add ecorouter')"
        class="inline-flex items-center gap-2.5 px-4 h-10 rounded-[4px] text-xs sm:text-sm font-mono font-medium bg-[#0C0C0D] hover:bg-[#252528] text-white active:scale-98 transition-colors cursor-pointer border border-[#0C0C0D]"
        title="Copy install command"
      >
        <span class="text-[#85858B]">$</span>
        <span>pnpm add ecorouter</span>
        <svg class="w-3.5 h-3.5 text-[#85858B]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </button>

      <a
        href="https://github.com/fozagtx/ecorouter"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 h-10 rounded-[4px] text-xs sm:text-sm font-mono font-medium bg-white hover:bg-[#F1F1ED] text-[#0C0C0D] border border-[#D9D9D4] transition-colors"
      >
        <span>GitHub ↗</span>
      </a>
    </div>
  </div>
</section>
