---
---

<section class="relative pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
  <!-- Subtle top radial glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[680px] h-[340px] bg-[#d25611]/12 blur-[140px] pointer-events-none rounded-full"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center relative z-10">
    <!-- Eyebrow Pill -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1d1d16] border border-white/10 text-xs font-mono text-[#abab9c] mb-6 shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-[#d25611] animate-pulse"></span>
      <span class="text-[#fbfbf9] font-medium">EcoRouter v0.9</span>
      <span class="text-white/20">|</span>
      <span>Declarative Capability Routing for Autonomous AI Agents</span>
    </div>

    <!-- Giant Headline with tight tracking -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-[#fbfbf9] leading-[1.04] mb-6 max-w-4xl mx-auto">
      Stop hardcoding vendor APIs.<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#fbfbf9] via-[#e8e8e3] to-[#abab9c]">
        Start routing real capabilities.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg md:text-xl text-[#abab9c] max-w-2xl mx-auto leading-relaxed mb-10 font-normal">
      The open-source capability router for autonomous AI agents. Probe payment requirements over <span class="text-[#fbfbf9] font-mono font-medium">x402 V2</span>, enforce cryptographic spending mandates, and arbitrate providers by cost and latency without handing agents raw API keys or credit cards.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-10">
      <a
        href="#capabilities"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold bg-[#e8e8e3] text-[#1d1d16] hover:bg-white hover:shadow-lg hover:shadow-white/5 active:scale-95 transition-all"
      >
        <span>Explore Capabilities</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

      <button
        onclick="copyText('pnpm add ecorouter')"
        class="inline-flex items-center gap-3 px-5 py-3 rounded-full text-xs sm:text-sm font-mono bg-[#1d1d16] hover:bg-[#2b2b22] text-[#fbfbf9] border border-white/10 hover:border-white/20 active:scale-95 transition-all group"
      >
        <span class="text-[#d25611] font-bold">$</span>
        <span>pnpm add ecorouter</span>
        <svg class="w-4 h-4 text-[#abab9c] group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </button>
    </div>

    <!-- Micro-badges / Specs -->
    <div class="flex flex-wrap items-center justify-center gap-y-2 gap-x-6 text-xs font-mono text-[#abab9c]/80">
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
        Apache 2.0 Open Source
      </span>
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
        Zero Cloud Lock-in
      </span>
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
        x402 V2 Protocol Ready
      </span>
    </div>
  </div>
</section>
