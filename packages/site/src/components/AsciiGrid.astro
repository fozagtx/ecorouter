---
interface Props {
  rows?: number;
  class?: string;
}

const { rows = 80, class: className = "text-accent/40" } = Astro.props;
const ascii = Array.from({ length: rows }, (_, r) =>
  Array.from({ length: 240 }, (_, c) => (r % 2 === 0 ? (c % 4 === 0 ? "+" : c % 2 === 0 ? "." : " ") : " ")).join("")
).join("\n");
---

<pre aria-hidden="true" class={`absolute inset-0 m-0 p-3 overflow-hidden whitespace-pre font-mono text-[12px] leading-[12px] select-none pointer-events-none ${className}`}>{ascii}</pre>
